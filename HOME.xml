<t name="Homepage" t-name="website.homepage">
    <t t-set="head">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
        <style>
            /* ================= Resto Cafe Solutions - Home ================= */
            #wrap.rc-home {
                --rc-ink: #15110e;
                --rc-espresso: #1f1813;
                --rc-bean: #2b211a;
                --rc-cream: #f6efe4;
                --rc-sand: #e9dcc7;
                --rc-gold: #c9a15d;
                --rc-gold-soft: #e0c38c;
                --rc-leaf: #3f6b4b;
                --rc-muted: #a99a86;
                font-family: 'Inter', system-ui, sans-serif;
                color: var(--rc-cream);
                background: var(--rc-ink);
                overflow-x: hidden;
            }
            #wrap.rc-home h1, #wrap.rc-home h2, #wrap.rc-home h3, #wrap.rc-home .rc-serif {
                font-family: 'Playfair Display', Georgia, serif;
                letter-spacing: -0.01em;
            }
            #wrap.rc-home a { text-decoration: none; }
            .rc-home .rc-eyebrow {
                display: inline-flex; align-items: center; gap: .75rem;
                font-size: .78rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase;
                color: var(--rc-gold);
            }
            .rc-home .rc-eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
            .rc-home .rc-section { padding: 120px 0; position: relative; }
            .rc-home .rc-title { font-size: clamp(2.1rem, 4vw, 3.4rem); line-height: 1.12; color: var(--rc-cream); margin: 18px 0 20px; }
            .rc-home .rc-title em { color: var(--rc-gold); font-style: italic; }
            .rc-home .rc-lead { color: var(--rc-muted); font-size: 1.08rem; line-height: 1.8; max-width: 560px; }

            /* buttons */
            .rc-home .rc-btn {
                display: inline-flex; align-items: center; gap: .6rem;
                padding: 15px 30px; border-radius: 999px; font-weight: 600; font-size: .95rem;
                transition: all .35s ease; border: 1px solid transparent;
            }
            .rc-home .rc-btn-gold { background: var(--rc-gold); color: var(--rc-ink) !important; box-shadow: 0 12px 30px -10px rgba(201,161,93,.6); }
            .rc-home .rc-btn-gold:hover { background: var(--rc-gold-soft); transform: translateY(-2px); }
            .rc-home .rc-btn-ghost { border-color: rgba(246,239,228,.45); color: var(--rc-cream) !important; backdrop-filter: blur(6px); }
            .rc-home .rc-btn-ghost:hover { background: var(--rc-cream); color: var(--rc-ink) !important; }

            /* ---------- hero ---------- */
            .rc-home .rc-hero {
                min-height: 100vh; display: flex; align-items: center; position: relative;
                background: url('/theme_bistro/static/src/img/configurator/ultrawide_lg_5.webp') center/cover no-repeat;
            }
            .rc-home .rc-hero::before {
                content: ""; position: absolute; inset: 0;
                background: linear-gradient(100deg, rgba(21,17,14,.94) 0%, rgba(21,17,14,.78) 45%, rgba(21,17,14,.35) 100%);
            }
            .rc-home .rc-hero .container { position: relative; z-index: 2; padding-top: 110px; padding-bottom: 150px; }
            .rc-home .rc-hero h1 { font-size: clamp(2.8rem, 6.4vw, 5.6rem); line-height: 1.02; margin: 26px 0; max-width: 820px; color: #fff; }
            .rc-home .rc-hero h1 em { color: var(--rc-gold); font-style: italic; }
            .rc-home .rc-hero p { font-size: 1.15rem; color: #d9cfbf; max-width: 540px; line-height: 1.8; }
            .rc-home .rc-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 38px; }
            .rc-home .rc-hero-badge {
                position: absolute; right: 7%; top: 30%; z-index: 2; width: 170px; height: 170px; border-radius: 50%;
                border: 1px solid rgba(201,161,93,.6); display: flex; flex-direction: column; align-items: center; justify-content: center;
                text-align: center; color: var(--rc-gold); background: rgba(21,17,14,.45); backdrop-filter: blur(4px);
                animation: rc-spin-in 1.4s ease both .6s;
            }
            .rc-home .rc-hero-badge strong { font-family: 'Playfair Display', serif; font-size: 2.6rem; line-height: 1; color: #fff; }
            .rc-home .rc-hero-badge span { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; margin-top: 6px; }
            .rc-home .rc-infobar {
                position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
                background: rgba(21,17,14,.72); backdrop-filter: blur(10px); border-top: 1px solid rgba(201,161,93,.25);
            }
            .rc-home .rc-infobar .rc-info { padding: 24px 10px; display: flex; gap: 14px; align-items: center; }
            .rc-home .rc-infobar .rc-info i { color: var(--rc-gold); font-size: 1.35rem; }
            .rc-home .rc-infobar small { display: block; color: var(--rc-muted); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; }
            .rc-home .rc-infobar b { color: #fff; font-weight: 500; }

            /* ---------- marquee ---------- */
            .rc-home .rc-marquee { background: var(--rc-gold); color: var(--rc-ink); overflow: hidden; padding: 18px 0; }
            .rc-home .rc-marquee-track { display: flex; width: max-content; animation: rc-marquee 38s linear infinite; }
            .rc-home .rc-marquee span { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-style: italic; padding: 0 28px; white-space: nowrap; }
            .rc-home .rc-marquee span::after { content: "✦"; font-style: normal; font-size: .9rem; margin-left: 56px; vertical-align: middle; }

            /* ---------- story ---------- */
            .rc-home .rc-story { background: var(--rc-espresso); }
            .rc-home .rc-collage { position: relative; min-height: 560px; }
            .rc-home .rc-collage img { position: absolute; object-fit: cover; border-radius: 6px; box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); }
            .rc-home .rc-collage .rc-img-a { width: 68%; height: 82%; left: 0; top: 0; }
            .rc-home .rc-collage .rc-img-b { width: 52%; height: 56%; right: 0; bottom: 0; border: 8px solid var(--rc-espresso); }
            .rc-home .rc-collage .rc-stamp {
                position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2;
                background: var(--rc-gold); color: var(--rc-ink); border-radius: 50%; width: 132px; height: 132px;
                display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
                font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase;
            }
            .rc-home .rc-collage .rc-stamp strong { font-family: 'Playfair Display', serif; font-size: 2.4rem; letter-spacing: 0; line-height: 1; }
            .rc-home .rc-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 44px; background: rgba(201,161,93,.25); border-radius: 6px; overflow: hidden; }
            .rc-home .rc-stats div { background: var(--rc-espresso); padding: 24px 18px; }
            .rc-home .rc-stats strong { display: block; font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--rc-gold); }
            .rc-home .rc-stats span { color: var(--rc-muted); font-size: .85rem; }
            .rc-home .rc-signature { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.4rem; color: var(--rc-gold-soft); margin-top: 30px; }

            /* ---------- signature dishes ---------- */
            .rc-home .rc-dishes { background: var(--rc-ink); }
            .rc-home .rc-dish {
                position: relative; border-radius: 8px; overflow: hidden; height: 470px; display: block;
                box-shadow: 0 24px 50px -24px rgba(0,0,0,.9);
            }
            .rc-home .rc-dish img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
            .rc-home .rc-dish::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(15,11,9,.95) 100%); }
            .rc-home .rc-dish:hover img { transform: scale(1.09); }
            .rc-home .rc-dish-body { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px; z-index: 2; }
            .rc-home .rc-dish-tag { display: inline-block; font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--rc-ink); background: var(--rc-gold); padding: 5px 12px; border-radius: 999px; }
            .rc-home .rc-dish h3 { color: #fff; font-size: 1.6rem; margin: 14px 0 8px; }
            .rc-home .rc-dish p { color: #cfc3b1; font-size: .92rem; margin: 0; max-height: 0; opacity: 0; transition: all .5s ease; }
            .rc-home .rc-dish:hover p { max-height: 90px; opacity: 1; margin-bottom: 10px; }
            .rc-home .rc-dish .rc-price { font-family: 'Playfair Display', serif; color: var(--rc-gold); font-size: 1.3rem; }

            /* ---------- experiences ---------- */
            .rc-home .rc-experiences { background: var(--rc-cream); color: var(--rc-bean); }
            .rc-home .rc-experiences .rc-title { color: var(--rc-ink); }
            .rc-home .rc-experiences .rc-lead { color: #6f6253; }
            .rc-home .rc-exp {
                background: #fff; border-radius: 10px; padding: 38px 30px; height: 100%; display: block; color: var(--rc-bean);
                border: 1px solid #eadfcd; transition: all .4s ease; position: relative; overflow: hidden;
            }
            .rc-home .rc-exp::before { content: ""; position: absolute; left: 0; top: 0; height: 4px; width: 0; background: var(--rc-gold); transition: width .5s ease; }
            .rc-home .rc-exp:hover { transform: translateY(-8px); box-shadow: 0 30px 60px -30px rgba(43,33,26,.45); }
            .rc-home .rc-exp:hover::before { width: 100%; }
            .rc-home .rc-exp .rc-icon {
                width: 64px; height: 64px; border-radius: 50%; background: var(--rc-ink); color: var(--rc-gold);
                display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 24px;
            }
            .rc-home .rc-exp h3 { font-size: 1.45rem; color: var(--rc-ink); margin-bottom: 10px; }
            .rc-home .rc-exp p { color: #6f6253; font-size: .95rem; line-height: 1.7; }
            .rc-home .rc-exp .rc-more { color: #9a7a43; font-weight: 600; font-size: .9rem; }

            /* ---------- chef quote ---------- */
            .rc-home .rc-quote {
                background: linear-gradient(rgba(21,17,14,.82), rgba(21,17,14,.82)), url('/theme_bistro/static/src/img/configurator/ultrawide_lg_4.webp') center/cover fixed;
                text-align: center; padding: 140px 0;
            }
            .rc-home .rc-quote blockquote { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1.4; color: #fff; max-width: 900px; margin: 26px auto; }
            .rc-home .rc-quote img { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; border: 2px solid var(--rc-gold); }
            .rc-home .rc-quote cite { display: block; margin-top: 14px; font-style: normal; color: var(--rc-gold); letter-spacing: .14em; text-transform: uppercase; font-size: .8rem; }

            /* ---------- menu ---------- */
            .rc-home .rc-menu { background: var(--rc-espresso); }
            .rc-home .rc-menu-card { background: var(--rc-bean); border: 1px solid rgba(201,161,93,.2); border-radius: 10px; padding: 44px 40px; height: 100%; }
            .rc-home .rc-menu-card h3 { color: var(--rc-gold); font-size: 1.7rem; margin-bottom: 6px; }
            .rc-home .rc-menu-card .rc-sub { color: var(--rc-muted); font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 26px; }
            .rc-home .rc-item { display: flex; align-items: baseline; gap: 12px; padding: 14px 0; border-bottom: 1px dashed rgba(201,161,93,.18); }
            .rc-home .rc-item:last-child { border-bottom: 0; }
            .rc-home .rc-item .rc-name { color: #fff; font-weight: 500; }
            .rc-home .rc-item .rc-name small { display: block; color: var(--rc-muted); font-weight: 300; font-size: .85rem; margin-top: 3px; }
            .rc-home .rc-item .rc-dots { flex: 1; border-bottom: 1px dotted rgba(246,239,228,.25); transform: translateY(-5px); }
            .rc-home .rc-item .rc-cost { font-family: 'Playfair Display', serif; color: var(--rc-gold); font-size: 1.15rem; }
            .rc-home .rc-veg { display: inline-block; width: 10px; height: 10px; border: 1px solid var(--rc-leaf); margin-right: 6px; position: relative; top: -1px; }
            .rc-home .rc-veg::after { content: ""; position: absolute; inset: 2px; border-radius: 50%; background: #4caf6a; }

            /* ---------- events and shop ---------- */
            .rc-home .rc-feature { background: var(--rc-ink); }
            .rc-home .rc-event-card {
                display: flex; gap: 24px; align-items: center; padding: 22px; border-radius: 10px; color: var(--rc-cream);
                background: var(--rc-espresso); border: 1px solid rgba(201,161,93,.15); transition: all .35s ease; margin-bottom: 18px;
            }
            .rc-home .rc-event-card:hover { border-color: var(--rc-gold); transform: translateX(6px); }
            .rc-home .rc-event-date { min-width: 78px; text-align: center; background: var(--rc-gold); color: var(--rc-ink); border-radius: 8px; padding: 10px 6px; }
            .rc-home .rc-event-date strong { display: block; font-family: 'Playfair Display', serif; font-size: 1.9rem; line-height: 1; }
            .rc-home .rc-event-date span { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
            .rc-home .rc-event-card h4 { font-family: 'Playfair Display', serif; color: #fff; font-size: 1.25rem; margin: 0 0 4px; }
            .rc-home .rc-event-card p { color: var(--rc-muted); margin: 0; font-size: .9rem; }
            .rc-home .rc-shop-panel {
                border-radius: 12px; padding: 48px 42px; height: 100%; position: relative; overflow: hidden;
                background: radial-gradient(circle at 85% 20%, rgba(201,161,93,.35), transparent 55%), var(--rc-bean);
                border: 1px solid rgba(201,161,93,.25);
            }
            .rc-home .rc-shop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 30px 0; }
            .rc-home .rc-shop-grid a { display: block; background: var(--rc-cream); border-radius: 10px; padding: 8px; transition: transform .35s ease; }
            .rc-home .rc-shop-grid a:hover { transform: translateY(-6px) rotate(-1deg); }
            .rc-home .rc-shop-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; }

            /* ---------- reviews ---------- */
            .rc-home .rc-reviews { background: var(--rc-cream); color: var(--rc-bean); }
            .rc-home .rc-reviews .rc-title { color: var(--rc-ink); }
            .rc-home .rc-review { background: #fff; border-radius: 12px; padding: 34px; height: 100%; border: 1px solid #eadfcd; position: relative; }
            .rc-home .rc-review::before { content: "\201C"; position: absolute; right: 26px; top: 6px; font-family: 'Playfair Display', serif; font-size: 6rem; color: #f0e3cc; line-height: 1; }
            .rc-home .rc-stars { color: var(--rc-gold); letter-spacing: 3px; margin-bottom: 14px; }
            .rc-home .rc-review p { color: #5d5145; line-height: 1.75; font-size: .98rem; }
            .rc-home .rc-review .rc-who { display: flex; align-items: center; gap: 14px; margin-top: 22px; }
            .rc-home .rc-review .rc-who img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
            .rc-home .rc-review .rc-who strong { display: block; color: var(--rc-ink); }
            .rc-home .rc-review .rc-who span { color: #9a8b78; font-size: .85rem; }
            .rc-home .rc-rating-summary { font-family: 'Playfair Display', serif; font-size: 4.2rem; color: var(--rc-ink); line-height: 1; }

            /* ---------- gallery ---------- */
            .rc-home .rc-gallery { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: 210px; gap: 0; }
            .rc-home .rc-gallery a { position: relative; overflow: hidden; display: block; }
            .rc-home .rc-gallery a:nth-child(1) { grid-column: span 2; grid-row: span 2; }
            .rc-home .rc-gallery a:nth-child(4) { grid-column: span 2; }
            .rc-home .rc-gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease, filter .6s ease; filter: saturate(.9); }
            .rc-home .rc-gallery a:hover img { transform: scale(1.08); filter: saturate(1.15); }

            /* ---------- reservation ---------- */
            .rc-home .rc-reserve {
                background: linear-gradient(115deg, rgba(21,17,14,.95) 40%, rgba(21,17,14,.55)), url('/theme_bistro/static/src/img/configurator/set_1_landscape_md_2.webp') center/cover;
            }
            .rc-home .rc-hours { background: rgba(31,24,19,.85); border: 1px solid rgba(201,161,93,.3); border-radius: 12px; padding: 38px; backdrop-filter: blur(6px); }
            .rc-home .rc-hours h3 { color: var(--rc-gold); font-size: 1.5rem; margin-bottom: 18px; }
            .rc-home .rc-hours li { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid rgba(246,239,228,.08); color: #e7dccb; }
            .rc-home .rc-hours li span:last-child { color: #fff; font-weight: 500; }
            .rc-home .rc-contact-line { color: #d9cfbf; margin: 8px 0; display: flex; gap: 12px; align-items: center; }
            .rc-home .rc-contact-line i { color: var(--rc-gold); width: 18px; }

            /* ---------- website header (menu) on this page ---------- */
            /* The header floats over the dark hero, so give it a dark glass background and light links. */
            header#top {
                background: rgba(21,17,14,.62) !important;
                backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid rgba(201,161,93,.22);
                transition: background .35s ease;
            }
            header#top.o_header_is_scrolled, header#top.o_header_affixed, header#top.o_top_fixed_element {
                background: rgba(21,17,14,.94) !important;
            }
            header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
            header#top .navbar .nav-link,
            header#top .navbar a:not(.dropdown-item):not(.btn-primary),
            header#top .navbar button:not(.btn-primary):not(.dropdown-item),
            header#top .navbar .navbar-brand,
            header#top .navbar .fa, header#top .navbar .oi {
                color: #f6efe4 !important;
            }
            header#top .navbar .nav-link { font-family: 'Inter', sans-serif; font-weight: 500; letter-spacing: .02em; }
            header#top .navbar .nav-link:hover,
            header#top .navbar .nav-link.active,
            header#top .navbar .nav-item.active > .nav-link { color: #c9a15d !important; }
            header#top .navbar .nav-link.active { box-shadow: inset 0 -2px 0 #c9a15d; }
            header#top .o_navlink_background, header#top .navbar .btn-light, header#top .navbar .o_wsale_my_cart .btn {
                background: rgba(246,239,228,.12) !important; border-color: rgba(246,239,228,.18) !important;
            }
            header#top .navbar-toggler { border-color: rgba(246,239,228,.4) !important; }
            header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
            header#top .offcanvas { background: #1f1813 !important; color: #f6efe4; }
            header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item), header#top .offcanvas .btn-close { color: #f6efe4 !important; }
            header#top .offcanvas .btn-close { filter: invert(1); }
            header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; }

            /* ---------- motion ---------- */
            @keyframes rc-fade-up { from { opacity: 0; transform: translateY(34px); } to { opacity: 1; transform: none; } }
            @keyframes rc-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
            @keyframes rc-spin-in { from { opacity: 0; transform: rotate(-90deg) scale(.6); } to { opacity: 1; transform: none; } }
            .rc-home .rc-reveal { animation: rc-fade-up 1s cubic-bezier(.2,.7,.2,1) both; }
            .rc-home .rc-d1 { animation-delay: .15s; } .rc-home .rc-d2 { animation-delay: .3s; } .rc-home .rc-d3 { animation-delay: .45s; }
            @media (prefers-reduced-motion: reduce) {
                .rc-home *, .rc-home *::before { animation: none !important; transition: none !important; }
            }

            /* ---------- responsive ---------- */
            @media (max-width: 991px) {
                .rc-home .rc-section { padding: 84px 0; }
                .rc-home .rc-hero-badge { display: none; }
                .rc-home .rc-hero .container { padding-bottom: 260px; }
                .rc-home .rc-collage { min-height: 440px; margin-bottom: 50px; }
                .rc-home .rc-gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 170px; }
                .rc-home .rc-gallery a:nth-child(1), .rc-home .rc-gallery a:nth-child(4) { grid-column: span 2; grid-row: span 1; }
                .rc-home .rc-quote { background-attachment: scroll; }
            }
            @media (max-width: 575px) {
                .rc-home .rc-stats { grid-template-columns: 1fr; }
                .rc-home .rc-menu-card, .rc-home .rc-shop-panel { padding: 32px 22px; }
                .rc-home .rc-shop-grid { grid-template-columns: repeat(2, 1fr); }
            }
        </style>
    </t>
    <t t-call="website.layout" pageName.f="homepage" head="head">

        <div id="wrap" class="oe_structure rc-home">

            <!-- ===================== HERO ===================== -->
            <section class="rc-hero o_colored_level" data-name="Hero">
                <div class="container">
                    <span class="rc-eyebrow rc-reveal">Marine Drive · Kochi · Since 2014</span>
                    <h1 class="rc-reveal rc-d1">Where Kerala's flavours meet <em>modern dining</em></h1>
                    <p class="rc-reveal rc-d2">Slow-cooked heritage recipes, single-estate filter coffee and a warm table by the backwaters. Breakfast to late-night, every day.</p>
                    <div class="rc-hero-actions rc-reveal rc-d3">
                        <a href="/appointment" class="rc-btn rc-btn-gold"><i class="fa fa-calendar-check-o"/> Reserve a Table</a>
                        <a href="#rc-menu" class="rc-btn rc-btn-ghost">Explore the Menu <i class="fa fa-arrow-right"/></a>
                    </div>
                </div>
                <div class="rc-hero-badge">
                    <strong>4.8</strong>
                    <span>★ Google<br/>2,400+ reviews</span>
                </div>
                <div class="rc-infobar">
                    <div class="container">
                        <div class="row g-0">
