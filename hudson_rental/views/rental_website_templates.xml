<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rental Products Page -->
        <template id="rental_products_template" name="Rental Products">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container mt-5">
                        <div class="row">
                            <div class="col-12">
                                <h1 class="text-center mb-4">Available Rentals</h1>
                            </div>
                        </div>

                        <div class="row">
                            <t t-foreach="products" t-as="product">
                                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                                    <div class="card h-100">
                                        <img t-if="product.image_1920" t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                             class="card-img-top" t-att-alt="product.name"/>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">
                                                <a t-att-href="product.website_url" t-out="product.name"/>
                                            </h5>
                                            <p class="card-text text-muted small flex-grow-1" t-if="product.description_sale">
                                                <t t-out="product.description_sale[:100]"/>...
                                            </p>
                                            <div class="mt-auto">
                                                <p class="mb-1">
                                                    <span class="text-primary h5"
                                                          t-out="product.list_price"
                                                          t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                    / <t t-out="product.rental_period_label"/>
                                                </p>
                                                <a t-att-href="product.website_url"
                                                   class="btn btn-primary btn-sm w-100">Rent</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <t t-if="not products">
                            <div class="row">
                                <div class="col-12 text-center">
                                    <p class="alert alert-info">No rental products available at the moment.</p>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- Shop: show rental prices "per period", like Odoo's Rental app -->
        <template id="product_price_rental" inherit_id="website_sale.product_price" name="Rental Price Period">
            <xpath expr="//span[hasclass('oe_price')]" position="after">
                <span t-if="product.is_rental" class="text-muted h6 mb-0 o_rental_price_period">
                    / <t t-out="product.rental_period_label"/>
                </span>
            </xpath>
        </template>

        <template id="products_item_rental" inherit_id="website_sale.products_item" name="Rental Price Period (Shop)">
            <xpath expr="//div[hasclass('product_price')]" position="inside">
                <small t-if="product.is_rental" class="text-muted o_rental_price_period">
                    / <t t-out="product.rental_period_label"/>
                </small>
            </xpath>
        </template>

        <!-- Shop product page: "Rental Period" block above the standard Add to cart, like
             Odoo's Rental app. The chosen period is sent along when adding to cart. -->
        <template id="product_rental_configurator" inherit_id="website_sale.product" name="Rental Period">
            <xpath expr="//div[@id='o_wsale_product_cta_section']" position="before">
                <div t-if="product.is_rental"
                     class="o_rental_period o_wsale_product_details_content_section border-top pt-3 mb-4"
                     t-att-data-periodicity="product.rental_periodicity"
                     t-att-data-pickup-hour="int(product.rental_pickup_time)"
                     t-att-data-return-hour="int(product.rental_return_time)">
                    <t t-set="rental_hours" t-value="[(h, '%d:00%s' % (h % 12 or 12, 'am' if h &lt; 12 else 'pm')) for h in range(24)]"/>
                    <div class="mb-2">
                        <span class="fw-bold">Rental Period</span>
                        <span class="o_rental_tz ms-1"/>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <input type="date" name="rental_start_date" class="form-control" aria-label="Pickup date" required="required"/>
                        <i class="oi" data-icon="east" role="img" aria-label="to"/>
                        <input type="date" name="rental_end_date" class="form-control" aria-label="Return date" required="required"/>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <label for="rental_pickup_hour" class="text-nowrap">Pickup time</label>
                        <select id="rental_pickup_hour" name="rental_pickup_hour" class="form-select w-auto flex-grow-1">
                            <option t-foreach="rental_hours" t-as="hour" t-att-value="hour[0]" t-out="hour[1]"/>
                        </select>
                        <i class="oi" data-icon="east" role="img" aria-label="to"/>
                        <label for="rental_return_hour" class="text-nowrap">Return time</label>
                        <select id="rental_return_hour" name="rental_return_hour" class="form-select w-auto flex-grow-1">
                            <option t-foreach="rental_hours" t-as="hour" t-att-value="hour[0]" t-out="hour[1]"/>
                        </select>
                    </div>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
