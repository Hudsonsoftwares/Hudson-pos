<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sales order form: rental additions, like Odoo's Rental app.
             They only show on orders holding rentable products. -->
        <record id="sale_order_form_view_rental" model="ir.ui.view">
            <field name="name">sale.order.rental.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@id='create_invoice']" position="after">
                    <button name="action_open_pickup" string="Pickup" type="object" class="btn-primary"
                            invisible="not has_pickable_lines" data-hotkey="p"/>
                    <button name="action_open_return" string="Return" type="object" class="btn-primary"
                            invisible="not has_returnable_lines" data-hotkey="r"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_rental_transfers" type="object" class="oe_stat_button"
                            icon="local_shipping" invisible="rental_transfer_count == 0">
                        <field name="rental_transfer_count" widget="statinfo" string="Transfers"/>
                    </button>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <field name="is_rental_order" invisible="1"/>
                    <field name="has_pickable_lines" invisible="1"/>
                    <field name="has_returnable_lines" invisible="1"/>
                    <!-- Rental status badge, like Odoo's Rental app -->
                    <field name="rental_status" invisible="1"/>
                    <div class="float-end mt-2" invisible="not is_pickup_late">
                        <span class="badge rounded-pill text-bg-danger">Late Pickup</span>
                    </div>
                    <div class="float-end mt-2" invisible="rental_status != 'pickup' or is_pickup_late">
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">Reserved</span>
                    </div>
                    <div class="float-end mt-2" invisible="not is_return_late">
                        <span class="badge rounded-pill text-bg-danger">Late Return</span>
                    </div>
                    <div class="float-end mt-2" invisible="rental_status != 'return' or is_return_late">
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">Picked-up</span>
                    </div>
                    <div class="float-end mt-2" invisible="rental_status != 'returned'">
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">Returned</span>
                    </div>
                </xpath>
                <xpath expr="//group[@name='order_details']" position="inside">
                    <field name="is_pickup_late" invisible="1"/>
                    <field name="is_return_late" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                    <label for="rental_start_date" string="Rental period" invisible="not is_rental_order"/>
                    <div class="o_row" invisible="not is_rental_order">
                        <field name="rental_start_date" widget="daterange" required="is_rental_order"
                               options="{'end_date_field': 'rental_end_date'}"
                               readonly="state == 'cancel' or locked"/>
                        <field name="rental_end_date" invisible="1" required="is_rental_order"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="before">
                    <field name="is_rental" column_invisible="1"/>
                    <field name="qty_returned" string="Returned" readonly="1" optional="show"
                           invisible="not is_rental"
                           column_invisible="parent.state != 'sale' or not parent.is_rental_order"/>
                    <field name="rental_tracking" column_invisible="1"/>
                    <field name="pickedup_lot_ids" string="Serial Numbers" widget="many2many_tags" readonly="1"
                           optional="show" invisible="not is_rental or not rental_tracking"
                           column_invisible="parent.state != 'sale' or not parent.is_rental_order"/>
                </xpath>
            </field>
        </record>

        <!-- Rental Orders list: dashboard cards on top -->
        <record id="rental_order_view_tree" model="ir.ui.view">
            <field name="name">sale.order.rental.list</field>
            <field name="model">sale.order</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <list string="Rental Orders" js_class="rental_dashboard_list" sample="1"
                      decoration-muted="state == 'cancel'">
                    <field name="is_pickup_late" column_invisible="1"/>
                    <field name="is_return_late" column_invisible="1"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state" column_invisible="1"/>
                    <field name="name" string="Order Reference" decoration-bf="1"/>
                    <field name="partner_id"/>
                    <field name="rental_status" string="Status" widget="badge"
                           decoration-info="rental_status in ('draft', 'sent')"
                           decoration-success="rental_status == 'pickup'"
                           decoration-warning="rental_status == 'return'"
                           decoration-muted="rental_status in ('returned', 'cancel')"/>
                    <field name="rental_start_date" string="Pick up Date" decoration-danger="is_pickup_late"/>
                    <field name="rental_end_date" string="Return Date" decoration-danger="is_return_late"/>
                    <field name="date_order" optional="hide"/>
                    <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="amount_total" string="Total" sum="Total" widget="monetary"
                           decoration-bf="1" decoration-info="invoice_status == 'to invoice'"/>
                    <field name="invoice_status" widget="badge"
                           decoration-info="invoice_status == 'to invoice'"
                           decoration-success="invoice_status == 'invoiced'"/>
                </list>
            </field>
        </record>

        <!-- Rental Orders search (the dashboard cards toggle these filters) -->
        <record id="rental_order_view_search" model="ir.ui.view">
            <field name="name">sale.order.rental.search</field>
            <field name="model">sale.order</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <search string="Search Rental Orders">
                    <field name="name" string="Order"/>
                    <field name="partner_id" operator="child_of"/>
                    <field name="order_line" string="Product" filter_domain="[('order_line.product_id', 'ilike', self)]"/>
                    <field name="user_id"/>
                    <filter string="Rentals" name="rentals" domain="[('is_rental_order', '=', True)]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('is_today', '=', True)]"/>
                    <filter string="To Pickup" name="pickups" domain="[('rental_status', '=', 'pickup')]"/>
                    <filter string="To Return" name="returns" domain="[('rental_status', '=', 'return')]"/>
                    <filter string="Late" name="late" domain="[('is_late', '=', True)]"/>
                    <separator/>
                    <filter string="To Confirm" name="to_confirm" domain="[('state', 'in', ('draft', 'sent'))]"/>
                    <filter string="To Invoice" name="to_invoice" domain="[('invoice_status', '=', 'to invoice')]"/>
                    <separator/>
                    <filter string="Quotations" name="draft" domain="[('rental_status', 'in', ('draft', 'sent'))]"/>
                    <filter string="Reserved" name="reserved" domain="[('rental_status', '=', 'pickup')]"/>
                    <filter string="Picked-up" name="picked_up" domain="[('rental_status', '=', 'return')]"/>
                    <filter string="Returned" name="returned" domain="[('rental_status', '=', 'returned')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Pick up Date" name="filter_pickup_date" date="rental_start_date"/>
                    <filter string="Return Date" name="filter_return_date" date="rental_end_date"/>
                    <group>
                        <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                        <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'user_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'rental_status'}"/>
                        <filter string="Pick up Date" name="group_pickup_date" context="{'group_by': 'rental_start_date'}"/>
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Rental Orders calendar -->
        <record id="rental_order_view_calendar" model="ir.ui.view">
            <field name="name">sale.order.rental.calendar</field>
            <field name="model">sale.order</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <calendar string="Rental Orders" date_start="rental_start_date" date_stop="rental_end_date"
                          color="partner_id" mode="month" quick_create="0">
                    <field name="partner_id" filters="1"/>
                    <field name="rental_status"/>
                    <field name="amount_total" widget="monetary"/>
                    <field name="currency_id" invisible="1"/>
                </calendar>
            </field>
        </record>

        <!-- Rental Orders action: the sales orders, filtered on rentals (the filter can be removed) -->
        <record id="action_rental_order" model="ir.actions.act_window">
            <field name="name">Rental Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,kanban,calendar,pivot,graph,activity,form</field>
            <field name="search_view_id" ref="rental_order_view_search"/>
            <field name="context">{'search_default_rentals': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new rental order
                </p>
                <p>
                    Add a rentable product to a quotation: it becomes a rental order,
                    visible both here and in Sales.
                </p>
            </field>
        </record>

        <record id="action_rental_order_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="rental_order_view_tree"/>
            <field name="act_window_id" ref="action_rental_order"/>
        </record>
        <record id="action_rental_order_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="sale.view_sale_order_kanban"/>
            <field name="act_window_id" ref="action_rental_order"/>
        </record>
        <record id="action_rental_order_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="rental_order_view_calendar"/>
            <field name="act_window_id" ref="action_rental_order"/>
        </record>
        <record id="action_rental_order_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="7"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale.view_order_form"/>
            <field name="act_window_id" ref="action_rental_order"/>
        </record>

    </data>
</odoo>
