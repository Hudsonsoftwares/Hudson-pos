<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Rental Pricing Tree View -->
        <record id="rental_pricing_view_tree" model="ir.ui.view">
            <field name="name">rental.pricing.tree</field>
            <field name="model">rental.pricing</field>
            <field name="arch" type="xml">
                <list string="Rental Pricing">
                    <field name="product_tmpl_id"/>
                    <field name="duration"/>
                    <field name="duration_unit"/>
                    <field name="price"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Rental Pricing Form View -->
        <record id="rental_pricing_view_form" model="ir.ui.view">
            <field name="name">rental.pricing.form</field>
            <field name="model">rental.pricing</field>
            <field name="arch" type="xml">
                <form string="Rental Pricing">
                    <sheet>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="duration"/>
                            <field name="duration_unit"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Rental Pricing Action -->
        <record id="action_rental_pricing" model="ir.actions.act_window">
            <field name="name">Rental Pricing</field>
            <field name="res_model">rental.pricing</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
