<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Ticket Number -->
        <record id="seq_helpdesk_management_ticket" model="ir.sequence">
            <field name="name">Helpdesk Ticket</field>
            <field name="code">helpdesk.management.ticket</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Stages -->
        <record id="stage_new" model="helpdesk.management.stage">
            <field name="name">New</field>
            <field name="sequence">1</field>
        </record>
        <record id="stage_in_progress" model="helpdesk.management.stage">
            <field name="name">In Progress</field>
            <field name="sequence">2</field>
        </record>
        <record id="stage_on_hold" model="helpdesk.management.stage">
            <field name="name">On Hold</field>
            <field name="sequence">3</field>
        </record>
        <record id="stage_solved" model="helpdesk.management.stage">
            <field name="name">Solved</field>
            <field name="sequence">4</field>
            <field name="is_close" eval="True"/>
            <field name="template_id" ref="helpdesk_management_pro.mail_template_ticket_review"/>
        </record>
        <record id="stage_cancelled" model="helpdesk.management.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">5</field>
            <field name="is_close" eval="True"/>
            <field name="fold" eval="True"/>
        </record>

        <!-- Default Categories -->
        <record id="cat_technical_support" model="helpdesk.management.category">
            <field name="name">Technical Support</field>
        </record>
        <record id="cat_billing" model="helpdesk.management.category">
            <field name="name">Billing</field>
        </record>
        <record id="cat_general_inquiry" model="helpdesk.management.category">
            <field name="name">General Inquiry</field>
        </record>

        <!-- Auto-Close Cron -->
        <record id="ir_cron_auto_close_tickets" model="ir.cron">
            <field name="name">Helpdesk: Auto Close Tickets</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_tickets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- SLA Update Cron -->
        <record id="ir_cron_update_sla_status" model="ir.cron">
            <field name="name">Helpdesk: Update SLA Status</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_sla_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
