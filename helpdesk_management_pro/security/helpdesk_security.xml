<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_helpdesk_management_pro" model="ir.module.category">
            <field name="name">Helpdesk Pro</field>
            <field name="description">Helps you manage your helpdesk tickets.</field>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_helpdesk_management_pro" model="res.groups.privilege">
            <field name="name">Helpdesk Pro Privilege</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_helpdesk_management_pro"/>
        </record>

        <!-- Groups -->
        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_helpdesk_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have access to his own data in the helpdesk application.</field>
        </record>

        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_helpdesk_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="comment">The user will have access to the helpdesk manager features.</field>
        </record>

        <record id="group_helpdesk_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_helpdesk_management_pro"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="comment">The user will have full access to the helpdesk application and settings.</field>
        </record>

        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('helpdesk_management_pro.group_helpdesk_admin'))]"/>
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('helpdesk_management_pro.group_helpdesk_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="helpdesk_team_comp_rule" model="ir.access">
            <field name="name">Helpdesk Team multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_team"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>
        
        <record id="helpdesk_ticket_comp_rule" model="ir.access">
            <field name="name">Helpdesk Ticket multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_sla_comp_rule" model="ir.access">
            <field name="name">Helpdesk SLA multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_sla"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_sla_status_comp_rule" model="ir.access">
            <field name="name">Helpdesk SLA Status multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_sla_status"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_ticket_time_comp_rule" model="ir.access">
            <field name="name">Helpdesk Ticket Time multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_ticket_time"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_ticket_rating_comp_rule" model="ir.access">
            <field name="name">Helpdesk Ticket Rating multi-company</field>
            <field name="model_id" ref="model_helpdesk_management_ticket_rating"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_ticket_user_rule" model="ir.access">
            <field name="name">Helpdesk Ticket User Access</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <!-- Permissions of a group are OR-ed: this must stay the only (domain-scoped) ticket permission of helpdesk users.
                 Private teams ("Invited internal users") are restricted to their members, the assignee and the followers. -->
            <field name="domain">['|', ('team_id.visibility_member_type', '!=', 'internal'), '|', '|', ('user_id', '=', user.id), ('team_id.member_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="group_id" ref="group_helpdesk_user"/>
            <field name="operation">cru</field>
        </record>

        <record id="helpdesk_ticket_manager_rule" model="ir.access">
            <field name="name">Helpdesk Ticket Manager Access</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="group_helpdesk_manager"/>
            <field name="operation">crud</field>
        </record>

        <record id="helpdesk_ticket_portal_rule" model="ir.access">
            <field name="name">Helpdesk Ticket Portal Access</field>
            <field name="model_id" ref="model_helpdesk_management_ticket"/>
            <field name="domain">['|', ('partner_id', '=', user.partner_id.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="group_id" ref="base.group_portal"/>
            <!-- Customers only read their tickets: closing, rating and messages go through the portal controllers -->
            <field name="operation">r</field>
        </record>
    </data>
</odoo>
