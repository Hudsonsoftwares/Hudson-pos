<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tags -->
    <record id="helpdesk_management_pro_view_tag_tree" model="ir.ui.view">
        <field name="name">helpdesk.management.tag.tree</field>
        <field name="model">helpdesk.management.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_management_pro_action_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.management.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Categories -->
    <record id="helpdesk_management_pro_view_category_tree" model="ir.ui.view">
        <field name="name">helpdesk.management.category.tree</field>
        <field name="model">helpdesk.management.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="team_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_management_pro_action_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">helpdesk.management.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Sources -->
    <record id="helpdesk_management_pro_view_source_tree" model="ir.ui.view">
        <field name="name">helpdesk.management.source.tree</field>
        <field name="model">helpdesk.management.source</field>
        <field name="arch" type="xml">
            <list string="Sources" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_management_pro_action_sources" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">helpdesk.management.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="helpdesk_management_pro_menu_tags"
              name="Tags"
              parent="helpdesk_management_pro_menu_config"
              action="helpdesk_management_pro_action_tags"
              sequence="30"/>

    <menuitem id="helpdesk_management_pro_menu_categories"
              name="Categories"
              parent="helpdesk_management_pro_menu_config"
              action="helpdesk_management_pro_action_categories"
              active="False"
              sequence="50"/>

    <!--
    <menuitem id="helpdesk_management_pro_menu_sources"
              name="Sources"
              parent="helpdesk_management_pro_menu_config"
              action="helpdesk_management_pro_action_sources"
              sequence="60"/>
    -->
</odoo>
