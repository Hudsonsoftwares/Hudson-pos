<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activity Types: standard mail views, scoped to helpdesk tickets -->
    <record id="helpdesk_management_pro_action_activity_types" model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">['|', ('res_model', '=', False), ('res_model', '=', 'helpdesk.management.ticket')]</field>
        <field name="context">{'default_res_model': 'helpdesk.management.ticket'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new activity type
            </p>
            <p>
                Those represent the different categories of things you have to do (e.g. "Call" or "Send email").
            </p>
        </field>
    </record>

    <menuitem id="helpdesk_management_pro_menu_activity_types"
              name="Activity Types"
              parent="helpdesk_management_pro_menu_config"
              action="helpdesk_management_pro_action_activity_types"
              groups="helpdesk_management_pro.group_helpdesk_manager"
              sequence="25"/>
</odoo>
