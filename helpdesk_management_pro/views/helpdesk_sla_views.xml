<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SLA Form View -->
    <record id="helpdesk_management_pro_view_sla_form" model="ir.ui.view">
        <field name="name">helpdesk.management.sla.form</field>
        <field name="model">helpdesk.management.sla</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Close urgent tickets within 36 hours"/>
                        </h1>
                    </div>
                    <field name="description" placeholder="Description of the policy..." class="w-100 mb-4 text-muted border-0"/>
                    <group name="target" string="TARGET">
                        <field name="stage_id" string="Reach Stage" help="Reach this stage to satisfy the SLA"/>
                        <label for="target_hours" string="Within" help="Time limit for the SLA"/>
                        <div class="d-flex align-items-center">
                            <field name="target_hours" class="oe_inline me-2" style="max-width: 50px;"/>
                            <span class="text-muted">Working Hours</span>
                        </div>
                        <field name="exclude_stage_ids" widget="many2many_tags" string="Excluding Stages" help="Time spent in these stages will not be counted"/>
                    </group>
                    <group name="criteria" string="CRITERIA">
                        <field name="team_id" string="Helpdesk Team"/>
                        <field name="priority" help="Leave empty to apply the SLA to all priorities"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="res_model" invisible="1"/>
                        <field name="domain" string="Tickets" widget="domain" options="{'model': 'res_model'}" help="Apply this SLA only to tickets matching these rules"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SLA Tree View -->
    <record id="helpdesk_management_pro_view_sla_tree" model="ir.ui.view">
        <field name="name">helpdesk.management.sla.tree</field>
        <field name="model">helpdesk.management.sla</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="stage_id" optional="show"/>
                <field name="target_type"/>
                <field name="target_hours"/>
            </list>
        </field>
    </record>

    <!-- SLA Search View -->
    <record id="helpdesk_management_pro_view_sla_search" model="ir.ui.view">
        <field name="name">helpdesk.management.sla.search</field>
        <field name="model">helpdesk.management.sla</field>
        <field name="arch" type="xml">
            <search string="SLA Policies">
                <field name="name"/>
                <field name="team_id"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Helpdesk Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- SLA Action -->
    <record id="helpdesk_management_pro_action_sla" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.management.sla</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="helpdesk_management_pro_menu_sla"
              name="SLA Policies"
              parent="helpdesk_management_pro_menu_config"
              action="helpdesk_management_pro_action_sla"
              sequence="20"/>
</odoo>
