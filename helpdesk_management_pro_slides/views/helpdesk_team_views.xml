<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_form_inherit_slides" model="ir.ui.view">
        <field name="name">helpdesk.team.form.inherit.slides</field>
        <field name="model">helpdesk.management.team</field>
        <field name="inherit_id" ref="helpdesk_management_pro.helpdesk_management_pro_view_team_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='use_website_helpdesk_form']" position="after">
                <setting id="use_website_helpdesk_elearning" help="Share presentations and videos, and organize them into courses. Allow customers to search your eLearning courses in the help center for answers to their questions.">
                    <field name="use_website_helpdesk_elearning"/>
                    <div class="o_helpdesk_setting_row" invisible="not use_website_helpdesk_elearning">
                        <label for="website_slide_channel_ids" string="Courses" class="o_light_label"/>
                        <field name="website_slide_channel_ids" widget="many2many_tags"
                               placeholder="Select courses" context="{'default_is_published': True}"
                               required="use_website_helpdesk_elearning"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
