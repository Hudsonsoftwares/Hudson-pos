<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        <record id="module_category_subscription" model="ir.module.category">
            <field name="name">Subscriptions</field>
            <field name="description">Manage subscription contracts, recurring billing, and recurring revenue</field>
            <field name="sequence">15</field>
        </record>

        <record id="privilege_hudson_subscriptions" model="res.groups.privilege">
            <field name="name">Subscriptions</field>
            <field name="sequence">15</field>
            <field name="category_id" ref="hudson_subscriptions.module_category_subscription" />
        </record>

        <record id="group_subscription_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_hudson_subscriptions" />
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        </record>

        <record id="group_subscription_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_hudson_subscriptions" />
            <field name="implied_ids" eval="[(4, ref('hudson_subscriptions.group_subscription_user')), (4, ref('sales_team.group_sale_manager'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('hudson_subscriptions.group_subscription_manager'))]" />
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('hudson_subscriptions.group_subscription_manager'))]" />
        </record>
        
        <record id="subscription_plan_comp_rule" model="ir.access">
            <field name="name">Subscription Plan Multi-Company</field>
            <field name="model_id" ref="model_sale_subscription_plan" />
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field></record>

        <record id="subscription_close_reason_comp_rule" model="ir.access">
            <field name="name">Subscription Close Reason Multi-Company</field>
            <field name="model_id" ref="model_sale_subscription_close_reason" />
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field></record>

        <record id="subscription_order_salesperson_rule" model="ir.access">
            <field name="name">Subscription Personal Orders</field>
            <field name="model_id" ref="model_sale_order" />
            <field name="domain">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="group_id" ref="sales_team.group_sale_salesman" />
        <field name="operation">crud</field></record>

        <record id="subscription_order_see_all_rule" model="ir.access">
            <field name="name">Subscription All Orders</field>
            <field name="model_id" ref="model_sale_order" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="sales_team.group_sale_salesman_all_leads" />
        <field name="operation">crud</field></record>
    <record id="subscription_order_see_all_rule_hudson_subscriptions_group_subscription_manager" model="ir.access">
            <field name="name">Subscription All Orders</field>
            <field name="model_id" ref="model_sale_order" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="hudson_subscriptions.group_subscription_manager" />
        <field name="operation">crud</field></record>
    </data>
</odoo>