            <field name="close_reason_id" ref="close_reason_other"/>
            <field name="start_date" eval="datetime.now() - relativedelta(years=1)"/>
            <field name="close_date" eval="datetime.now() - relativedelta(months=3)"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('product_saas_yearly'),
                'name': 'Annual Support &amp; Maintenance',
                'product_uom_qty': 1,
                'price_unit': 180.0,
            })]"/>
