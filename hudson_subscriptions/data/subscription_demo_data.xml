                'product_uom_qty': 1,
                'price_unit': 50.0,
            })]"/>
        </record>

        <!-- S00041 - Joel Willis - Yearly - 180.00 - Churned -->
        <record id="demo_subscription_s00041" model="sale.order">
            <field name="name">S00041</field>
            <field name="partner_id" ref="partner_joel_willis"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="is_subscription">True</field>
            <field name="plan_id" ref="subscription_plan_yearly"/>
