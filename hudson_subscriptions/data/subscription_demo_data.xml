            <field name="start_date" eval="datetime.now()"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('product_saas_basic'),
                'name': 'Cloud SaaS Basic Subscription (Trial Quote)',
                'product_uom_qty': 1,
                'price_unit': 0.0,
