<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Plan Tree View -->
    <record id="view_sale_subscription_plan_tree" model="ir.ui.view">
        <field name="name">sale.subscription.plan.tree</field>
        <field name="model">sale.subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Recurring Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="billing_period_value"/>
                <field name="billing_period_unit"/>
                <field name="auto_close_limit"/>
                <field name="user_closable"/>
                <field name="subscription_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Subscription Plan Form View -->
    <record id="view_sale_subscription_plan_form" model="ir.ui.view">
        <field name="name">sale.subscription.plan.form</field>
        <field name="model">sale.subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Recurring Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="refresh">
                            <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Plan Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Subscription"/>
                        </h1>
                    </div>
                    <group>
                        <group string="DETAILS">
                            <label for="billing_period_value" string="Billing Period"/>
                            <div class="o_row">
                                <field name="billing_period_value" class="oe_inline"/>
                                <field name="billing_period_unit" class="oe_inline" nolabel="1"/>
                            </div>
                            <field name="align_to_period_start"/>
                            <label for="auto_close_limit" string="Automatic Closing"/>
                            <div class="o_row">
                                <field name="auto_close_limit" class="oe_inline"/>
                                <span>Days</span>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="invoice_mail_template_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="SELF-SERVICE">
                            <field name="user_closable"/>
                            <field name="user_pausable"/>
                            <field name="user_add_products"/>
                            <field name="user_renew"/>
                            <field name="optional_plan_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>

                        <page string="Terms &amp; Conditions" name="terms">
                            <field name="description" placeholder="Specify terms and billing policy..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subscription Plan Search View -->
    <record id="view_sale_subscription_plan_search" model="ir.ui.view">
        <field name="name">sale.subscription.plan.search</field>
        <field name="model">sale.subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Search Recurring Plans">
                <field name="name"/>
                <field name="billing_period_unit"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Subscription Plan Action -->
    <record id="action_subscription_plans" model="ir.actions.act_window">
        <field name="name">Recurring Plans</field>
        <field name="res_model">sale.subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_subscription_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first recurring plan!
            </p>
            <p>
                Define recurring billing frequencies such as Monthly, Quarterly, or Yearly.
            </p>
        </field>
    </record>
</odoo>
