<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_subscription_close_reason_tree" model="ir.ui.view">
        <field name="name">sale.subscription.close.reason.tree</field>
        <field name="model">sale.subscription.close.reason</field>
        <field name="arch" type="xml">
            <list string="Close Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="empty_reason"/>
                <field name="subscription_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_close_reasons" model="ir.actions.act_window">
        <field name="name">Close Reasons</field>
        <field name="res_model">sale.subscription.close.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define churn and close reasons for cancelled subscriptions!
            </p>
            <p>
                Track reasons why customers cancel to identify areas for service improvement.
            </p>
        </field>
    </record>
</odoo>
