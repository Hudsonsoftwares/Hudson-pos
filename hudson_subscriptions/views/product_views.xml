<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Inherit -->
    <record id="view_product_template_form_inherit_subscription" model="ir.ui.view">
        <field name="name">product.template.form.inherit.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="recurring_invoice"/>
                    <label for="recurring_invoice"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="subscription_plan_id" invisible="not recurring_invoice"/>
            </xpath>
            <xpath expr="//field[@name='fixed_pricelist_rule_ids']/list/field[@name='pricelist_id']" position="before">
                <field name="subscription_plan_id" column_invisible="not parent.recurring_invoice" string="Plan"/>
            </xpath>
            <xpath expr="//field[@name='fixed_pricelist_rule_ids']/list/field[@name='min_quantity']" position="after">
                <field name="packaging_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search View Inherit -->
    <record id="view_product_template_search_inherit_subscription" model="ir.ui.view">
        <field name="name">product.template.search.inherit.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="Subscription Products" name="filter_recurring_invoice" domain="[('recurring_invoice', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Subscription Products Action -->
    <record id="action_subscription_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="context">{'default_recurring_invoice': True, 'search_default_filter_recurring_invoice': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new subscription product!
            </p>
            <p>
                Products configured with recurring billing plans can be easily subscribed to.
            </p>
        </field>
    </record>

    <!-- Subscription Pricelists Action -->
    <record id="action_subscription_pricelists" model="ir.actions.act_window">
        <field name="name">Pricelists</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="product.product_pricelist_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new pricelist!
            </p>
            <p>
                Manage customized pricing rules and currency rates for subscription contracts.
            </p>
        </field>
    </record>
</odoo>
