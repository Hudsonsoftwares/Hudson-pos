<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="appointment_resource_view_list_inherit_pos_booking" model="ir.ui.view">
        <field name="name">appointment.resource.view.list.inherit.pos.booking</field>
        <field name="model">appointment.resource</field>
        <field name="inherit_id" ref="appointment.appointment_resource_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pos_table_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="appointment_resource_view_form_inherit_pos_booking" model="ir.ui.view">
        <field name="name">appointment.resource.view.form.inherit.pos.booking</field>
        <field name="model">appointment.resource</field>
        <field name="inherit_id" ref="appointment.appointment_resource_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='capacity']" position="after">
                <field name="pos_table_id" readonly="1" invisible="not pos_table_id"/>
            </xpath>
        </field>
    </record>

    <record id="appointment_resource_view_search" model="ir.ui.view">
        <field name="name">appointment.resource.view.search</field>
        <field name="model">appointment.resource</field>
        <field name="arch" type="xml">
            <search string="Resources">
                <field name="name"/>
                <field name="appointment_type_ids"/>
                <filter string="Unassigned (Available for Event)"
                        name="unassigned_resources"
                        domain="[('appointment_type_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="appointment.action_appointment_resource" model="ir.actions.act_window">
        <field name="search_view_id" ref="appointment_resource_view_search"/>
        <field name="context">{}</field>
    </record>
</odoo>

