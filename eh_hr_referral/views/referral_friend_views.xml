<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_hr_referral_friend_form" model="ir.ui.view">
        <field name="name">eh.hr.referral.friend.form</field>
        <field name="model">eh.hr.referral.friend</field>
        <field name="arch" type="xml">
            <form string="Friend">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Hero, Adventurer, Spacewoman, Dog, Batman"/>
                        <field name="position" widget="radio"/>
                        <field name="image" widget="image" class="w-25"/>
                        <field name="image_head" widget="image" class="w-25"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_hr_referral_friend_tree" model="ir.ui.view">
        <field name="name">eh.hr.referral.friend.tree</field>
        <field name="model">eh.hr.referral.friend</field>
        <field name="arch" type="xml">
            <list string="Friends">
                <field name="image" widget="image" options="{'size': [66, 88]}"/>
                <field name="name"/>
                <field name="position" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_eh_hr_referral_friends" model="ir.actions.act_window">
        <field name="name">Friends</field>
        <field name="res_model">eh.hr.referral.friend</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
