<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_hr_referral_promote_form" model="ir.ui.view">
        <field name="name">eh.hr.referral.promote.form</field>
        <field name="model">eh.hr.referral.promote</field>
        <field name="arch" type="xml">
            <form string="Promote Job Position">
                <div class="alert alert-info" role="alert">
                    This email will be sent to <strong><field name="recipient_count" class="d-inline"/></strong> internal employees.
                </div>
                <group>
                    <field name="job_id" readonly="1" force_save="1"/>
                    <field name="employee_ids" widget="many2many_tags" readonly="1"/>
                    <field name="subject"/>
                    <field name="body"/>
                </group>
                <footer>
                    <button name="action_promote" string="Send to Employees" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
