<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_hr_referral_points_form" model="ir.ui.view">
        <field name="name">eh.hr.referral.points.form</field>
        <field name="model">eh.hr.referral.points</field>
        <field name="arch" type="xml">
            <form string="Points">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="points"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_hr_referral_points_tree" model="ir.ui.view">
        <field name="name">eh.hr.referral.points.tree</field>
        <field name="model">eh.hr.referral.points</field>
        <field name="arch" type="xml">
            <list string="Points">
                <field name="user_id"/>
                <field name="points"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_eh_hr_referral_points" model="ir.actions.act_window">
        <field name="name">Points</field>
        <field name="res_model">eh.hr.referral.points</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
