<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_recruitment_stage_form_inherit_referral" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.inherit.referral</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Referral Points">
                    <field name="points"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
