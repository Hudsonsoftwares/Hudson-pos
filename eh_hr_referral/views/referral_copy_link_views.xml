<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_hr_referral_copy_link_form" model="ir.ui.view">
        <field name="name">eh.hr.referral.copy.link.form</field>
        <field name="model">eh.hr.referral.copy.link</field>
        <field name="arch" type="xml">
            <form string="Copy Job Link">
                <div class="alert alert-info" role="alert">
                    Please copy the link below and share it anywhere!
                </div>
                <group>
                    <field name="job_url" readonly="1" widget="url" force_save="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
