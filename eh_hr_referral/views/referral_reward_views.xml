<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_hr_referral_reward_form" model="ir.ui.view">
        <field name="name">eh.hr.referral.reward.form</field>
        <field name="model">eh.hr.referral.reward</field>
        <field name="arch" type="xml">
            <form string="Reward">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <label for="cost"/>
                            <div class="o_row">
                                <field name="cost" class="oe_inline"/>
                                <span>Points</span>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="gift_responsible_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html" placeholder="Add a description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_hr_referral_reward_tree" model="ir.ui.view">
        <field name="name">eh.hr.referral.reward.tree</field>
        <field name="model">eh.hr.referral.reward</field>
        <field name="arch" type="xml">
            <list string="Rewards">
                <field name="name"/>
                <field name="cost"/>
                <field name="gift_responsible_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_eh_hr_referral_reward_kanban" model="ir.ui.view">
        <field name="name">eh.hr.referral.reward.kanban</field>
        <field name="model">eh.hr.referral.reward</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" type="object" action="action_dummy">
                <field name="name"/>
                <field name="cost"/>
                <field name="image_1920"/>
                <field name="description"/>
                <field name="company_id"/>
                <field name="points_missing"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column h-100 bg-white rounded-3 shadow-sm border overflow-hidden position-relative" style="min-width: 260px; max-width: 320px; margin: 0 auto; transition: all 0.2s ease-in-out;">
                            <!-- Image & Cost Badge Header -->
                            <div class="position-relative d-flex align-items-center justify-content-center bg-light" style="height: 200px; background-color: #f8fafc !important; border-bottom: 1px solid #edf2f7; overflow: hidden;">
                                <t t-if="record.image_1920.raw_value">
                                    <img t-attf-src="/web/image/eh.hr.referral.reward/#{record.id.raw_value}/image_1920" class="img-fluid" style="max-height: 180px; max-width: 90%; object-fit: contain;" alt="Reward Image"/>
                                </t>
                                <t t-else="">
                                    <i class="oi oi-4x text-muted opacity-50" data-icon="card_giftcard"/>
                                </t>
                                <span class="badge rounded-pill shadow-sm position-absolute top-0 end-0 m-2" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #ffffff !important; font-size: 13px; font-weight: 700; padding: 6px 14px; border: 1px solid rgba(255,255,255,0.6); z-index: 2;">
                                    <i class="oi oi-filled me-1 text-white" data-icon="star"/> <field name="cost"/> Points
                                </span>
                            </div>

                            <!-- Product Info -->
                            <div class="p-3 d-flex flex-column justify-content-between flex-grow-1" style="background-color: #ffffff;">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="fs-6 fw-bold" style="color: #1e293b !important; line-height: 1.3;">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="text-muted small mb-2 d-flex align-items-center" style="font-size: 12px;">
                                        <i class="oi me-1 text-secondary" data-icon="business"/>
                                        <field name="company_id"/>
                                    </div>
                                    <t t-if="record.description.raw_value">
                                        <div class="text-muted small mb-2" style="max-height: 38px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; font-size: 12px;">
                                            <t t-out="record.description.raw_value"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Buy Action Button -->
                                <div class="mt-3 pt-2 border-top">
                                    <t t-if="record.points_missing.raw_value &gt; 0">
                                        <button class="btn btn-outline-danger w-100 py-2 disabled d-flex align-items-center justify-content-center" style="background-color: #fff5f5 !important; border: 1px dashed #f87171 !important; color: #dc2626 !important; border-radius: 8px !important; font-size: 13px !important; font-weight: 600 !important; opacity: 1 !important; pointer-events: none;">
                                            <i class="oi me-2 text-danger" data-icon="lock"/> Need <field name="points_missing"/> more Points
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <button name="action_buy_reward" type="object" class="btn btn-primary w-100 py-2 fw-bold shadow d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #714B67 0%, #8e5a81 100%) !important; background-color: #714B67 !important; color: #ffffff !important; border: none !important; border-radius: 8px !important; font-size: 14px !important; font-weight: 700 !important; box-shadow: 0 4px 12px rgba(113, 75, 103, 0.35) !important;" confirm="Do you want to confirm this reward? After confirmation an HR will contact you.">
                                            <i class="oi me-2 text-white" data-icon="shopping_basket" style="font-size: 15px;"/> 
                                            <span class="text-white" style="font-weight: 700 !important; letter-spacing: 0.5px; text-transform: uppercase;">Buy Now</span>
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_eh_hr_referral_reward" model="ir.actions.act_window">
        <field name="name">Rewards</field>
        <field name="res_model">eh.hr.referral.reward</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
