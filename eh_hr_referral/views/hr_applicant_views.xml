<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_view_form_inherit_referral" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.referral</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='recruiter_id']" position="after">
                <field name="ref_user_id" string="Referred By"/>
            </xpath>
        </field>
    </record>
</odoo>
