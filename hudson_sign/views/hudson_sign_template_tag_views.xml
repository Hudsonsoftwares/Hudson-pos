<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hudson_sign_template_tag_view_tree" model="ir.ui.view">
            <field name="name">hudson.sign.template.tag.list</field>
            <field name="model">hudson.sign.template.tag</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <record id="action_hudson_sign_template_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">hudson.sign.template.tag</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
