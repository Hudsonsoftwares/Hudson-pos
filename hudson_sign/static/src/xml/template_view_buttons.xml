<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Kanban Buttons -->
    <t t-name="hudson_sign.KanbanButtons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="primary" owl="1">
        <xpath expr="." position="inside">
            <button type="button" class="btn btn-primary o-kanban-button-new" t-on-click="() => this.uploadPdf()">
                Upload PDF
            </button>
        </xpath>
    </t>

    <!-- List Buttons -->
    <t t-name="hudson_sign.ListButtons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary" owl="1">
        <xpath expr="." position="inside">
            <button type="button" class="btn btn-primary o_list_button_add" t-on-click="() => this.uploadPdf()" data-hotkey="c">
                Upload PDF
            </button>
        </xpath>
    </t>

</templates>
