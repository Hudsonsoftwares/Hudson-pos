<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_final_settlement" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.final.settlement</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_final_settlements"
                        type="object"
                        class="oe_stat_button"
                        icon="calculate"
                        invisible="final_settlement_count == 0"
                        groups="hudson_payroll_base.group_payroll_user">
                    <field name="final_settlement_count" widget="statinfo" string="Settlement"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
