<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="dms.FileKanbanView"
        t-inherit="web.KanbanView"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('o_selection_container')]" position="inside">
            <t t-if="!this.isSmall">
                <button t-if="this.isDownloadVisible" class="btn btn-secondary me-1" t-on-click="() => this.onDownload()">
                    <i class="fa fa-download me-1"/>Download
                </button>
                <button t-if="this.isShareVisible" class="btn btn-secondary me-1" t-on-click="() => this.onShare()">
                    <i class="fa fa-share-alt me-1"/>Share
                </button>
                <button t-if="this.isSignVisible" class="btn btn-secondary me-1" t-on-click="() => this.onSign()">
                    <i class="fa fa-pencil-square-o me-1"/>Sign
                </button>
                <div t-if="this.isMoreVisible" class="dropdown me-1 d-inline-block">
                    <button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        More
                    </button>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.onAccountingAction('out_invoice')"><i class="fa fa-file-text-o fa-fw me-2"/>Customer Invoice</a></li>
                        <li><a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.onAccountingAction('out_refund')"><i class="fa fa-file-text-o fa-fw me-2"/>Customer Credit Note</a></li>
                        <li><a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.onAccountingAction('in_invoice')"><i class="fa fa-file-text fa-fw me-2"/>Vendor Bill</a></li>
                        <li><a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.onAccountingAction('in_refund')"><i class="fa fa-file-text fa-fw me-2"/>Vendor Refund</a></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><a class="dropdown-item py-2" href="#" t-on-click.prevent="() => this.onAccountingAction('entry')"><i class="fa fa-list-alt fa-fw me-2"/>Misc Entry</a></li>
                    </ul>
                </div>
            </t>
        </xpath>
    </t>

</templates>
