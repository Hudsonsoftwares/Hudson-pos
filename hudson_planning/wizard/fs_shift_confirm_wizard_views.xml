<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_shift_confirm_wizard_form" model="ir.ui.view">
        <field name="name">fs.shift.confirm.wizard.form</field>
        <field name="model">fs.shift.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <sheet>
                    <div class="alert alert-warning" role="alert" style="margin-bottom:0px;">
                        <strong>Warning: Shift Hour Limits Exceeded!</strong>
                    </div>
                    <group>
                        <field name="warning_message" nolabel="1"/>
                        <field name="apply_wizard_id" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_proceed" string="Proceed Anyway" type="object" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
