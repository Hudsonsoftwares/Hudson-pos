<?xml version='1.0' encoding='utf-8'?>
<odoo>

    
    
    

    <record model="res.groups.privilege" id="res_groups_privilege_planning">
        <field name="name">Planning</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_human_resources" />
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: Can view their own shifts.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="privilege_id" ref="res_groups_privilege_planning" />
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: Full access to all planning, configuration, and reports.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_planning" />
        <field name="implied_ids" eval="[(4, ref('hudson_planning.group_planning_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    
    
    

    <data noupdate="1">

        
        <record model="ir.access" id="fs_planning_slot_comp_rule">
            <field name="name">Planning Slot: multi-company</field>
            <field name="model_id" ref="model_fs_planning_slot" />
            <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field></record>

        
        <record model="ir.access" id="fs_planning_slot_manager_rule">
            <field name="name">Planning Slot: manager sees all</field>
            <field name="model_id" ref="model_fs_planning_slot" />
            <field name="domain">[(1, '=', 1)]</field>
            <field name="group_id" ref="hudson_planning.group_planning_manager" />
        <field name="operation">crud</field></record>

    </data>

    <!-- Employees: own published shifts and open shifts, in ir.access.csv. This
         former rule also allowed creating and deleting shifts. -->
    <delete model="ir.access" search="[('name', '=', 'Planning Slot: user sees own (published)')]"/>
    <!-- Multi-company: the templates of the user's companies, and the shared ones -->
    <record model="ir.access" id="fs_shift_template_comp_rule">
        <field name="name">Shift Template: multi-company</field>
        <field name="model_id" ref="model_fs_shift_template"/>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        <field name="operation">crud</field>
    </record>

    <!-- Settings > Shift Changes: shifts offered for replacement are visible to all employees -->
    <record model="ir.access" id="fs_planning_slot_user_switch_rule">
        <field name="name">Planning Slot: user sees shifts offered for replacement</field>
        <field name="model_id" ref="model_fs_planning_slot" />
        <field name="domain">[('state', '=', 'published'), ('request_to_switch', '=', True)]</field>
        <field name="group_id" ref="hudson_planning.group_planning_user" />
        <field name="operation">r</field>
    </record>

</odoo>