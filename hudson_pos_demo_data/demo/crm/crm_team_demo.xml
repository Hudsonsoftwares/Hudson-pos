<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="rc_team_catering_events" model="crm.team">
            <field name="name">Catering &amp; Events</field>
            <field name="use_leads" eval="True"/>
            <field name="user_id" ref="rc_user_arjun"/>
            <field name="assignment_domain">[['phone', '!=', False]]</field>
        </record>
        <record id="rc_team_member_arjun" model="crm.team.member">
            <field name="user_id" ref="rc_user_arjun"/>
            <field name="crm_team_id" ref="rc_team_catering_events"/>
            <field name="assignment_max" eval="45"/>
            <field name="assignment_domain">[['probability', '&gt;=', 5]]</field>
        </record>
        <record id="rc_team_member_admin_events" model="crm.team.member">
            <field name="user_id" ref="base.user_admin"/>
            <field name="crm_team_id" ref="rc_team_catering_events"/>
            <field name="assignment_max" eval="20"/>
        </record>
        <record id="sales_team.team_sales_department" model="crm.team" forcecreate="False">
            <field name="assignment_domain">[['probability', '&gt;=', 20]]</field>
        </record>
        <record id="sales_team.crm_team_member_admin_sales" model="crm.team.member" forcecreate="False">
            <field name="assignment_max" eval="30"/>
            <field name="assignment_domain">[['probability', '&gt;=', 20]]</field>
        </record>
    </data>
</odoo>
