    <!-- ================================================================
         2. RESTAURANT SUPERVISOR (PUBLISHED ON WEBSITE)
         ================================================================ -->
    <record id="job_resto_supervisor" model="hr.job">
        <field name="name">Restaurant Supervisor</field>
        <field name="department_id" ref="dept_service"/>
        <field name="no_of_recruitment">1</field>
        <field name="is_published">True</field>
        <field name="website_published">True</field>
        <field name="salary_min">28000</field>
        <field name="salary_max">40000</field>
        <field name="requirements">2+ years supervisory experience in restaurant, cafe, or hospitality operations. Strong leadership, POS familiarity, and customer service excellence.</field>
        <field name="description" type="html">
            <p>We are looking for a proactive <strong>Restaurant Supervisor</strong> to lead daily front-of-house operations at <strong>Resto Cafe – Kerala</strong>. In this role, you will supervise staff, ensure smooth service, handle guest feedback, and maintain high standards of cleanliness and operational efficiency. The ideal candidate has strong leadership and communication skills, experience in hospitality, and thrives in a fast-paced environment while delivering memorable dining experiences inspired by Kerala’s warm hospitality.</p>
            <h4>Key Responsibilities:</h4>
            <ul>
                <li>Supervise floor staff, table assignments, and guest flow across dining floors and outdoor patio.</li>
                <li>Operate and oversee Point of Sale (POS) checkout, discount vouchers, and daily shift closing reports.</li>
                <li>Handle customer feedback, reservations, and special dining requests with poise and warmth.</li>
                <li>Coordinate directly with kitchen chef teams to ensure fast order turnaround times.</li>
            </ul>
        </field>
        <field name="website_description" type="html">
            <div class="lead">
                <p>We are looking for a proactive <strong>Restaurant Supervisor</strong> to lead daily front-of-house operations at <strong>Resto Cafe – Kerala</strong>. In this role, you will supervise staff, ensure smooth service, handle guest feedback, and maintain high standards of cleanliness and operational efficiency.</p>
            </div>
            <div class="row mt24">
                <div class="col-lg-8">
                    <h4>What You Will Do:</h4>
                    <ul>
                        <li>Lead the service team across dining floor and outdoor patio.</li>
                        <li>Ensure guests receive attentive hospitality and authentic Kerala warmth.</li>
                        <li>Supervise POS cashier registers, table floor plan allocations, and shift closures.</li>
                    </ul>
                    <h4>What We Look For:</h4>
                    <ul>
                        <li>2+ years in supervisory or shift lead roles in dining / hospitality.</li>
                        <li>Excellent verbal communication and natural leadership instincts.</li>
                        <li>Comfort with modern Restaurant POS software and floor management.</li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <div class="card p-3 bg-light border-0">
                        <h5>Role Overview</h5>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Position:</strong> Restaurant Supervisor</li>
                            <li><strong>Type:</strong> Full-time / Shift</li>
                            <li><strong>Openings:</strong> 1 Opening</li>
                            <li><strong>Compensation:</strong> ₹28,000 - ₹40,000 / month</li>
                            <li><strong>Location:</strong> Resto Cafe Kerala</li>
