    <!-- ================================================================
         1. RESTAURANT CHEF (PUBLISHED ON WEBSITE)
         ================================================================ -->
    <record id="job_resto_chef" model="hr.job">
        <field name="name">Restaurant Chef</field>
        <field name="department_id" ref="dept_kitchen"/>
        <field name="no_of_recruitment">2</field>
        <field name="is_published">True</field>
        <field name="website_published">True</field>
        <field name="salary_min">35000</field>
        <field name="salary_max">50000</field>
        <field name="requirements">Proven culinary experience in Kerala and South Indian cuisine. Strong knowledge of food safety, hygienic handling, menu plating, and high-volume kitchen coordination.</field>
        <field name="description" type="html">
            <p><strong>Passionate and detail-oriented Restaurant Chef</strong> with hands-on experience in <strong>Kerala and South Indian cuisine</strong>, specializing in consistent taste, hygienic food preparation, and fast-paced kitchen operations. Skilled in menu planning, preparation, plating, inventory control, and team coordination to deliver high-quality dishes on time. Committed to maintaining food safety standards, reducing wastage, and delivering authentic dining experiences.</p>
            <h4>Key Responsibilities:</h4>
            <ul>
                <li>Prepare and present authentic Kerala culinary specialties, curries, and cafe dishes to high quality standards.</li>
                <li>Monitor food inventory, control kitchen waste, and coordinate daily fresh raw ingredient supplies.</li>
                <li>Ensure rigorous kitchen sanitation, compliance with hygiene standards, and food safety regulations.</li>
                <li>Train and mentor junior kitchen staff and line cooks during busy dining shifts.</li>
            </ul>
        </field>
        <field name="website_description" type="html">
            <div class="lead">
                <p>Passionate and detail-oriented <strong>Restaurant Chef</strong> with hands-on experience in <strong>Kerala and South Indian cuisine</strong>, specializing in consistent taste, hygienic food preparation, and fast-paced kitchen operations. Skilled in menu planning, preparation, plating, inventory control, and team coordination to deliver high-quality dishes on time.</p>
            </div>
            <div class="row mt24">
                <div class="col-lg-8">
                    <h4>What You Will Do:</h4>
                    <ul>
                        <li>Prepare authentic Kerala curries, biryanis, seafood specialties, and artisan cafe dishes.</li>
                        <li>Maintain pristine culinary hygiene, portion control, and ingredient freshness.</li>
                        <li>Coordinate smoothly with the front-of-house service staff and kitchen order displays.</li>
                    </ul>
                    <h4>What We Look For:</h4>
                    <ul>
                        <li>3+ years of professional culinary experience in busy restaurant environments.</li>
                        <li>Expertise in traditional spice blends, slow-cooking methods, and contemporary plating.</li>
                        <li>High energy, culinary discipline, and dedication to unforgettable dining experiences.</li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <div class="card p-3 bg-light border-0">
                        <h5>Role Overview</h5>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Position:</strong> Restaurant Chef</li>
                            <li><strong>Type:</strong> Full-time / Permanent</li>
                            <li><strong>Openings:</strong> 2 Openings</li>
                            <li><strong>Compensation:</strong> ₹35,000 - ₹50,000 / month</li>
                            <li><strong>Location:</strong> Resto Cafe Kerala</li>
                        </ul>
                    </div>
                </div>
            </div>
        </field>
        <field name="website_rating" type="html">
            <div>
                <div class="s_rating pb8" data-vcss="001" data-rating-icon="star" data-snippet="s_rating" data-name="Rating">
                    <strong class="s_rating_title">Culinary Expertise</strong>
                    <div class="s_rating_icons o_not_editable">
                        <span class="s_rating_active_icons text-primary">
                            <i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/>
                        </span>
                    </div>
                </div>
                <div class="s_rating pb8" data-vcss="001" data-rating-icon="star" data-snippet="s_rating" data-name="Rating">
                    <strong class="s_rating_title">Team Coordination</strong>
                    <div class="s_rating_icons o_not_editable">
                        <span class="s_rating_active_icons text-primary">
                            <i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/><i class="oi oi-filled" data-icon="star"/>
