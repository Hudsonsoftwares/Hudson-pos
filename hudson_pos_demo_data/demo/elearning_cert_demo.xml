<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="rc_survey_food_safety_cert" model="survey.survey">
            <field name="title">Food Safety &amp; Hygiene Certification Exam</field>
            <field name="certification" eval="True"/>
            <field name="scoring_type">scoring_with_answers</field>
            <field name="scoring_success_min" eval="70"/>
            <field name="questions_layout">page_per_question</field>
            <field name="access_mode">public</field>
            <field name="is_attempts_limited" eval="True"/>
            <field name="attempts_limit" eval="3"/>
            <field name="certification_validity_months" eval="12"/>
            <field name="description">&lt;p&gt;5 questions. Score 70% or more to earn your Resto Cafe Food Safety certificate.&lt;/p&gt;</field>
        </record>
        <record id="rc_cert_q1" model="survey.question">
            <field name="title">What is the safe temperature range for a chiller?</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="question_type">simple_choice</field>
            <field name="sequence" eval="1"/>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="rc_cert_q1_a1" model="survey.question.answer">
            <field name="value">0 to 5 °C</field>
            <field name="question_id" ref="rc_cert_q1"/>
            <field name="is_correct" eval="True"/>
            <field name="answer_score" eval="20"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="rc_cert_q1_a2" model="survey.question.answer">
            <field name="value">8 to 12 °C</field>
            <field name="question_id" ref="rc_cert_q1"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="rc_cert_q1_a3" model="survey.question.answer">
            <field name="value">-18 °C</field>
            <field name="question_id" ref="rc_cert_q1"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="rc_cert_q2" model="survey.question">
            <field name="title">How long should you wash your hands?</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="question_type">simple_choice</field>
            <field name="sequence" eval="2"/>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="rc_cert_q2_a1" model="survey.question.answer">
            <field name="value">At least 20 seconds</field>
            <field name="question_id" ref="rc_cert_q2"/>
            <field name="is_correct" eval="True"/>
            <field name="answer_score" eval="20"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="rc_cert_q2_a2" model="survey.question.answer">
            <field name="value">5 seconds</field>
            <field name="question_id" ref="rc_cert_q2"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="rc_cert_q2_a3" model="survey.question.answer">
            <field name="value">Only if visibly dirty</field>
            <field name="question_id" ref="rc_cert_q2"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="rc_cert_q3" model="survey.question">
            <field name="title">Which colour chopping board is used for raw meat?</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="question_type">simple_choice</field>
            <field name="sequence" eval="3"/>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="rc_cert_q3_a1" model="survey.question.answer">
            <field name="value">Red</field>
            <field name="question_id" ref="rc_cert_q3"/>
            <field name="is_correct" eval="True"/>
            <field name="answer_score" eval="20"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="rc_cert_q3_a2" model="survey.question.answer">
            <field name="value">Blue</field>
            <field name="question_id" ref="rc_cert_q3"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="rc_cert_q3_a3" model="survey.question.answer">
            <field name="value">Green</field>
            <field name="question_id" ref="rc_cert_q3"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="rc_cert_q4" model="survey.question">
            <field name="title">Hot food must be held above which temperature?</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="question_type">simple_choice</field>
            <field name="sequence" eval="4"/>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="rc_cert_q4_a1" model="survey.question.answer">
            <field name="value">63 °C</field>
            <field name="question_id" ref="rc_cert_q4"/>
            <field name="is_correct" eval="True"/>
            <field name="answer_score" eval="20"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="rc_cert_q4_a2" model="survey.question.answer">
            <field name="value">40 °C</field>
            <field name="question_id" ref="rc_cert_q4"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="rc_cert_q4_a3" model="survey.question.answer">
            <field name="value">50 °C</field>
            <field name="question_id" ref="rc_cert_q4"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="rc_cert_q5" model="survey.question">
            <field name="title">What does FIFO mean in the store room?</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="question_type">simple_choice</field>
            <field name="sequence" eval="5"/>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="rc_cert_q5_a1" model="survey.question.answer">
            <field name="value">First in, first out</field>
            <field name="question_id" ref="rc_cert_q5"/>
            <field name="is_correct" eval="True"/>
            <field name="answer_score" eval="20"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="rc_cert_q5_a2" model="survey.question.answer">
            <field name="value">Fresh items first out</field>
            <field name="question_id" ref="rc_cert_q5"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="rc_cert_q5_a3" model="survey.question.answer">
            <field name="value">Fill it fully once</field>
            <field name="question_id" ref="rc_cert_q5"/>
            <field name="is_correct" eval="False"/>
            <field name="answer_score" eval="0"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="slide_safety_certification" model="slide.slide">
            <field name="name">Final Certification Exam</field>
            <field name="channel_id" ref="slide_channel_food_safety"/>
            <field name="slide_category">certification</field>
            <field name="survey_id" ref="rc_survey_food_safety_cert"/>
            <field name="sequence" eval="20"/>
            <field name="completion_time" eval="0.25"/>
            <field name="is_published" eval="True"/>
        </record>
    </data>
</odoo>
