<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action on pos.config: Load Demo Data -->
    <record id="action_load_pos_demo_data_server" model="ir.actions.server">
        <field name="name">Load Resto/Cafe Demo Data</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">
action = env['pos.config'].action_load_pos_demo_data_all()
        </field>
    </record>

    <!-- Server Action on pos.config: Turn Off / Clear Demo Data -->
    <record id="action_clear_pos_demo_data_server" model="ir.actions.server">
        <field name="name">Turn Off / Clear Demo Data</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="state">code</field>
        <field name="code">
action = env['pos.config'].action_clear_pos_demo_data()
        </field>
    </record>
</odoo>
