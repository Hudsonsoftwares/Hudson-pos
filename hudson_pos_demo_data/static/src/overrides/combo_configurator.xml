<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Show variants of the same product as ONE card in the combo popup;
         the variant is chosen in the product configurator. -->
    <t t-name="hudson_pos_demo_data.ComboConfiguratorPopup" t-inherit="point_of_sale.ComboConfiguratorPopup" t-inherit-mode="extension">
        <xpath expr="//div[@t-foreach='combo.combo_item_ids']" position="replace">
            <t t-foreach="this.getComboGroups(combo)" t-as="group" t-key="group.key">
                <!-- Single product: same card as core -->
                <div t-if="group.items.length === 1">
                    <t t-set="combo_item" t-value="group.items[0]"/>
                    <t t-set="product" t-value="combo_item.product_id"/>
                    <label class="combo-item d-block h-100 w-100 rounded cursor-pointer transition-base"
                        t-att-class="{ 'selected': this.state.qty[combo.id][combo_item.id] }"
                        t-attf-for="combo-{{combo.id}}-combo_item-{{combo_item.id}}">
                        <ProductCard name="product.display_name"
                            class="'flex-column h-100'"
                            isComboPopup="true"
                            productId="product.id"
                            available="!this.pos.isProductSnoozed(product.product_tmpl_id)"
                            product="product"
                            comboExtraPrice="this.formattedComboPrice(combo_item)"
                            color="product.color || product.pos_categ_ids?.at(-1)?.color"
                            imageUrl="this.pos.config.show_product_images and product.getImageUrl()"
                            onClick="() => this.onClickProduct(product, combo_item)">
                            <t t-if="this.showQuantityButtons(combo_item)" t-set-slot="quantityButtons">
                                <QuantityButtons
                                    quantity="this.state.qty[combo.id][combo_item.id]"
                                    setQuantity="quantity => this.setQuantity(combo_item, quantity)"
                                    isPlusButtonDisabled="this.totalQuantityForCombo(combo.id) == combo.qty_max"
                                    btnClasses="'d-inline-block w-auto'"
                                />
                            </t>
                        </ProductCard>
                    </label>
                </div>
                <!-- Several variants of one product: one card, pick variant on click -->
                <div t-else="">
                    <t t-set="tmpl" t-value="group.tmpl"/>
                    <label class="combo-item combo-variant-group d-block h-100 w-100 rounded cursor-pointer transition-base"
                        t-att-class="{ 'selected': this.groupQty(group) }"
                        t-attf-for="combo-{{combo.id}}-tmpl-{{tmpl.id}}">
                        <ProductCard name="this.getGroupName(group)"
                            class="'flex-column h-100'"
                            isComboPopup="true"
                            productId="'tmpl-' + tmpl.id"
                            available="!this.pos.isProductSnoozed(tmpl)"
                            product="tmpl"
                            comboExtraPrice="this.formattedGroupPrice(group)"
                            color="tmpl.color || tmpl.pos_categ_ids?.at(-1)?.color"
                            imageUrl="this.pos.config.show_product_images and (tmpl.getImageUrl() or group.items[0].product_id.getImageUrl())"
                            onClick="() => this.onClickProductGroup(group)">
                            <t t-if="this.showGroupQuantityButtons(group)" t-set-slot="quantityButtons">
                                <QuantityButtons
                                    quantity="this.groupQty(group)"
                                    setQuantity="quantity => this.setGroupQuantity(group, quantity)"
                                    isPlusButtonDisabled="this.totalQuantityForCombo(combo.id) == combo.qty_max"
                                    btnClasses="'d-inline-block w-auto'"
                                />
                            </t>
                        </ProductCard>
                    </label>
                </div>
            </t>
        </xpath>
    </t>
</templates>
