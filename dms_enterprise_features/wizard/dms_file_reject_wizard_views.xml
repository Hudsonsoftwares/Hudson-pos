<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_file_reject_wizard_form" model="ir.ui.view">
        <field name="name">dms.file.reject.wizard.form</field>
        <field name="model">dms.file.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Document Approval">
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                    <i class="fa fa-exclamation-circle fa-2x me-3 text-danger"></i>
                    <div>
                        You are rejecting approval for <strong><field name="file_name" readonly="1" class="d-inline"/></strong>.
                        Please provide the reason below. The document owner will be notified with this reason.
                    </div>
                </div>
                <group>
                    <field name="file_id" invisible="1"/>
                    <field name="reason" nolabel="1" placeholder="Enter reason for rejection or required changes..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn btn-danger"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
