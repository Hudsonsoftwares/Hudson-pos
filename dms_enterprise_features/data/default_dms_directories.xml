    Creates the default root DMS directories for each business area.
    These are used as default targets in the Files Centralization settings.
    noupdate="0" ensures they are created and updated.
-->
<odoo noupdate="0">

    <!-- ── Enterprise Access Group ────────────────────────────────── -->
    <record id="dms_access_group_enterprise" model="dms.access.group">
        <field name="name">Enterprise Folders (Full Access)</field>
        <field name="perm_create">True</field>
        <field name="perm_write">True</field>
        <field name="perm_unlink">False</field>
        <field name="group_ids" eval="[
            (4, ref('dms.group_dms_manager')), 
            (4, ref('dms_enterprise_features.group_dms_document_controller'))
        ]"/>
    </record>

    <!-- ── Root: Projects ─────────────────────────────────────────── -->
    <record id="dms_dir_projects" model="dms.directory">
        <field name="name">Projects</field>
        <field name="is_root_directory">True</field>
        <field name="storage_id" ref="dms_storage_enterprise"/>
        <field name="group_ids" eval="[(4, ref('dms_access_group_enterprise'))]"/>
    </record>

    <!-- ── Root: Products ─────────────────────────────────────────── -->
    <record id="dms_dir_products" model="dms.directory">
