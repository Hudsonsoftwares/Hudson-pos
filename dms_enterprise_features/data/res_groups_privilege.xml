<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- In Odoo 19, privileges are used to group access rights in the user settings form -->
        <record id="privilege_dms_security" model="res.groups.privilege">
            <field name="name">Documents</field>
            <!-- Link this privilege to the existing DMS category -->
            <field name="category_id" ref="dms.category_dms_security"/>
            <field name="placeholder">No</field>
        </record>

        <!-- Assign the existing DMS groups to this privilege so they appear as dropdown options -->
        <record id="dms.group_dms_user" model="res.groups">
            <field name="privilege_id" ref="dms_enterprise_features.privilege_dms_security"/>
        </record>

        <record id="dms.group_dms_manager" model="res.groups">
            <field name="privilege_id" ref="dms_enterprise_features.privilege_dms_security"/>
        </record>

        <record id="group_dms_administrator" model="res.groups">
            <field name="privilege_id" ref="dms_enterprise_features.privilege_dms_security"/>
        </record>
    </data>
</odoo>
