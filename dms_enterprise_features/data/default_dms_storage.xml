    Creates a default "Enterprise" DMS storage for auto-routed documents.
    noupdate="1" prevents re-creating if already exists.
-->
<odoo noupdate="1">
    <record id="dms_storage_enterprise" model="dms.storage">
        <field name="name">Enterprise Documents</field>
        <field name="save_type">file</field>
        <field name="is_hidden">False</field>
    </record>
</odoo>
