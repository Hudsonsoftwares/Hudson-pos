<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_signature_request_form" model="ir.ui.view">
        <field name="name">dms.file.signature.request.form</field>
        <field name="model">dms.file.signature.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" duplicate="0">
                <header>
                    <button name="action_send" string="Send Request" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_apply_signature" string="Apply Signature" type="object" class="oe_highlight" invisible="state == 'signed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="row">
                        <div class="col-8" style="height: 80vh; border: 1px solid #ccc;">
                            <field name="pdf_content" widget="pdf_viewer" readonly="1" invisible="not pdf_content"/>
                        </div>
                        <div class="col-4">
                            <h3>Signature Request Details</h3>
                            <group>
                                <field name="revision_id" readonly="1"/>
                                <field name="recipient_id" readonly="1"/>
                                <field name="signed_date" invisible="state != 'signed'"/>
                            </group>
                            <notebook>
                                <page string="Fields">
                                    <field name="item_ids" readonly="1">
                                        <list>
                                            <field name="item_type"/>
                                            <field name="page_number"/>
                                            <field name="state"/>
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_dms_signature_request_tree" model="ir.ui.view">
        <field name="name">dms.file.signature.request.tree</field>
        <field name="model">dms.file.signature.request</field>
        <field name="arch" type="xml">
            <list string="Signature Requests" create="0">
                <field name="revision_id" string="Document"/>
                <field name="recipient_id" string="Recipient"/>
                <field name="create_uid" string="Sent By" widget="many2one_avatar_user" optional="show"/>
                <field name="create_date" string="Sent Date" optional="show"/>
                <field name="valid_until" optional="hide"/>
                <field name="signed_date" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'sent'" 
                       decoration-success="state == 'signed'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_dms_signature_request_search" model="ir.ui.view">
        <field name="name">dms.file.signature.request.search</field>
        <field name="model">dms.file.signature.request</field>
        <field name="arch" type="xml">
            <search string="Search Signature Requests">
                <field name="revision_id" string="Document"/>
                <field name="recipient_id"/>
                <field name="create_uid" string="Sent By"/>
                <filter string="Sent by Me" name="sent_by_me" domain="[('create_uid', '=', uid)]"/>
                <filter string="Received by Me" name="received_by_me" domain="[('recipient_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <filter string="Signed" name="signed" domain="[('state', '=', 'signed')]"/>
                <separator/>
                <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Recipient" name="group_by_recipient" context="{'group_by': 'recipient_id'}"/>
                <filter string="Sent By" name="group_by_create_uid" context="{'group_by': 'create_uid'}"/>
                <filter string="Document" name="group_by_revision" context="{'group_by': 'revision_id'}"/>
            </search>
        </field>
    </record>

</odoo>
