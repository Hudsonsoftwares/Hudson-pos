<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hudson_loan_comp_rule" model="ir.access">
            <field name="name">Loan multi-company</field>
            <field name="model_id" ref="model_hudson_loan"/>
            <field name="kind">restriction</field>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hudson_loan_line_comp_rule" model="ir.access">
            <field name="name">Loan Line multi-company</field>
            <field name="model_id" ref="model_hudson_loan_line"/>
            <field name="kind">restriction</field>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
