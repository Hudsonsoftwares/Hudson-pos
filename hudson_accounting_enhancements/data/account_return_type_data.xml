<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="return_type_tax" model="account.return.type">
        <field name="name">Tax Return</field>
        <field name="code">TAX</field>
        <field name="category">tax</field>
        <field name="states_workflow">paid</field>
        <field name="periodicity">monthly</field>
        <field name="deadline_days_delay">20</field>
        <field name="auto_generate" eval="True"/>
        <field name="country_id" eval="False"/>
        <field name="sequence">10</field>
    </record>

    <record id="return_type_annual_closing" model="account.return.type">
        <field name="name">Annual Closing: Corporate Tax</field>
        <field name="code">ANNUAL</field>
        <field name="category">annual</field>
        <field name="states_workflow">submitted</field>
        <field name="periodicity">yearly</field>
        <field name="deadline_days_delay">7</field>
        <field name="auto_generate" eval="False"/>
        <field name="country_id" eval="False"/>
        <field name="sequence">20</field>
    </record>

</odoo>
