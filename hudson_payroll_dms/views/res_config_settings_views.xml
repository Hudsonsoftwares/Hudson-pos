<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payroll.dms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hudson_payroll_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='payroll_setting_container']" position="inside">
                <setting id="hds_dms_store_payslips_setting" string="Store Payslips in Documents"
                         help="Store the PDF of each validated payslip in the employee's Documents folder (Payroll / tax year). Employees see their own payslips there.">
                    <field name="hds_dms_store_payslips"/>
                    <div class="mt8" invisible="not hds_dms_store_payslips">
                        <button name="action_hds_dms_store_existing_payslips" type="object" icon="arrow_forward"
                                string="Store existing payslips" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
