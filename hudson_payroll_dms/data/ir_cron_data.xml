<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stores validated payslip PDFs in Documents. Triggered right after a validation; the
         interval only retries failed ones. -->
    <record id="ir_cron_hds_dms_store_payslips" model="ir.cron">
        <field name="name">Payroll: Store Payslips in Documents</field>
        <field name="model_id" ref="hudson_payroll_base.model_hr_payslip"/>
        <field name="state">code</field>
        <field name="code">model._cron_hds_dms_store_payslips()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
