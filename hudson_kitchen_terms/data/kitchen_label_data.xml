<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Manufacturing / Kitchen Mode Default Terminology -->

    <!-- Bills of Materials / Recipes -->
    <record id="label_bills_of_materials" model="kitchen.label">
        <field name="name">Bills of Materials</field>
        <field name="kitchen_label">Recipes</field>
        <field name="sequence">10</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Bills of Materials -> Recipes</field>
    </record>

    <!-- Manufacturing Orders / Production Orders -->
    <record id="label_manufacturing_orders" model="kitchen.label">
        <field name="name">Manufacturing Orders</field>
        <field name="kitchen_label">Production Orders</field>
        <field name="sequence">20</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Manufacturing Orders -> Production Orders</field>
    </record>

    <!-- Work Orders / Kitchen Tasks -->
    <record id="label_work_orders" model="kitchen.label">
        <field name="name">Work Orders</field>
        <field name="kitchen_label">Kitchen Tasks</field>
        <field name="sequence">30</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Work Orders -> Kitchen Tasks</field>
    </record>

    <!-- Work Centers / Kitchen Stations -->
    <record id="label_work_centers" model="kitchen.label">
        <field name="name">Work Centers</field>
        <field name="kitchen_label">Kitchen Stations</field>
        <field name="sequence">40</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Work Centers -> Kitchen Stations</field>
    </record>

    <!-- Components / Ingredients -->
    <record id="label_components" model="kitchen.label">
        <field name="name">Components</field>
        <field name="kitchen_label">Ingredients</field>
        <field name="sequence">50</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Components -> Ingredients</field>
    </record>

    <!-- Operations / Prep Steps -->
    <record id="label_operations" model="kitchen.label">
        <field name="name">Operations</field>
        <field name="kitchen_label">Prep Steps</field>
        <field name="sequence">60</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Operations -> Prep Steps</field>
    </record>

    <!-- Scrap Orders / Wastage -->
    <record id="label_scrap_orders" model="kitchen.label">
        <field name="name">Scrap Orders</field>
        <field name="kitchen_label">Wastage</field>
        <field name="sequence">70</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Scrap Orders -> Wastage</field>
    </record>

    <!-- Unbuild Orders / Batch Reversals -->
    <record id="label_unbuild_orders" model="kitchen.label">
        <field name="name">Unbuild Orders</field>
        <field name="kitchen_label">Batch Reversals</field>
        <field name="sequence">80</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Unbuild Orders -> Batch Reversals</field>
    </record>

    <!-- Productivity Losses / Downtime Reasons -->
    <record id="label_productivity_losses" model="kitchen.label">
        <field name="name">Productivity Losses</field>
        <field name="kitchen_label">Downtime Reasons</field>
        <field name="sequence">90</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Standard Productivity Losses -> Downtime Reasons</field>
    </record>

    <!-- Planning by Work Center / Station Planning -->
    <record id="label_planning_by_work_center" model="kitchen.label">
        <field name="name">Planning by Work Center</field>
        <field name="kitchen_label">Station Planning</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Planning by Work Center -> Station Planning</field>
    </record>

    <!-- Overall Equipment Effectiveness / Station Efficiency -->
    <record id="label_overall_equipment_effectiveness" model="kitchen.label">
        <field name="name">Overall Equipment Effectiveness</field>
        <field name="kitchen_label">Station Efficiency</field>
        <field name="sequence">110</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Overall Equipment Effectiveness -> Station Efficiency</field>
    </record>

    <!-- Shop Floor / Kitchen Floor -->
    <record id="label_shop_floor" model="kitchen.label">
        <field name="name">Shop Floor</field>
        <field name="kitchen_label">Kitchen Floor</field>
        <field name="sequence">120</field>
        <field name="company_id" eval="False"/>
        <field name="notes">Shop Floor -> Kitchen Floor</field>
    </record>
</odoo>
