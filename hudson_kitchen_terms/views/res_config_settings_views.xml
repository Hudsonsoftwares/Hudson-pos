<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_kitchen_terms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kitchen.terms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Kitchen Mode" name="kitchen_mode_setting_block">
                    <setting id="kitchen_mode_setting" string="Kitchen Mode" help="Use restaurant/kitchen terminology">
                        <field name="kitchen_mode"/>
                        <div class="content-group" invisible="not kitchen_mode">
                            <div class="mt8">
                                <button name="%(action_kitchen_label)d" icon="fa-arrow-right" type="action" string="Configure Kitchen Labels" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
