<t name="Blog Posts" t-name="website_blog.blog_post_short">
    <t t-set="head">
        <link t-if="blog" t-att-href="'/blog/%s/feed' % slug(blog)" type="application/atom+xml" rel="alternate" title="Atom Feed"/>
        <meta t-if="active_tag_ids" name="robots" t-attf-content="none"/>
    </t>
    <t t-call="website_blog.index" head="head">

        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
        <style>
#wrap.website_blog { background: #fbf7f0; font-family: 'Inter', system-ui, sans-serif; color: #3d332a; }
.website_blog h1, .website_blog h2, .website_blog h3, .website_blog .o_blog_post_title { font-family: 'Playfair Display', Georgia, serif; color: #15110e; }
/* hero (in the "Blog page header" drop zone) */
.rc-blog-hero { position: relative; padding: 170px 0 110px; color: #f6efe4;
  background: linear-gradient(100deg, rgba(21,17,14,.95) 0%, rgba(21,17,14,.78) 55%, rgba(21,17,14,.4) 100%),
              url('/theme_bistro/static/src/img/backgrounds/15.webp') center/cover no-repeat; }
.rc-blog-hero .rc-eyebrow { display: inline-flex; align-items: center; gap: .75rem; font-size: .78rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: #c9a15d; }
.rc-blog-hero .rc-eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
.rc-blog-hero h1 { font-size: clamp(2.6rem, 5.6vw, 4.6rem); line-height: 1.05; color: #fff !important; margin: 22px 0; max-width: 800px; }
.rc-blog-hero h1 em { color: #c9a15d; }
.rc-blog-hero p { color: #d9cfbf; font-size: 1.12rem; line-height: 1.8; max-width: 600px; }
.rc-blog-hero .rc-topics { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
.rc-blog-hero .rc-topics span { border: 1px solid rgba(201,161,93,.45); color: #e0c38c; border-radius: 999px; padding: 7px 16px; font-size: .85rem; }
/* category bar and search */
.website_blog .o_wblog_category, .website_blog .nav-link { font-weight: 500; }
.website_blog .nav-pills .nav-link.active, .website_blog .nav-link.active { background: #15110e !important; color: #c9a15d !important; border-radius: 999px; }
.website_blog .nav-pills .nav-link { border-radius: 999px; color: #3d332a; }
.website_blog input[type="search"], .website_blog .o_searchbar_form input, .website_blog .search-query { border-radius: 999px !important; border-color: #e0d2bb !important; }
.website_blog .btn-primary { background: #15110e !important; border-color: #15110e !important; color: #c9a15d !important; border-radius: 999px; }
.website_blog .btn-primary:hover { background: #c9a15d !important; color: #15110e !important; }
/* post cards */
#o_wblog_index_content { padding-top: 40px; padding-bottom: 90px; }
.website_blog .o_wblog_post { background: #fff; border: 1px solid #efe5d5; border-radius: 18px; overflow: hidden; transition: all .35s ease; padding-bottom: 6px; }
.website_blog .o_wblog_post:hover { transform: translateY(-6px); box-shadow: 0 30px 50px -30px rgba(43,33,26,.5); border-color: #e3d2b4; }
.website_blog .o_wblog_post_cover, .website_blog .o_wblog_post .o_record_cover_container { border-radius: 0 !important; overflow: hidden; }
.website_blog .o_wblog_post .o_record_cover_image { transition: transform 1s ease; }
.website_blog .o_wblog_post:hover .o_record_cover_image { transform: scale(1.06); }
.website_blog .o_wblog_post > :not(.o_wblog_post_cover):not(a:first-child) { padding-left: 22px; padding-right: 22px; }
.website_blog .o_blog_post_title { font-size: 1.4rem; line-height: 1.3; margin-top: 16px; }
.website_blog .o_wblog_post a:hover .o_blog_post_title { color: #9a7a43; }
.website_blog .o_wblog_teaser { color: #6f6253; line-height: 1.75; font-size: .96rem; }
.website_blog .o_wblog_post .badge { background: #f4ecdf !important; color: #7a6a57 !important; border-radius: 999px; font-weight: 500; padding: 6px 12px; }
.website_blog .o_wblog_author_avatar { border: 2px solid #c9a15d; }
.website_blog .o_wblog_post_author, .website_blog .o_wblog_post_list_author { color: #a99a86; font-size: .85rem; }
.website_blog .pagination .page-link { border-radius: 999px !important; margin: 0 4px; color: #15110e; border-color: #e0d2bb; }
.website_blog .pagination .page-item.active .page-link { background: #15110e; border-color: #15110e; color: #c9a15d; }
/* sidebar */
.website_blog .o_wblog_sidebar, .website_blog aside { font-size: .95rem; }
.website_blog .o_wblog_sidebar h4, .website_blog .o_wblog_sidebar h5, .website_blog .o_wblog_sidebar h6 { font-family: 'Playfair Display', Georgia, serif; }
/* website header: dark glass, same as the homepage */
header#top { background: rgba(21,17,14,.92) !important; backdrop-filter: blur(12px); border-bottom: 1px solid rgba(201,161,93,.22); }
header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
header#top .navbar .nav-link, header#top .navbar a:not(.dropdown-item):not(.btn-primary), header#top .navbar button:not(.btn-primary):not(.dropdown-item),
header#top .navbar .navbar-brand, header#top .navbar .fa, header#top .navbar .oi { color: #f6efe4 !important; }
header#top .navbar .nav-link:hover, header#top .navbar .nav-link.active { color: #c9a15d !important; background: transparent !important; }
header#top .o_navlink_background { background: rgba(246,239,228,.12) !important; border-color: rgba(246,239,228,.18) !important; }
header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
header#top .offcanvas { background: #1f1813 !important; }
header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item) { color: #f6efe4 !important; }
header#top .offcanvas .btn-close { filter: invert(1); }
header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; }
@media (max-width: 991px) { .rc-blog-hero { padding: 140px 0 80px; } }
        </style>

        <!-- Options flags -->
        <!-- Layout options -->
        <t t-set="opt_blog_bordered_grid_view" t-value="is_view_active('website_blog.opt_blog_bordered_grid_view')"/>
        <t t-set="opt_blog_split_grid_view" t-value="is_view_active('website_blog.opt_blog_split_grid_view')"/>
        <t t-set="opt_blog_simple_list_view" t-value="is_view_active('website_blog.opt_blog_simple_list_view')"/>
        <t t-set="opt_blog_compact_list_view" t-value="is_view_active('website_blog.opt_blog_compact_list_view')"/>
        <t t-set="opt_blog_list_view" t-value="is_view_active('website_blog.opt_blog_list_view')"/>
        <t t-set="opt_blog_large_list_view" t-value="is_view_active('website_blog.opt_blog_large_list_view')"/>
        <t t-set="opt_blog_grid_view" t-value="not any([opt_blog_split_grid_view, opt_blog_bordered_grid_view, opt_blog_simple_list_view, opt_blog_compact_list_view, opt_blog_list_view, opt_blog_large_list_view])"/>

        <t t-set="is_grid_view" t-value="opt_blog_grid_view or opt_blog_split_grid_view or opt_blog_bordered_grid_view"/>
        <t t-set="is_list_view" t-value="not is_grid_view"/>
        <!-- Derived: split grid sticky layout requires at least 3 posts. -->
        <t t-set="is_split_grid_sticky" t-value="opt_blog_split_grid_view and len(posts) &gt;= 3"/>

        <!-- Layout sub-options -->
        <t t-set="opt_blog_cards_design" t-value="is_view_active('website_blog.opt_blog_cards_design') and opt_blog_grid_view"/>
        <t t-set="opt_blog_promoted_post" t-value="is_view_active('website_blog.opt_blog_promoted_post') and opt_blog_grid_view"/>

        <!-- Show the title -->
        <t t-set="opt_blog_page_title" t-value="is_view_active('website_blog.opt_blog_page_title')"/>

        <!-- Container width -->
        <t t-set="opt_blog_fullwidth" t-value="not opt_blog_simple_list_view and is_view_active('website_blog.opt_blog_fullwidth')"/>

        <!-- Content options -->
        <t t-set="opt_posts_loop_show_cover" t-value="is_view_active('website_blog.opt_posts_loop_show_cover')"/>
        <t t-set="opt_posts_loop_show_filter" t-value="is_view_active('website_blog.opt_posts_loop_show_filter')"/>
        <t t-set="opt_posts_loop_show_teaser" t-value="is_view_active('website_blog.opt_posts_loop_show_teaser')"/>
        <t t-set="opt_posts_loop_show_tags" t-value="is_view_active('website_blog.opt_posts_loop_show_tags')"/>
        <t t-set="opt_posts_loop_show_stats" t-value="is_view_active('website_blog.opt_posts_loop_show_stats')"/>
        <t t-set="opt_posts_loop_show_author" t-value="is_view_active('website_blog.opt_posts_loop_show_author')"/>
        <t t-set="opt_posts_loop_show_date" t-value="is_view_active('website_blog.opt_posts_loop_show_date')"/>
        
        <!-- Sidebar options -->
        <t t-set="opt_sidebar_about_us" t-value="not is_view_active('website_blog.opt_sidebar_blog_index_about_us')"/>
        <t t-set="opt_sidebar_follow_us" t-value="is_view_active('website_blog.opt_sidebar_blog_index_follow_us')"/>
        <t t-set="opt_sidebar_archives" t-value="is_view_active('website_blog.opt_sidebar_blog_index_archives')"/>
        <t t-set="opt_sidebar_tags" t-value="is_view_active('website_blog.opt_sidebar_blog_index_tags')"/>
        <!-- Sidebar shows automatically when any content option is enabled, but never in split grid layout -->
        <t t-set="opt_blog_sidebar_show" t-value="not opt_blog_split_grid_view and (opt_sidebar_about_us or opt_sidebar_follow_us or opt_sidebar_archives or opt_sidebar_tags)"/>
        
        <!-- Page layout -->
        <div id="o_wblog_blog_top" t-att-class="blog and 'o_wblog_single_blog_top'">
            <!-- Selectively display droppable-areas for 'all blogs' or single-blog pages -->
            <t t-if="not tag and not date_begin and not search">
                <div id="o_wblog_blog_top_droppable"/>
                <t t-if="blog">
                    <div t-field="blog.content" t-attf-data-editor-message.translate="Drag blocks here to customize the header of the &quot;{{blog.name}}&quot; category."/>
                </t>
                <t t-elif="blogs">
                    <div class="oe_structure" data-editor-message.translate="Drag blocks here to customize the Blog page header">
                        <section class="rc-blog-hero o_colored_level" data-name="Blog Hero">
                            <div class="container">
                                <span class="rc-eyebrow">The Resto Cafe Journal</span>
                                <h1>Stories from our <em>kitchen</em></h1>
                                <p>Family recipes, the secrets behind our filter coffee, festival feasts and behind-the-scenes moments with our chefs and baristas.</p>
                                <div class="rc-topics">
                                    <span>Recipes</span><span>Kerala Cuisine</span><span>Coffee</span><span>Festivals</span><span>Behind the Scenes</span>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
            <t t-else="">
                <!-- Droppable-area for filtered results (tags or date) -->
                <div class="oe_structure" id="oe_structure_blog_filtered_header" data-editor-message.translate="Drag blocks here to customize the &quot;Filter Results&quot; page header"/>
            </t>
        </div>

        <t t-call="website_blog.blogs_nav" search="original_search or search" additional_classes.f="#{(opt_blog_fullwidth or opt_blog_split_grid_view) and 'container-fluid' or 'container'}"/>

        <section id="o_wblog_index_content">
            <t t-if="opt_blog_simple_list_view and not opt_blog_sidebar_show" t-set="containerClass" t-value="'o_container_small'"/>
            <t t-elif="opt_blog_fullwidth or opt_blog_split_grid_view" t-set="containerClass" t-value="'container-fluid'"/>
            <t t-else="" t-set="containerClass" t-value="'container'"/>
            <div t-attf-class="#{containerClass} #{is_split_grid_sticky and 'px-0'}">
                <div t-if="original_search and posts" class="alert alert-warning mt8">
                    No results found for '<span t-out="original_search"/>'. Showing results for '<span t-out="search"/>'.
                </div>
                <div t-attf-class="row #{is_split_grid_sticky and 'gx-0'}">
                    <div id="o_wblog_posts_loop_container" class="col">

                        <t t-if="not blog" t-set="posts_list_show_parent_blog" t-value="True"/>
                        <t t-call="website_blog.posts_loop" posts_list_show_parent_blog="posts_list_show_parent_blog"/>

                        <t t-call="website.pager" classname.f="justify-content-center py-4" extraLinkClass.f="post_link"/>
                    </div>

                    <!-- Only render the sidebar if there's content to display -->
                    <div t-if="opt_blog_sidebar_show" t-attf-class="col-12 col-lg-4 col-xl-3 d-flex ps-lg-4 ps-xl-5 pt-5 pt-lg-0">
                        <t t-call="website_blog.sidebar_blog_index"/>
                    </div>
                </div>
            </div>
        </section>
    </t>
</t>