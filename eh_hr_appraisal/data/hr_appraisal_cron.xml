<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_hr_appraisal_reminders" model="ir.cron">
            <field name="name">Appraisal: Send Reminders</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <record id="ir_cron_hr_appraisal_automation" model="ir.cron">
            <field name="name">Appraisal: Automation Creation and Confirmation</field>
            <field name="model_id" ref="model_hr_appraisal"/>
            <field name="state">code</field>
            <field name="code">model._cron_appraisal_automation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
