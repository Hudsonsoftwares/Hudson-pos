        <field name="model_id" ref="model_hr_appraisal_skill"/>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field>
    </record>

    <record id="hr_appraisal_skill_report_rule_company" model="ir.access">
        <field name="name">Appraisal Skills Report: multi company</field>
        <field name="model_id" ref="model_hr_appraisal_skill_report"/>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">r</field>
    </record>

    <record id="hr_appraisal_template_rule_company" model="ir.access">
        <field name="name">Appraisal Template: multi company</field>
        <field name="model_id" ref="model_hr_appraisal_template"/>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field>
    </record>

    <record id="hr_appraisal_scale_rule_company" model="ir.access">
        <field name="name">Evaluation Scale: multi company</field>
        <field name="model_id" ref="model_hr_appraisal_scale"/>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field>
    </record>
</odoo>
