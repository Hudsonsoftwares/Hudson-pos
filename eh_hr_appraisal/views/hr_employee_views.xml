<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_inherit_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_appraisals" type="object" class="oe_stat_button" icon="fa-star-half-o"
                        groups="eh_hr_appraisal.group_hr_appraisal_user">
                    <field name="appraisal_count" widget="statinfo" string="Appraisals"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='managers']" position="inside">
                <field name="next_appraisal_date"/>
            </xpath>
        </field>
    </record>
</odoo>
