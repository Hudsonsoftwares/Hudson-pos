<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_appraisal_goal_tag_tree" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.tag.tree</field>
        <field name="model">hr.appraisal.goal.tag</field>
        <field name="arch" type="xml">
            <list string="Goal Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_hr_appraisal_goal_tag" model="ir.actions.act_window">
        <field name="name">Goal Tags</field>
        <field name="res_model">hr.appraisal.goal.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
