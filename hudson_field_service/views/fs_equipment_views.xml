<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Settings > Equipment                                          -->
    <!-- ============================================================ -->

    <record id="fs_equipment_view_list" model="ir.ui.view">
        <field name="name">fs.equipment.list</field>
        <field name="model">fs.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="manufacturer_id" optional="show"/>
                <field name="model" optional="show"/>
                <field name="serial_number"/>
                <field name="contract_end_date" optional="show"/>
                <field name="order_count" string="Interventions" optional="show"/>
            </list>
        </field>
    </record>

    <record id="fs_equipment_view_form" model="ir.ui.view">
        <field name="name">fs.equipment.form</field>
        <field name="model">fs.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_interventions" type="object" class="oe_stat_button" icon="build">
                            <field name="order_count" string="Interventions" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Air Conditioner"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="location"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="manufacturer_id"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                        </group>
                    </group>
                    <group string="Maintenance Contract" name="contract">
                        <group>
                            <field name="contract_reference"/>
                            <field name="contract_end_date"/>
                            <field name="under_contract"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Intervention History" name="history">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="date_planned"/>
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="fs_equipment_view_search" model="ir.ui.view">
        <field name="name">fs.equipment.search</field>
        <field name="model">fs.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <filter string="Under Contract" name="under_contract" domain="[('under_contract', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fs_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">fs.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fs_equipment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your customers' equipment</p>
            <p>Track the equipment you service and its intervention history.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Settings > Stock by Vehicle: technicians' vehicle stock       -->
    <!-- ============================================================ -->

    <record id="hr_employee_view_list_fs_vehicle" model="ir.ui.view">
        <field name="name">hr.employee.list.fs.vehicle</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Vehicle Stock" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="fs_vehicle_location_id" options="{'no_quick_create': True}"/>
            </list>
        </field>
    </record>

    <record id="action_fs_vehicle_stock" model="ir.actions.act_window">
        <field name="name">Vehicle Stock</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_employee_view_list_fs_vehicle"/>
        <field name="help" type="html">
            <p>Set the stock location of each technician's vehicle. Parts used on their jobs are taken from it.</p>
        </field>
    </record>

</odoo>
