<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stage Form View -->
    <record id="field_service_stage_form_view" model="ir.ui.view">
        <field name="name">field.service.stage.form</field>
        <field name="model">field.service.stage</field>
        <field name="arch" type="xml">
            <form string="Field Service Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="is_close"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage Tree View -->
    <record id="field_service_stage_tree_view" model="ir.ui.view">
        <field name="name">field.service.stage.tree</field>
        <field name="model">field.service.stage</field>
        <field name="arch" type="xml">
            <list string="Field Service Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_close"/>
            </list>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_field_service_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">field.service.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new stage
            </p>
        </field>
    </record>

</odoo>
