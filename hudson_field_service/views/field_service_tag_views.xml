<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tag Form View -->
    <record id="field_service_tag_form_view" model="ir.ui.view">
        <field name="name">field.service.tag.form</field>
        <field name="model">field.service.tag</field>
        <field name="arch" type="xml">
            <form string="Field Service Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tag Tree View -->
    <record id="field_service_tag_tree_view" model="ir.ui.view">
        <field name="name">field.service.tag.tree</field>
        <field name="model">field.service.tag</field>
        <field name="arch" type="xml">
            <list string="Field Service Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Tag Action -->
    <record id="action_field_service_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">field.service.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tag
            </p>
        </field>
    </record>

</odoo>
