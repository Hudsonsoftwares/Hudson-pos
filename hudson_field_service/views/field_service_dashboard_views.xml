<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- DASHBOARD — Employee Overview with Time Assigned               -->
    <!-- ============================================================ -->

    <!-- Dashboard Tree View grouped by Technician -->
    <record id="field_service_dashboard_tree_view" model="ir.ui.view">
        <field name="name">field.service.order.dashboard.tree</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <list string="Field Service Dashboard"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="partner_id"/>
                <field name="date_planned"/>
                <field name="duration_planned" widget="float_time" string="Planned (h)"/>
                <field name="duration_actual" widget="float_time" string="Actual (h)" sum="Total Time"/>
                <field name="total_products_amount" string="Products ($)" sum="Total Products"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('in_progress', 'scheduled')"
                       decoration-warning="state == 'paused'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="is_timer_running" invisible="1"/>
                <field name="priority" widget="priority"/>
            </list>
        </field>
    </record>

    <!-- Dashboard Kanban View — grouped by Technician -->
    <record id="field_service_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">field.service.order.dashboard.kanban</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_id"
                    class="o_kanban_small_column"
                    quick_create="false"
                    group_create="false"
                    group_edit="false"
                    group_delete="false"
                    sample="1">
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="duration_planned"/>
                <field name="duration_actual"/>
                <field name="date_planned"/>
                <field name="is_timer_running"/>
                <progressbar field="state"
                             colors='{"new": "secondary", "scheduled": "info", "in_progress": "primary", "paused": "warning", "done": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="priority" widget="priority"/>
                            <span t-if="record.is_timer_running.raw_value" class="badge text-bg-success">
                                <i class="fa fa-play"/> Active
                            </span>
                        </div>
                        <strong>
                            <field name="name"/> - <field name="title"/>
                        </strong>
                        <div t-if="record.partner_id.value" class="text-muted">
                            <i class="fa fa-user me-1"/><field name="partner_id"/>
                        </div>
                        <div t-if="record.date_planned.raw_value" class="text-muted">
                            <i class="fa fa-calendar me-1"/><field name="date_planned"/>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="badge text-bg-light">
                                <i class="fa fa-hourglass-start me-1"/><field name="duration_planned" widget="float_time"/>h planned
                            </span>
                            <span class="badge text-bg-primary">
                                <i class="fa fa-clock-o me-1"/><field name="duration_actual" widget="float_time"/>h spent
                            </span>
                        </div>
                        <field name="state" widget="badge" class="mt-1"
                               decoration-success="state == 'done'"
                               decoration-info="state in ('in_progress', 'scheduled')"
                               decoration-warning="state == 'paused'"
                               decoration-danger="state == 'cancelled'"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Search View -->
    <record id="field_service_dashboard_search_view" model="ir.ui.view">
        <field name="name">field.service.order.dashboard.search</field>
        <field name="model">field.service.order</field>
        <field name="arch" type="xml">
            <search string="Dashboard">
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <separator/>
                <filter string="Active (Non-Done)" name="active_orders" domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <filter string="Planned Date" name="date_filter" date="date_planned"/>
                <group>
                    <filter string="Technician" name="group_user" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Planned Date" name="group_date" context="{'group_by': 'date_planned:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- MY CALENDAR — Standard users see only their own orders       -->
    <!-- ============================================================ -->

    <!--
        action_field_service_dashboard: used by the "Dashboard" menu item
        for ALL users (manager and regular). Managers will also see the
        Planning Board via its own separate menu item.
        This action opens calendar view filtered to the current user's orders.
    -->
    <record id="action_field_service_dashboard" model="ir.actions.act_window">
        <field name="name">My Calendar</field>
        <field name="res_model">field.service.order</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="field_service_dashboard_search_view"/>
        <!-- Default: show only MY orders in calendar view -->
        <field name="context">{'search_default_my_orders': 1, 'search_default_active_orders': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active field service orders assigned to you
            </p>
            <p>
                Once you have orders assigned, they will appear here on your calendar.
            </p>
        </field>
    </record>

    <record id="action_field_service_dashboard_calendar" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="hudson_field_service.field_service_order_calendar_view"/>
        <field name="act_window_id" ref="action_field_service_dashboard"/>
    </record>

    <record id="action_field_service_dashboard_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="field_service_dashboard_kanban_view"/>
        <field name="act_window_id" ref="action_field_service_dashboard"/>
    </record>

    <record id="action_field_service_dashboard_tree" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="field_service_dashboard_tree_view"/>
        <field name="act_window_id" ref="action_field_service_dashboard"/>
    </record>

</odoo>
