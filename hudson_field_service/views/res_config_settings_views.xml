<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- Planning settings (Planning > Configuration > Settings)               -->
    <!-- Field service adds its options to the Planning settings page.         -->
    <!-- ===================================================================== -->

    <record id="res_config_settings_view_form_field_service" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.field.service</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hudson_planning.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- ─── Planning ───────────────────────────────────────── -->
            <xpath expr="//setting[@id='planning_shift_changes']" position="after">
                <setting id="fs_project_planning_setting"
                         string="Project Planning"
                         help="Plan resource allocation across projects and estimate deadlines more accurately">
                    <field name="fs_project_planning"/>
                </setting>
            </xpath>

            <xpath expr="//block[@name='planning_setting_container']" position="after">

                <!-- ─── Operations ─────────────────────────────────── -->
                <block title="Operations" name="fs_operations_setting_container">
                    <setting id="fs_planning_enabled_setting"
                             string="Field Service"
                             help="Schedule onsite interventions, invoice time and materials, and complete custom worksheets">
                        <field name="fs_planning_enabled"/>
                        <div class="content-group mt8" invisible="not fs_planning_enabled">
                            <button name="%(hudson_field_service.action_field_service_all_orders)d" type="action"
                                    string="All Jobs" icon="oi-arrow-right" class="btn-link"/>
                            <button name="%(hudson_field_service.action_field_service_stages)d" type="action"
                                    string="Job Stages" icon="oi-arrow-right" class="btn-link"/>
                            <button name="%(hudson_field_service.action_field_service_tags)d" type="action"
                                    string="Job Tags" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="fs_stock_by_vehicle_setting"
                             string="Stock by Vehicle"
                             help="Track inventory stored in technicians' vehicles">
                        <div class="content-group">
                            <div class="mt8">
                                <button name="%(hudson_field_service.action_fs_vehicle_stock)d" type="action"
                                        string="Set up vehicle warehouses" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                            <div class="mt8">
                                <field name="fs_stock_deduction" class="oe_inline"/>
                                <label for="fs_stock_deduction" string="Deduct parts from stock when a job is done" class="o_light_label"/>
                            </div>
                            <div class="row mt8" invisible="not fs_stock_deduction">
                                <label for="fs_default_picking_type_id" class="col-lg-4 o_light_label" string="Operation Type"/>
                                <field name="fs_default_picking_type_id" class="col-lg-8" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="fs_worksheets_setting"
                             string="Worksheets"
                             help="Complete worksheets using custom templates">
                        <field name="fs_worksheets"/>
                        <div class="content-group mt8" invisible="not fs_worksheets">
                            <button name="%(hudson_field_service.action_fs_worksheet_template)d" type="action"
                                    string="Worksheet Templates" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="fs_confirmation_email_setting"
                             string="Confirmation Email"
                             help="Send a confirmation email to the customer when a shift is published">
                        <field name="fs_confirmation_email"/>
                        <div class="content-group" invisible="not fs_confirmation_email">
                            <div class="row mt8">
                                <label for="fs_confirmation_template_id" class="col-lg-4 o_light_label"/>
                                <field name="fs_confirmation_template_id" class="col-lg-8"
                                       placeholder="Field Service: Shift Scheduled"
                                       context="{'default_model': 'field.service.order'}"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="fs_customer_report_setting"
                             string="Customer Report"
                             help="Provide the customer with an intervention report, collect their signature, and email them a copy">
                        <field name="fs_customer_signature"/>
                    </setting>
                    <setting id="fs_maintenance_contracts_setting"
                             string="Maintenance Contracts"
                             help="Track whether customer equipment is covered by a maintenance contract"
                             invisible="not fs_equipment">
                        <field name="fs_maintenance_contracts"/>
                        <div class="text-muted mt8" invisible="not fs_maintenance_contracts">
                            Jobs on equipment covered at the job date are under warranty and are not invoiced.
                        </div>
                    </setting>

                    <setting id="fs_mapbox_setting"
                             string="Mapbox"
                             help="Connect Mapbox to get routes and travel times, calculate distance-based travel fees, and improve automatic shift planning">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="fs_mapbox_token" string="Token" class="col-lg-3 o_light_label"/>
                                <field name="fs_mapbox_token" class="col-lg-9" password="True"/>
                            </div>
                            <div class="mt8">
                                <a href="https://account.mapbox.com/auth/signup/" target="_blank">
                                    <i class="oi oi-arrow-right me-1"/>Sign up for Mapbox to get a free token
                                </a>
                            </div>
                        </div>
                    </setting>
                    <setting id="fs_geolocation_setting"
                             string="Geolocation"
                             help="Track technicians' locations during work hours and record their locations at shift start and completion">
                        <field name="fs_geolocation"/>
                        <div class="content-group" invisible="not fs_geolocation">
                            <div class="row mt8">
                                <label for="fs_location_radius" class="col-lg-6 o_light_label"/>
                                <field name="fs_location_radius" class="col-lg-6"/>
                            </div>
                            <div class="mt8">
                                <field name="fs_radius_validation" class="oe_inline"/>
                                <label for="fs_radius_validation" string="Only start jobs within this radius of the customer" class="o_light_label"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="fs_equipment_setting"
                             string="Equipment"
                             help="Track customer equipment and intervention history">
                        <field name="fs_equipment"/>
                        <div class="content-group mt8" invisible="not fs_equipment">
                            <button name="%(hudson_field_service.action_fs_equipment)d" type="action"
                                    string="Equipment" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>

                <!-- ─── Sales & Billing ────────────────────────────── -->
                <block title="Sales &amp; Billing" name="fs_sales_setting_container">
                    <setting id="fs_billing_setting"
                             string="Billing"
                             help="Invoice your time and materials to your customers">
                        <field name="fs_billing"/>
                        <div class="content-group" invisible="not fs_billing">
                            <div class="row mt8">
                                <label for="field_service_default_hourly_rate" class="col-lg-6 o_light_label"/>
                                <field name="field_service_default_hourly_rate" class="col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="fs_website_form_setting"
                             string="Website Form"
                             help="Collect intervention requests via an online form">
                        <field name="fs_website_form"/>
                        <div class="content-group mt8" invisible="not fs_website_form">
                            <field name="fs_website_form_url" widget="url" readonly="1"/>
                        </div>
                    </setting>

                    <setting id="fs_products_setting"
                             string="Products"
                             help="Track the materials used during interventions and bill them to the customer">
                        <field name="fs_products"/>
                        <div class="content-group" invisible="not fs_products">
                            <div class="mt8">
                                <field name="fs_hide_prices" class="oe_inline"/>
                                <label for="fs_hide_prices" string="Hide prices on customer report" class="o_light_label"/>
                            </div>
                            <div class="mt8" invisible="not fs_billing">
                                <field name="fs_auto_sale_order" class="oe_inline"/>
                                <label for="fs_auto_sale_order" string="Bill products through a sales order" class="o_light_label"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="fs_travel_fees_setting"
                             string="Travel Fees"
                             help="Invoice the travel time to the customer's location"
                             invisible="not fs_billing">
                        <field name="fs_travel_fees"/>
                        <div class="content-group" invisible="not fs_travel_fees">
                            <div class="row mt8">
                                <label for="fs_travel_product_id" class="col-lg-4 o_light_label"/>
                                <field name="fs_travel_product_id" class="col-lg-8" placeholder="Travel Fees"/>
                            </div>
                            <div class="text-muted mt8">
                                Round-trip time from your company address to the customer, using Mapbox when a token is set.
                            </div>
                        </div>
                    </setting>
                </block>

                <!-- ─── Analytics ─────────────────────────────────── -->
                <block title="Analytics" name="fs_analytics_setting_container">
                    <setting id="fs_customer_ratings_setting"
                             string="Customer Ratings"
                             help="Track customer satisfaction for interventions">
                        <field name="fs_customer_ratings"/>
                        <div class="content-group" invisible="not fs_customer_ratings">
                            <div class="row mt8">
                                <label for="fs_rating_survey_id" class="col-lg-4 o_light_label" string="Survey"/>
                                <field name="fs_rating_survey_id" class="col-lg-8" options="{'no_create': True}"
                                       placeholder="Field Service — Customer Satisfaction"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Kept for existing links: opens the Planning settings -->
    <record id="action_field_service_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'hudson_planning', 'bin_size': False}</field>
    </record>

</odoo>
