<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="field_service_stage_new" model="field.service.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
            <field name="fold">False</field>
            <field name="is_close">False</field>
            <field name="color">0</field>
        </record>

        <record id="field_service_stage_scheduled" model="field.service.stage">
            <field name="name">Scheduled</field>
            <field name="sequence">20</field>
            <field name="fold">False</field>
            <field name="is_close">False</field>
            <field name="color">4</field>
        </record>

        <record id="field_service_stage_in_progress" model="field.service.stage">
            <field name="name">In Progress</field>
            <field name="sequence">30</field>
            <field name="fold">False</field>
            <field name="is_close">False</field>
            <field name="color">2</field>
        </record>

        <record id="field_service_stage_done" model="field.service.stage">
            <field name="name">Done</field>
            <field name="sequence">40</field>
            <field name="fold">False</field>
            <field name="is_close">True</field>
            <field name="color">10</field>
        </record>

        <record id="field_service_stage_cancelled" model="field.service.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">50</field>
            <field name="fold">True</field>
            <field name="is_close">True</field>
            <field name="color">1</field>
        </record>

    </data>
</odoo>
