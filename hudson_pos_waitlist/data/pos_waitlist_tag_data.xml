<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Optional guest tags on the Join Waitlist form. Add more in Point of Sale > Configuration > Waitlist Tags. -->
    <record id="waitlist_tag_high_chair" model="pos.waitlist.tag">
        <field name="name">High Chair</field>
        <field name="code">high_chair</field>
        <field name="sequence">10</field>
    </record>
    <record id="waitlist_tag_wheelchair" model="pos.waitlist.tag">
        <field name="name">Wheelchair</field>
        <field name="code">wheelchair</field>
        <field name="sequence">20</field>
    </record>
    <record id="waitlist_tag_birthday" model="pos.waitlist.tag">
        <field name="name">Birthday</field>
        <field name="code">birthday</field>
        <field name="sequence">30</field>
    </record>
</odoo>
