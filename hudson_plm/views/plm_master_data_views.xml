<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Data: the products, BoMs and work centers ECOs are made on,
         reachable without leaving the PLM app -->
    <record id="plm_product_template_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="mrp.mrp_product_template_search_view"/>
        <field name="context">{'search_default_goods': 1, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product found. Let's create one!
            </p><p>
                Define the products whose versions you manage through Engineering Change Orders.
            </p>
        </field>
    </record>

    <record id="plm_bom_action" model="ir.actions.act_window">
        <field name="name">Bills of Materials</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mrp.view_mrp_bom_filter"/>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bill of materials found. Let's create one!
            </p><p>
                Bills of materials are revised through Engineering Change Orders;
                archived BoMs are the previous versions.
            </p>
        </field>
    </record>

    <record id="plm_workcenter_action" model="ir.actions.act_window">
        <field name="name">Work Centers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mrp.mrp_workcenter_tree_view')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mrp.mrp_workcenter_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mrp.mrp_workcenter_view')})]"/>
        <field name="search_view_id" ref="mrp.view_mrp_workcenter_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new work center
            </p><p>
                Work centers are used by the operations of your bills of materials.
            </p>
        </field>
    </record>

    <menuitem id="menu_plm_products"
              name="Products"
              parent="menu_plm_master_data"
              action="plm_product_template_action"
              sequence="10"/>

    <menuitem id="menu_plm_boms"
              name="Bill of Materials"
              parent="menu_plm_master_data"
              action="plm_bom_action"
              sequence="20"/>

    <menuitem id="menu_plm_workcenters"
              name="Work Centers"
              parent="menu_plm_master_data"
              action="plm_workcenter_action"
              sequence="30"/>

    <!-- ECO smart button on products -->
    <record id="product_template_form_view_inherit_plm" model="ir.ui.view">
        <field name="name">product.template.form.inherit.plm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_ecos" type="object" icon="settings"
                        groups="hudson_plm.group_plm_user" invisible="eco_count == 0">
                    <field name="eco_count" widget="statinfo" string="ECOs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
