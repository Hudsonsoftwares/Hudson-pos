<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_eco_tag_view_form" model="ir.ui.view">
        <field name="name">mrp.eco.tag.view.form</field>
        <field name="model">mrp.eco.tag</field>
        <field name="arch" type="xml">
            <form string="ECO Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_eco_tag_view_tree" model="ir.ui.view">
        <field name="name">mrp.eco.tag.view.tree</field>
        <field name="model">mrp.eco.tag</field>
        <field name="arch" type="xml">
            <list string="ECO Tags">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="mrp_eco_tag_action" model="ir.actions.act_window">
        <field name="name">ECO Tags</field>
        <field name="res_model">mrp.eco.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_eco_tags_action"
              name="ECO Tags"
              parent="menu_mrp_eco_tags"
              action="mrp_eco_tag_action"
              sequence="10"/>
</odoo>
