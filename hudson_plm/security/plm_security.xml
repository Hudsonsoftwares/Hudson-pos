<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_plm">
            <field name="name">Product Lifecycle Management</field>
            <field name="sequence">55</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_plm">
            <field name="name">PLM</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_plm"/>
        </record>

        <record id="group_plm_user" model="res.groups">
            <field name="name">PLM User</field>
            <field name="privilege_id" ref="res_groups_privilege_plm"/>
            <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>
        
        <record id="group_plm_manager" model="res.groups">
            <field name="name">PLM Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_plm"/>
            <field name="implied_ids" eval="[(4, ref('hudson_plm.group_plm_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
