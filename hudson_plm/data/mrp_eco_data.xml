<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence -->
        <record id="seq_mrp_eco" model="ir.sequence">
            <field name="name">Engineering Change Order</field>
            <field name="code">mrp.eco</field>
            <field name="prefix">ECO</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- To-do assigned to approvers when an ECO enters a stage they must approve -->
        <record id="mail_activity_eco_approval" model="mail.activity.type">
            <field name="name">ECO Approval</field>
            <field name="icon">fact_check</field>
            <field name="res_model">mrp.eco</field>
            <field name="delay_count">2</field>
        </record>

        <!-- Default Type -->
        <record id="eco_type_bom_update" model="mrp.eco.type">
            <field name="name">BOM Updates</field>
            <field name="sequence">1</field>
        </record>

        <!-- Default Stages -->
        <record id="eco_stage_new" model="mrp.eco.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
            <field name="type_ids" eval="[(4, ref('eco_type_bom_update'))]"/>
        </record>
        
        <record id="eco_stage_in_progress" model="mrp.eco.stage">
            <field name="name">In Progress</field>
            <field name="sequence">20</field>
            <field name="type_ids" eval="[(4, ref('eco_type_bom_update'))]"/>
        </record>

        <record id="eco_stage_validated" model="mrp.eco.stage">
            <field name="name">Validated</field>
            <field name="sequence">30</field>
            <field name="type_ids" eval="[(4, ref('eco_type_bom_update'))]"/>
        </record>
        
        <record id="eco_stage_effective" model="mrp.eco.stage">
            <field name="name">Effective</field>
            <field name="sequence">40</field>
            <field name="allow_apply_change">True</field>
            <field name="final_stage">True</field>
            <field name="type_ids" eval="[(4, ref('eco_type_bom_update'))]"/>
        </record>
    </data>
</odoo>
