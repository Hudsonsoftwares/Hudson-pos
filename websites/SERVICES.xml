<t t-name="website.services">
    <t t-set="head">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
        <style>
#wrap.rc-page { --ink: #15110e; --esp: #1f1813; --bean: #2b211a; --cream: #f6efe4; --paper: #fbf7f0; --gold: #c9a15d; --gold2: #e0c38c; --muted: #a99a86; --text: #3d332a;
  font-family: 'Inter', system-ui, sans-serif; background: var(--paper); color: var(--text); overflow-x: hidden; }
#wrap.rc-page h1, #wrap.rc-page h2, #wrap.rc-page h3, #wrap.rc-page h4 { font-family: 'Playfair Display', Georgia, serif; color: var(--ink); }
#wrap.rc-page a { text-decoration: none; }
.rc-page .rc-eyebrow { display: inline-flex; align-items: center; gap: .75rem; font-size: .78rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: var(--gold); }
.rc-page .rc-eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
.rc-page .rc-title { font-size: clamp(2rem, 3.8vw, 3.1rem); line-height: 1.15; margin: 16px 0 18px; }
.rc-page .rc-title em { color: #9a7a43; }
.rc-page .rc-lead { color: #6f6253; font-size: 1.06rem; line-height: 1.8; max-width: 620px; }
.rc-page .rc-btn { display: inline-flex; align-items: center; gap: .55rem; padding: 14px 28px; border-radius: 999px; font-weight: 600; font-size: .95rem; border: 1px solid transparent; transition: all .3s ease; }
.rc-page .rc-btn-gold { background: var(--gold); color: var(--ink) !important; box-shadow: 0 12px 30px -12px rgba(201,161,93,.7); }
.rc-page .rc-btn-gold:hover { background: var(--gold2); transform: translateY(-2px); }
.rc-page .rc-btn-ghost { border-color: rgba(246,239,228,.45); color: var(--cream) !important; }
.rc-page .rc-btn-ghost:hover { background: var(--cream); color: var(--ink) !important; }
.rc-page .rc-hero { position: relative; padding: 170px 0 120px; color: var(--cream); background-size: cover; background-position: center; }
.rc-page .rc-hero h1 { font-size: clamp(2.6rem, 5.6vw, 4.6rem); line-height: 1.05; color: #fff; margin: 22px 0; max-width: 800px; }
.rc-page .rc-hero h1 em { color: var(--gold); }
.rc-page .rc-hero p { color: #d9cfbf; font-size: 1.12rem; line-height: 1.8; max-width: 600px; }
.rc-page .rc-section { padding: 110px 0; }
.rc-page .rc-dark { background: var(--ink); color: var(--cream); }
.rc-page .rc-dark h2, .rc-page .rc-dark h3, .rc-page .rc-dark h4 { color: #fff; }
.rc-page .rc-dark .rc-title em { color: var(--gold); }
.rc-page .rc-dark .rc-lead { color: var(--muted); }
/* steps */
.rc-page .rc-step { position: relative; padding: 34px 28px; border-radius: 16px; background: var(--esp); border: 1px solid rgba(201,161,93,.18); height: 100%; }
.rc-page .rc-step .rc-num { font-family: 'Playfair Display', serif; font-size: 3rem; line-height: 1; color: var(--gold); opacity: .9; }
.rc-page .rc-step h4 { margin: 14px 0 8px; font-size: 1.3rem; }
.rc-page .rc-step p { color: var(--muted); margin: 0; font-size: .95rem; line-height: 1.7; }
/* header: dark glass like the homepage */
header#top { background: rgba(21,17,14,.92) !important; backdrop-filter: blur(12px); border-bottom: 1px solid rgba(201,161,93,.22); }
header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
header#top .navbar .nav-link, header#top .navbar a:not(.dropdown-item):not(.btn-primary), header#top .navbar button:not(.btn-primary):not(.dropdown-item),
header#top .navbar .navbar-brand, header#top .navbar .fa, header#top .navbar .oi { color: #f6efe4 !important; }
header#top .navbar .nav-link:hover, header#top .navbar .nav-link.active { color: #c9a15d !important; }
header#top .o_navlink_background { background: rgba(246,239,228,.12) !important; border-color: rgba(246,239,228,.18) !important; }
header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
header#top .offcanvas { background: #1f1813 !important; }
header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item) { color: #f6efe4 !important; }
header#top .offcanvas .btn-close { filter: invert(1); }
header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; }
@media (max-width: 991px) { .rc-page .rc-hero { padding: 140px 0 90px; } .rc-page .rc-section { padding: 80px 0; } }

.rc-page .rc-svc { background: #fff; border: 1px solid #efe5d5; border-radius: 18px; overflow: hidden; height: 100%; display: flex; flex-direction: column; transition: all .35s ease; }
.rc-page .rc-svc:hover { transform: translateY(-6px); box-shadow: 0 34px 60px -34px rgba(43,33,26,.55); }
.rc-page .rc-svc-img { position: relative; aspect-ratio: 16/11; overflow: hidden; }
.rc-page .rc-svc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
.rc-page .rc-svc:hover .rc-svc-img img { transform: scale(1.07); }
.rc-page .rc-svc-tag { position: absolute; left: 16px; top: 16px; background: var(--ink); color: var(--gold); font-size: .72rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; }
.rc-page .rc-svc-body { padding: 26px 26px 28px; display: flex; flex-direction: column; flex: 1; }
.rc-page .rc-svc-body h3 { font-size: 1.45rem; margin-bottom: 10px; }
.rc-page .rc-svc-body p { color: #6f6253; line-height: 1.75; font-size: .97rem; }
.rc-page .rc-svc-body ul { list-style: none; padding: 0; margin: 0 0 22px; }
.rc-page .rc-svc-body li { padding: 5px 0 5px 26px; position: relative; color: var(--text); font-size: .93rem; }
.rc-page .rc-svc-body li::before { content: "\2713"; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
.rc-page .rc-svc-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px dashed #e7dac4; padding-top: 18px; }
.rc-page .rc-svc-foot small { color: var(--muted); display: block; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
.rc-page .rc-svc-foot b { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--ink); }
.rc-page .rc-svc-foot .rc-btn { padding: 11px 20px; font-size: .88rem; }
.rc-page .rc-cta { border-radius: 24px; padding: 70px 56px; color: var(--cream);
  background: linear-gradient(110deg, rgba(21,17,14,.96) 35%, rgba(21,17,14,.55)), url('/theme_bistro/static/src/img/configurator/set_1_landscape_md_2.webp') center/cover; }
.rc-page .rc-cta h2 { color: #fff; font-size: clamp(2rem, 3.6vw, 3rem); }
.rc-page .rc-cta h2 em { color: var(--gold); }
.rc-page .rc-cta p { color: #d9cfbf; max-width: 560px; line-height: 1.8; }
.rc-page .rc-stats { display: flex; flex-wrap: wrap; gap: 44px; margin-top: 36px; }
.rc-page .rc-stats strong { display: block; font-family: 'Playfair Display', serif; font-size: 2.3rem; color: var(--gold); line-height: 1; }
.rc-page .rc-stats span { font-size: .85rem; color: #cbbfae; }
        </style>
    </t>
    <t t-call="website.layout" head="head">
        <div id="wrap" class="oe_structure oe_empty rc-page">

            <section class="rc-hero o_colored_level" data-name="Services Hero" style="background-image: linear-gradient(100deg, rgba(21,17,14,.95) 0%, rgba(21,17,14,.78) 55%, rgba(21,17,14,.4) 100%), url('/theme_bistro/static/src/img/configurator/ultrawide_lg_2.webp');">
                <div class="container">
                    <span class="rc-eyebrow">Our Services</span>
                    <h1>Every celebration, <em>catered with heart</em></h1>
                    <p>From office lunches to wedding feasts, candlelight dinners to custom cakes: our chefs, bakers and event team plan, cook and serve it all, so you can enjoy your day.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="/plan-my-event" class="rc-btn rc-btn-gold"><i class="fa fa-calendar-check-o"/> Plan My Event</a>
                        <a href="#rc-services" class="rc-btn rc-btn-ghost">Explore services <i class="fa fa-arrow-down"/></a>
                    </div>
                    <div class="rc-stats">
                        <div><strong>1,200+</strong><span>events catered</span></div>
                        <div><strong>20 – 2,000</strong><span>guests per event</span></div>
                        <div><strong>4.9★</strong><span>client rating</span></div>
                    </div>
                </div>
            </section>

            <section id="rc-services" class="rc-section o_colored_level" data-name="Services">
