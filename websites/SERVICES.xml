                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="rc-svc">
                            <div class="rc-svc-img"><img src="/theme_bistro/static/src/img/configurator/landscape_xl_2.webp" alt="Wedding Catering" loading="lazy"/><span class="rc-svc-tag">Signature</span></div>
