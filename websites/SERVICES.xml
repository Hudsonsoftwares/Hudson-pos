<t name="Services" t-name="website.services">
    <t t-set="head">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <!-- Playfair Display (headings) + Plus Jakarta Sans (body), same as the home page -->
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        <!-- Odoo 20 no longer ships Font Awesome: load it so the fa-* icons on this page show -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
        <style>
            /* =====================================================================
               AYSHU'S CULINARY - Services, Catering &amp; Celebrations, Kanjirappally
               Same palette, type and components as the home page
               ===================================================================== */
            #wrap.ay-services {
                --ay-teak: #18120e; --ay-teak-deep: #100b08; --ay-teak-card: #231914;
                --ay-line: rgba(216,168,78,.22);
                --ay-gold: #d8a84e; --ay-gold-light: #f5cf7b;
                --ay-gold-grad: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%);
                --ay-green: #1f3d2b; --ay-green-light: #2b563c;
                --ay-cream: #fcf9f4; --ay-sand: #f4eee3; --ay-sand-line: #e3d7c5;
                --ay-ink: #1c140f; --ay-muted: #8a7c72; --ay-body: #5c4e45;
                --ay-serif: 'Playfair Display', Georgia, serif;
                --ay-sans: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
                --ay-radius: 10px; --ay-ease: cubic-bezier(.22,1,.36,1);
                font-family: var(--ay-sans); font-size: 1rem; color: var(--ay-ink); background: var(--ay-cream);
                line-height: 1.65; overflow-x: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
            }
            #wrap.ay-services h1, #wrap.ay-services h2, #wrap.ay-services h3, #wrap.ay-services h4 {
                font-family: var(--ay-serif); font-weight: 700; letter-spacing: -.01em;
            }
            #wrap.ay-services a { text-decoration: none; }
            #wrap.ay-services a:focus-visible { outline: 2px solid var(--ay-gold); outline-offset: 4px; border-radius: 6px; }
            .ay-services ::selection { background: var(--ay-gold); color: var(--ay-teak); }

            /* ---------- eyebrow, titles ---------- */
            .ay-services .ay-eyebrow {
                display: inline-flex; align-items: center; gap: 12px;
                font-size: .74rem; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--ay-gold);
            }
            .ay-services .ay-eyebrow::before { content: ""; width: 32px; height: 1px; background: currentColor; opacity: .8; }
            .ay-services .text-center .ay-eyebrow::after { content: ""; width: 32px; height: 1px; background: currentColor; opacity: .8; }
            .ay-services .ay-section { padding: 120px 0; position: relative; }
            .ay-services .ay-title { font-size: clamp(2.3rem, 4.4vw, 3.7rem); line-height: 1.12; color: var(--ay-teak); margin: 16px 0 20px; }
            .ay-services .ay-title em { color: var(--ay-gold); font-style: italic; font-weight: 600; }
            .ay-services .ay-lead { font-size: 1.06rem; color: var(--ay-body); max-width: 620px; line-height: 1.85; }
            .ay-services .ay-dark { background: var(--ay-teak); color: #fff; }
            .ay-services .ay-dark .ay-title { color: #fff; }
            .ay-services .ay-dark .ay-title em { color: var(--ay-gold-light); }
            .ay-services .ay-dark .ay-lead { color: #b8aca3; }
            .ay-services .ay-light .ay-eyebrow { color: var(--ay-green); }

            /* ---------- buttons ---------- */
            .ay-services .ay-btn {
                display: inline-flex; align-items: center; gap: 10px; padding: 15px 32px; border-radius: 999px;
                font-size: .78rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; border: 1px solid transparent;
                transition: transform .3s var(--ay-ease), box-shadow .3s var(--ay-ease), background .3s ease, color .3s ease, border-color .3s ease;
            }
            .ay-services .ay-btn .fa { font-size: .95rem; letter-spacing: 0; }
            .ay-services .ay-btn-gold { background: var(--ay-gold-grad); color: var(--ay-teak) !important; box-shadow: 0 10px 30px rgba(216,168,78,.38); }
            .ay-services .ay-btn-gold:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(216,168,78,.58); }
            .ay-services .ay-btn-ghost { border-color: rgba(255,255,255,.35); color: #fff !important; background: rgba(255,255,255,.06); backdrop-filter: blur(8px); }
            .ay-services .ay-btn-ghost:hover { border-color: var(--ay-gold); color: var(--ay-gold-light) !important; background: rgba(216,168,78,.1); transform: translateY(-3px); }
            .ay-services .ay-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 38px; }

            /* ---------- hero ---------- */
            .ay-services .ay-svc-hero {
                position: relative; color: #fff; overflow: hidden;
                background: url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&amp;w=2000&amp;auto=format&amp;fit=crop') center/cover no-repeat;
            }
            .ay-services .ay-svc-hero::before {
                content: ""; position: absolute; inset: 0;
                background:
                    radial-gradient(ellipse at 25% 45%, rgba(216,168,78,.16), transparent 60%),
                    linear-gradient(100deg, rgba(16,11,8,.95) 0%, rgba(24,18,14,.84) 48%, rgba(24,18,14,.45) 100%),
                    linear-gradient(180deg, transparent 65%, rgba(16,11,8,.92) 100%);
            }
            .ay-services .ay-svc-hero > .container { position: relative; z-index: 2; padding-top: 140px; padding-bottom: 90px; }
            .ay-services .ay-brand { display: flex; align-items: center; gap: 16px; margin-bottom: 26px; }
            .ay-services .ay-brand-crest { width: 56px; height: 56px; color: var(--ay-gold); flex-shrink: 0; filter: drop-shadow(0 4px 14px rgba(216,168,78,.35)); }
            .ay-services .ay-brand-name {
                font-family: var(--ay-serif); font-weight: 800; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1; letter-spacing: .02em;
                background: var(--ay-gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
            }
            .ay-services .ay-brand-sub { margin-top: 8px; font-size: .72rem; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; color: #e9e1d9; }
            .ay-services .ay-svc-hero h1 {
                font-size: clamp(2.6rem, 5.8vw, 5rem); line-height: 1.06; color: #fff; margin: 22px 0; max-width: 860px;
                text-shadow: 0 4px 24px rgba(0,0,0,.45);
            }
            .ay-services .ay-svc-hero h1 em { color: var(--ay-gold-light); font-style: italic; font-weight: 600; }
            .ay-services .ay-svc-hero p { color: #ded6cf; font-size: clamp(1.02rem, 1.7vw, 1.15rem); line-height: 1.85; max-width: 640px; }
            .ay-services .ay-hero-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
            .ay-services .ay-chip {
                display: inline-flex; align-items: center; gap: 8px; padding: 7px 15px; border-radius: 999px;
                border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.05);
                font-size: .76rem; font-weight: 600; color: #e9e1d9;
            }
            .ay-services .ay-chip .fa { color: var(--ay-gold); }
            .ay-services .ay-infobar {
                position: relative; z-index: 3;
                background: rgba(16,11,8,.88); backdrop-filter: blur(14px); border-top: 1px solid var(--ay-line);
            }
            .ay-services .ay-info { display: flex; align-items: center; gap: 14px; padding: 22px 10px; }
            .ay-services .ay-info i {
                width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
                background: rgba(216,168,78,.12); border: 1px solid var(--ay-line); color: var(--ay-gold); font-size: 1.1rem;
            }
            .ay-services .ay-info small { display: block; font-size: .66rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ay-muted); }
            .ay-services .ay-info b { color: #fff; font-size: .94rem; font-weight: 700; }
            .ay-services .ay-info a { color: #fff; }

            /* ---------- marquee ---------- */
            .ay-services .ay-marquee { background: var(--ay-gold-grad); color: var(--ay-teak); overflow: hidden; padding: 18px 0; }
            .ay-services .ay-marquee-track { display: flex; width: max-content; animation: ay-marquee 38s linear infinite; }
            .ay-services .ay-marquee:hover .ay-marquee-track { animation-play-state: paused; }
            .ay-services .ay-marquee span { font-family: var(--ay-serif); font-size: 1.6rem; font-weight: 700; font-style: italic; padding: 0 26px; white-space: nowrap; }
            .ay-services .ay-marquee span::after { content: "\2726"; font-family: var(--ay-sans); font-style: normal; font-size: .8rem; margin-left: 52px; vertical-align: middle; }

            /* ---------- service cards ---------- */
            .ay-services .ay-svc-list { background: var(--ay-sand); }
            .ay-services .ay-svc {
                background: #fff; border: 1px solid var(--ay-sand-line); border-radius: var(--ay-radius); overflow: hidden;
                height: 100%; display: flex; flex-direction: column; position: relative;
                transition: transform .4s var(--ay-ease), box-shadow .4s var(--ay-ease), border-color .4s ease;
            }
            .ay-services .ay-svc::before { content: ""; position: absolute; left: 0; top: 0; z-index: 2; height: 3px; width: 0; background: var(--ay-gold-grad); transition: width .5s var(--ay-ease); }
            .ay-services .ay-svc:hover { transform: translateY(-8px); border-color: #e2cfaa; box-shadow: 0 30px 60px -30px rgba(24,18,14,.45); }
            .ay-services .ay-svc:hover::before { width: 100%; }
            .ay-services .ay-svc-thumb { height: 230px; position: relative; overflow: hidden; }
            .ay-services .ay-svc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ay-ease); }
            .ay-services .ay-svc:hover .ay-svc-thumb img { transform: scale(1.08); }
            .ay-services .ay-svc-tag {
                position: absolute; top: 14px; left: 14px; padding: 5px 13px; border-radius: 999px;
                background: rgba(24,18,14,.85); backdrop-filter: blur(6px); border: 1px solid var(--ay-line);
                color: var(--ay-gold-light); font-size: .64rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
            }
            .ay-services .ay-svc-icon {
                position: absolute; right: 22px; bottom: -28px; z-index: 2; width: 56px; height: 56px; border-radius: 50%;
                background: var(--ay-teak); color: var(--ay-gold-light); display: flex; align-items: center; justify-content: center;
                font-size: 1.25rem; box-shadow: 0 0 0 6px #fff; transition: transform .4s var(--ay-ease);
            }
            .ay-services .ay-svc:hover .ay-svc-icon { transform: rotate(-8deg) scale(1.06); }
            .ay-services .ay-svc-body { padding: 30px 26px 26px; display: flex; flex-direction: column; flex: 1; }
            .ay-services .ay-svc-body h3 { font-size: 1.45rem; color: var(--ay-teak); margin-bottom: 10px; }
            .ay-services .ay-svc-body p { color: var(--ay-body); font-size: .92rem; line-height: 1.75; }
            .ay-services .ay-svc-body ul { list-style: none; padding: 0; margin: 0 0 22px; }
            .ay-services .ay-svc-body li { padding: 7px 0; border-top: 1px dashed var(--ay-sand-line); color: var(--ay-ink); font-size: .9rem; display: flex; gap: 10px; align-items: center; }
            .ay-services .ay-svc-body li .fa { color: var(--ay-gold); width: 16px; }
            .ay-services .ay-svc-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 18px; border-top: 1px solid var(--ay-sand-line); }
            .ay-services .ay-svc-foot small { display: block; font-size: .64rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--ay-muted); }
            .ay-services .ay-svc-foot b { font-family: var(--ay-serif); font-size: 1.3rem; color: var(--ay-teak); white-space: nowrap; }
            .ay-services .ay-svc-link {
                display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px; white-space: nowrap;
                background: var(--ay-teak); color: var(--ay-gold-light) !important; border: 1px solid var(--ay-teak);
                font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; transition: all .3s ease;
            }
            .ay-services .ay-svc-link:hover { background: var(--ay-gold-grad); color: var(--ay-teak) !important; border-color: transparent; }

            /* ---------- why ayshu's ---------- */
            .ay-services .ay-why { background: var(--ay-cream); }
            .ay-services .ay-feature { display: flex; gap: 18px; align-items: flex-start; padding: 26px 0; border-bottom: 1px dashed var(--ay-sand-line); }
            .ay-services .ay-feature:last-child { border-bottom: 0; }
            .ay-services .ay-feature i {
                width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
                background: var(--ay-teak); color: var(--ay-gold-light); font-size: 1.15rem; box-shadow: 0 0 0 6px var(--ay-sand);
            }
            .ay-services .ay-feature h4 { font-size: 1.25rem; color: var(--ay-teak); margin: 2px 0 6px; }
            .ay-services .ay-feature p { color: var(--ay-body); font-size: .92rem; line-height: 1.7; margin: 0; }
            .ay-services .ay-collage { position: relative; min-height: 540px; }
            .ay-services .ay-collage img { position: absolute; object-fit: cover; border-radius: var(--ay-radius); }
            .ay-services .ay-collage .ay-img-a { width: 76%; height: 80%; left: 0; top: 0; box-shadow: 0 24px 60px rgba(24,18,14,.2); }
            .ay-services .ay-collage .ay-img-b { width: 54%; height: 52%; right: 0; bottom: 0; border: 8px solid var(--ay-cream); box-shadow: 0 20px 50px rgba(24,18,14,.25); }
            .ay-services .ay-collage::before {
                content: ""; position: absolute; left: -18px; top: -18px; width: 76%; height: 80%;
                border: 1px solid var(--ay-gold); border-radius: var(--ay-radius); opacity: .45;
            }
            .ay-services .ay-stamp {
                position: absolute; right: 26px; top: 34px; z-index: 2; width: 124px; height: 124px; border-radius: 50%;
                background: var(--ay-teak); color: var(--ay-gold); border: 1px solid var(--ay-gold);
                display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
                box-shadow: 0 12px 30px rgba(0,0,0,.35);
            }
            .ay-services .ay-stamp strong { font-family: var(--ay-serif); font-size: 2.3rem; line-height: 1; color: #fff; }
            .ay-services .ay-stamp span { font-size: .6rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; margin-top: 4px; }

            /* ---------- how it works ---------- */
            .ay-services .ay-how { background: radial-gradient(circle at 85% 10%, rgba(216,168,78,.12), transparent 45%), var(--ay-green); color: #fff; }
            .ay-services .ay-how .ay-title { color: #fff; }
            .ay-services .ay-how .ay-title em { color: var(--ay-gold-light); }
            .ay-services .ay-how .ay-lead { color: #c9d6cc; }
            .ay-services .ay-step {
                background: rgba(16,11,8,.28); border: 1px solid rgba(245,207,123,.22); border-radius: var(--ay-radius);
                padding: 36px 30px; height: 100%; position: relative; transition: transform .35s var(--ay-ease), background .35s ease;
            }
            .ay-services .ay-step:hover { transform: translateY(-6px); background: rgba(16,11,8,.4); }
            .ay-services .ay-step-num { position: absolute; right: 24px; top: 16px; font-family: var(--ay-serif); font-size: 3.6rem; font-weight: 800; color: rgba(245,207,123,.12); line-height: 1; }
            .ay-services .ay-step-icon {
                width: 52px; height: 52px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
                background: var(--ay-gold-grad); color: var(--ay-teak); font-size: 1.15rem;
            }
            .ay-services .ay-step h4 { color: #fff; font-size: 1.4rem; margin: 20px 0 8px; }
            .ay-services .ay-step p { color: #c9d6cc; font-size: .92rem; line-height: 1.7; margin: 0; }

            /* ---------- closing / cta band ---------- */
            .ay-services .ay-closing { background: var(--ay-teak-deep); color: #fff; padding: 110px 0 120px; position: relative; overflow: hidden; text-align: center; border-top: 1px solid var(--ay-line); }
            .ay-services .ay-closing .container { position: relative; z-index: 2; }
            .ay-services .ay-crest { width: 54px; height: 54px; color: var(--ay-gold); }
            .ay-services .ay-closing h2 { font-style: italic; font-weight: 600; font-size: clamp(1.9rem, 3.6vw, 3rem); color: #fff; margin: 22px auto 14px; max-width: 820px; line-height: 1.3; }
            .ay-services .ay-closing h2 em { color: var(--ay-gold-light); }
            .ay-services .ay-closing p { color: #a69a91; max-width: 560px; margin: 0 auto; }
            .ay-services .ay-closing .ay-actions { justify-content: center; }
            .ay-services .ay-watermark {
                position: absolute; bottom: -24px; left: 50%; transform: translateX(-50%); z-index: 1;
                font-family: var(--ay-serif); font-size: clamp(4.5rem, 12vw, 12rem); font-weight: 800; white-space: nowrap;
                color: transparent; -webkit-text-stroke: 1.5px rgba(216,168,78,.1); pointer-events: none; user-select: none;
            }

            /* ---------- motion ---------- */
            @keyframes ay-fade-up { from { opacity: 0; transform: translateY(34px); } to { opacity: 1; transform: none; } }
            @keyframes ay-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
            .ay-services .ay-reveal { animation: ay-fade-up 1.1s var(--ay-ease) both; }
            .ay-services .ay-d1 { animation-delay: .15s; } .ay-services .ay-d2 { animation-delay: .3s; } .ay-services .ay-d3 { animation-delay: .45s; } .ay-services .ay-d4 { animation-delay: .6s; }
            @media (prefers-reduced-motion: reduce) {
                .ay-services *, .ay-services *::before, .ay-services *::after { animation: none !important; transition: none !important; }
            }

            /* ---------- responsive ---------- */
            @media (max-width: 991px) {
                .ay-services .ay-section { padding: 88px 0; }
                .ay-services .ay-svc-hero > .container { padding-top: 110px; padding-bottom: 70px; }
                .ay-services .ay-collage { min-height: 440px; margin-bottom: 40px; }
                .ay-services .ay-collage::before { display: none; }
            }
            @media (max-width: 575px) {
                .ay-services .ay-section { padding: 72px 0; }
                .ay-services .ay-actions .ay-btn { width: 100%; justify-content: center; }
                .ay-services .ay-hero-chips { display: none; }
                .ay-services .ay-brand-crest { width: 46px; height: 46px; }
                .ay-services .ay-brand-sub { letter-spacing: .16em; }
                .ay-services .ay-info { padding: 16px 6px; gap: 10px; }
                .ay-services .ay-info i { width: 36px; height: 36px; font-size: .95rem; }
                .ay-services .ay-svc-foot { flex-wrap: wrap; }
                .ay-services .ay-stamp { width: 100px; height: 100px; right: 10px; }
                .ay-services .ay-stamp strong { font-size: 1.8rem; }
            }

            /* ---------- website header (navbar) matching across all pages ---------- */
            header#top {
                background: rgba(24,18,14,.94) !important;
                backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
                border-bottom: 1px solid rgba(216,168,78,.22) !important;
                transition: background .35s ease;
            }
            header#top.o_header_is_scrolled, header#top.o_header_affixed, header#top.o_top_fixed_element {
                background: rgba(16,11,8,.97) !important;
            }
            header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
            header#top .navbar .nav-link,
            header#top .navbar a:not(.dropdown-item):not(.btn-primary),
            header#top .navbar button:not(.btn-primary):not(.dropdown-item),
            header#top .navbar .navbar-brand,
            header#top .navbar .fa, header#top .navbar .oi {
                color: #fcf9f4 !important;
            }
            header#top .navbar .navbar-brand {
                font-family: 'Playfair Display', Georgia, serif !important;
                font-weight: 700 !important;
                letter-spacing: .03em !important;
            }
            header#top .navbar .nav-link {
                font-family: 'Plus Jakarta Sans', sans-serif !important;
                font-weight: 600 !important;
                font-size: .86rem !important;
                letter-spacing: .02em !important;
                text-transform: none !important;
                position: relative;
            }
            header#top .navbar .nav-link::after {
                content: ""; position: absolute; left: 50%; right: 50%; bottom: 4px; height: 1px; background: #d8a84e;
                transition: left .35s ease, right .35s ease;
            }
            header#top .navbar .nav-link:hover::after, header#top .navbar .nav-link.active::after { left: 14px; right: 14px; }
            header#top .navbar .nav-link:hover,
            header#top .navbar .nav-link.active,
            header#top .navbar .nav-item.active > .nav-link { color: #f5cf7b !important; }
            header#top .navbar .btn-primary {
                background: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%) !important;
                border: 0 !important;
                color: #18120e !important;
                font-family: 'Plus Jakarta Sans', sans-serif !important;
                font-weight: 700 !important;
                font-size: .82rem !important;
                letter-spacing: .08em !important;
                text-transform: uppercase !important;
                border-radius: 999px !important;
                box-shadow: 0 4px 16px rgba(216,168,78,.35) !important;
            }
            header#top .o_navlink_background, header#top .navbar .btn-light, header#top .navbar .o_wsale_my_cart .btn {
                background: rgba(252,249,244,.1) !important; border-color: rgba(252,249,244,.18) !important;
            }
            header#top .navbar-toggler { border-color: rgba(252,249,244,.4) !important; }
            header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
            header#top .offcanvas { background: #18120e !important; color: #fcf9f4; }
            header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item), header#top .offcanvas .btn-close { color: #fcf9f4 !important; }
            header#top .offcanvas .btn-close { filter: invert(1); }
            header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; text-transform: none; letter-spacing: 0; }
            @media (max-width: 991px) {
                header#top .navbar .nav-link::after { display: none; }
            }
        </style>
