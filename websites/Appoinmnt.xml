<t name="Appointments" t-name="appointment.appointment_type_index">
    <t t-set="head">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <!-- Playfair Display (headings) + Plus Jakarta Sans (body), same as the home page -->
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        <!-- Odoo 20 no longer ships Font Awesome: load it so the fa-* icons on this page show -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
        <style>
            /* =====================================================================
               AYSHU'S CULINARY - Reservations &amp; Celebrations, Kanjirappally
               ===================================================================== */
            #wrap.o_appointment_index {
                --ay-teak: #18120e; --ay-teak-deep: #100b08; --ay-teak-card: #231914;
                --ay-line: rgba(216,168,78,.22);
                --ay-gold: #d8a84e; --ay-gold-light: #f5cf7b;
                --ay-gold-grad: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%);
                --ay-green: #1f3d2b; --ay-green-light: #2b563c;
                --ay-cream: #fcf9f4; --ay-sand: #f4eee3; --ay-sand-line: #e3d7c5;
                --ay-ink: #1c140f; --ay-muted: #8a7c72; --ay-body: #5c4e45;
                --ay-serif: 'Playfair Display', Georgia, serif;
                --ay-sans: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
                --ay-radius: 14px; --ay-ease: cubic-bezier(.22,1,.36,1);
                background: var(--ay-cream); font-family: var(--ay-sans); color: var(--ay-ink); line-height: 1.65;
                overflow-x: hidden; -webkit-font-smoothing: antialiased;
                /* the appointment module adds 40px top padding here, which showed as a white strip under the navbar */
                padding-top: 0 !important; min-height: 0;
            }
            .o_appointment_index h1, .o_appointment_index h2, .o_appointment_index h3, .o_appointment_index h4 {
                font-family: var(--ay-serif); font-weight: 700; color: var(--ay-teak); letter-spacing: -.01em;
            }
            .o_appointment_index a { text-decoration: none; }
            .o_appointment_index a:focus-visible, .o_appointment_index button:focus-visible { outline: 2px solid var(--ay-gold); outline-offset: 3px; }
            .o_appointment_index .ay-eyebrow {
                display: inline-flex; align-items: center; gap: 12px;
                font-size: .74rem; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--ay-gold);
            }
            .o_appointment_index .ay-eyebrow::before { content: ""; width: 32px; height: 1px; background: currentColor; opacity: .8; }
            .o_appointment_index .ay-eyebrow-green { color: var(--ay-green); }
            .o_appointment_index .ay-title em { color: var(--ay-gold); font-style: italic; font-weight: 600; }
            .o_appointment_index .ay-btn {
                display: inline-flex; align-items: center; gap: 10px; padding: 15px 30px; border-radius: 999px;
                font-size: .78rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; border: 1px solid transparent;
                transition: transform .3s var(--ay-ease), box-shadow .3s var(--ay-ease), background .3s ease, color .3s ease, border-color .3s ease;
            }
            .o_appointment_index .ay-btn-gold { background: var(--ay-gold-grad); color: var(--ay-teak) !important; box-shadow: 0 10px 30px rgba(216,168,78,.38); }
            .o_appointment_index .ay-btn-gold:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgba(216,168,78,.58); }
            .o_appointment_index .ay-btn-ghost { border-color: rgba(255,255,255,.35); color: #fff !important; background: rgba(255,255,255,.06); backdrop-filter: blur(8px); }
            .o_appointment_index .ay-btn-ghost:hover { border-color: var(--ay-gold); color: var(--ay-gold-light) !important; transform: translateY(-3px); }

            /* ---------- hero ---------- */
            .o_appointment_index .ay-appt-hero {
                position: relative; color: #fff; overflow: hidden; padding: 150px 0 0;
                background: url('https://images.unsplash.com/photo-1590846406792-0adc7f938f1d?q=80&amp;w=2000&amp;auto=format&amp;fit=crop') center/cover no-repeat;
            }
            .o_appointment_index .ay-appt-hero::before {
                content: ""; position: absolute; inset: 0;
                background:
                    radial-gradient(ellipse at 25% 40%, rgba(216,168,78,.16), transparent 60%),
                    linear-gradient(100deg, rgba(16,11,8,.95) 0%, rgba(24,18,14,.84) 50%, rgba(24,18,14,.45) 100%);
            }
            .o_appointment_index .ay-appt-hero > .container { position: relative; z-index: 2; padding-bottom: 80px; }
            .o_appointment_index .ay-brand { display: flex; align-items: center; gap: 16px; margin-bottom: 26px; }
            .o_appointment_index .ay-brand-crest { width: 56px; height: 56px; color: var(--ay-gold); flex-shrink: 0; filter: drop-shadow(0 4px 14px rgba(216,168,78,.35)); }
            .o_appointment_index .ay-brand-name {
                font-family: var(--ay-serif); font-weight: 800; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1; letter-spacing: .02em;
                background: var(--ay-gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
            }
            .o_appointment_index .ay-brand-sub { margin-top: 8px; font-size: .72rem; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; color: #e9e1d9; }
            .o_appointment_index .ay-appt-hero h1 {
                font-size: clamp(2.6rem, 5.6vw, 4.8rem); line-height: 1.06; color: #fff !important; margin: 22px 0; max-width: 820px;
                text-shadow: 0 4px 24px rgba(0,0,0,.45);
            }
            .o_appointment_index .ay-appt-hero h1 em { color: var(--ay-gold-light); font-style: italic; font-weight: 600; }
            .o_appointment_index .ay-appt-hero p { color: #ded6cf; font-size: 1.1rem; line-height: 1.85; max-width: 620px; }
            .o_appointment_index .ay-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
            .o_appointment_index .ay-perks { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
            .o_appointment_index .ay-perks span {
                display: inline-flex; align-items: center; gap: 9px; padding: 8px 16px; border-radius: 999px;
                border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.05); color: #e9e1d9; font-size: .82rem; font-weight: 600;
            }
            .o_appointment_index .ay-perks .fa { color: var(--ay-gold); }
            .o_appointment_index .ay-infobar { position: relative; z-index: 3; background: rgba(16,11,8,.9); backdrop-filter: blur(14px); border-top: 1px solid var(--ay-line); }
            .o_appointment_index .ay-info { display: flex; align-items: center; gap: 14px; padding: 22px 10px; }
            .o_appointment_index .ay-info i {
                width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
                background: rgba(216,168,78,.12); border: 1px solid var(--ay-line); color: var(--ay-gold); font-size: 1.05rem;
            }
            .o_appointment_index .ay-info small { display: block; font-size: .66rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ay-muted); }
            .o_appointment_index .ay-info b, .o_appointment_index .ay-info a { color: #fff; font-size: .94rem; font-weight: 700; }

            /* ---------- title row + search ---------- */
            .o_appointment_index .ay-appt-main { padding: 90px 0 0; }
            .o_appointment_index .ay-appt-head h2 { font-size: clamp(2rem, 3.6vw, 3rem); margin: 12px 0 0; }
            .o_appointment_index .ay-appt-head p { color: var(--ay-body); margin: 10px 0 0; max-width: 560px; }
            .o_appointment_index .o_appointment_search .input-group { box-shadow: 0 14px 30px -20px rgba(24,18,14,.4); border-radius: 999px; }
            .o_appointment_index .o_appointment_search .form-control {
                border-radius: 999px 0 0 999px; border: 1px solid var(--ay-sand-line); border-right: 0; padding: 13px 20px; background: #fff;
                min-width: 260px; font-family: var(--ay-sans); font-size: .92rem;
            }
            .o_appointment_index .o_appointment_search .form-control:focus { border-color: var(--ay-gold); box-shadow: none; }
            .o_appointment_index .o_appointment_search .btn {
                border-radius: 0 999px 999px 0; background: var(--ay-teak); border-color: var(--ay-teak); color: var(--ay-gold-light); padding: 0 22px;
            }
            .o_appointment_index .o_appointment_search .btn:hover { background: var(--ay-gold-grad); color: var(--ay-teak); border-color: var(--ay-gold); }

            /* ---------- appointment cards ---------- */
            .o_appointment_index .ay-appt-grid { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 28px !important; }
            .o_appointment_index .o_appointment_type_card {
                flex-direction: column !important; background: #fff !important; border: 1px solid var(--ay-sand-line) !important; border-radius: var(--ay-radius) !important;
                color: var(--ay-ink) !important; position: relative; height: 100%; box-shadow: 0 1px 2px rgba(24,18,14,.04);
                transition: transform .4s var(--ay-ease), box-shadow .4s var(--ay-ease), border-color .4s ease;
            }
            .o_appointment_index .o_appointment_type_card:hover { transform: translateY(-8px); box-shadow: 0 34px 60px -32px rgba(24,18,14,.5); border-color: var(--ay-gold) !important; }
            .o_appointment_index .o_appointment_type_card::before {
                content: ""; position: absolute; left: 0; top: 0; height: 3px; width: 0; z-index: 3; background: var(--ay-gold-grad); transition: width .5s var(--ay-ease);
            }
            .o_appointment_index .o_appointment_type_card:hover::before { width: 100%; }
            .o_appointment_index .o_appointment_type_card_image {
                display: block !important; order: -1; width: 100%; height: 220px; background-size: cover; background-position: center;
                position: relative;
            }
            /* cards without their own image get Ayshu's dining room photo */
            .o_appointment_index .o_appointment_type_card:not(:has(.o_appointment_type_card_image)) > .d-flex::before {
                content: ""; display: block; height: 220px; margin: -26px -26px 6px; width: calc(100% + 52px);
                background: linear-gradient(160deg, rgba(24,18,14,.15), rgba(24,18,14,.55)),
                            url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&amp;w=900&amp;auto=format&amp;fit=crop') center/cover;
            }
            .o_appointment_index .o_appointment_type_card > .d-flex { flex-direction: column !important; align-items: flex-start !important; gap: 16px !important; padding: 26px 26px 84px !important; }
            .o_appointment_index .premium-card-title { font-size: 1.5rem; line-height: 1.25; color: var(--ay-teak); display: flex; align-items: center; }
            .o_appointment_index .premium-card-title > span.me-2 {
                width: 48px; height: 48px; min-width: 48px; border-radius: 50%; background: var(--ay-teak); display: inline-flex; align-items: center; justify-content: center;
                font-size: 1.35rem; margin-right: 14px !important; box-shadow: 0 0 0 5px var(--ay-sand);
            }
            .o_appointment_index .o_appointment_type_card_info { flex-direction: row !important; flex-wrap: wrap; gap: 10px 22px !important; color: var(--ay-body); font-size: .9rem; }
            .o_appointment_index .o_appointment_type_card_info .fw-semibold { font-weight: 600 !important; }
            .o_appointment_index .o_appointment_type_card_info .oi { color: var(--ay-gold); }
            .o_appointment_index .o_appointment_chip {
                background: var(--ay-sand); color: var(--ay-body); border: 1px solid var(--ay-sand-line); border-radius: 999px;
                padding: 4px 12px 4px 4px; font-size: .8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;
            }
            .o_appointment_index .o_appointment_avatar { width: 26px; height: 26px; background: var(--ay-teak); color: var(--ay-gold-light); font-size: .74rem; font-weight: 800; }
            .o_appointment_index .o_appointment_type_card::after {
                content: "Book now  \2192"; position: absolute; left: 26px; right: 26px; bottom: 24px; text-align: center;
                padding: 12px; border-radius: 999px; background: var(--ay-teak); color: var(--ay-gold-light);
                font-weight: 800; font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; transition: all .3s ease;
            }
            .o_appointment_index .o_appointment_type_card:hover::after { background: var(--ay-gold-grad); color: var(--ay-teak); box-shadow: 0 10px 24px rgba(216,168,78,.4); }
            .o_appointment_index .o_appointment_unpublished { position: absolute; top: 14px; right: 14px; z-index: 4; border-radius: 999px; }
            .o_appointment_index .ay-empty { background: #fff; border: 1px dashed var(--ay-sand-line); border-radius: var(--ay-radius); padding: 50px 24px; }
            .o_appointment_index .ay-empty .fa { font-size: 2.2rem; color: var(--ay-gold); margin-bottom: 14px; }

            /* ---------- spaces ---------- */
            .o_appointment_index .ay-spaces { margin-top: 100px; }
            .o_appointment_index .ay-space {
                position: relative; border-radius: var(--ay-radius); overflow: hidden; height: 300px; display: block;
                box-shadow: 0 26px 54px -30px rgba(24,18,14,.7);
            }
            .o_appointment_index .ay-space img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ay-ease); }
            .o_appointment_index .ay-space:hover img { transform: scale(1.08); }
            .o_appointment_index .ay-space::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 30%, rgba(16,11,8,.92) 100%); }
            .o_appointment_index .ay-space-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 24px 26px; }
            .o_appointment_index .ay-space-tag {
                display: inline-block; padding: 5px 12px; border-radius: 999px; background: var(--ay-gold-grad); color: var(--ay-teak);
                font-size: .64rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
            }
            .o_appointment_index .ay-space h4 { color: #fff; font-size: 1.6rem; margin: 12px 0 6px; }
            .o_appointment_index .ay-space p { color: #d6ccc3; font-size: .88rem; margin: 0; line-height: 1.6; }

            /* ---------- how it works ---------- */
            .o_appointment_index .ay-steps {
                margin-top: 100px; border-radius: 20px; padding: 58px 50px; color: #fff; position: relative; overflow: hidden;
                background: radial-gradient(circle at 88% 12%, rgba(216,168,78,.18), transparent 45%), var(--ay-teak);
            }
            .o_appointment_index .ay-steps h3 { color: #fff; font-size: clamp(1.9rem, 3.2vw, 2.6rem); margin: 12px 0 36px; }
            .o_appointment_index .ay-steps h3 em { color: var(--ay-gold-light); font-style: italic; }
            .o_appointment_index .ay-step {
                display: flex; gap: 18px; height: 100%; padding: 26px 24px; border-radius: 12px;
                background: var(--ay-teak-card); border: 1px solid var(--ay-line); transition: border-color .3s ease, transform .3s var(--ay-ease);
            }
            .o_appointment_index .ay-step:hover { border-color: var(--ay-gold); transform: translateY(-4px); }
            .o_appointment_index .ay-step b { font-family: var(--ay-serif); font-size: 2.4rem; line-height: 1; background: var(--ay-gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
            .o_appointment_index .ay-step h4 { color: #fff; font-size: 1.2rem; margin: 0 0 6px; }
            .o_appointment_index .ay-step p { color: #b0a49c; margin: 0; font-size: .9rem; line-height: 1.65; }

            /* ---------- help band ---------- */
            .o_appointment_index .ay-help {
                margin-top: 28px; border-radius: 20px; padding: 44px 50px; background: var(--ay-green); color: #fff;
                display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap;
            }
            .o_appointment_index .ay-help h3 { color: #fff; font-size: clamp(1.6rem, 2.8vw, 2.2rem); margin: 10px 0 6px; }
            .o_appointment_index .ay-help p { color: #c9d6cc; margin: 0; max-width: 560px; }
            .o_appointment_index .ay-help .ay-eyebrow { color: var(--ay-gold-light); }
            .o_appointment_index .ay-hours { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: #e3ece5; font-size: .86rem; }
            .o_appointment_index .ay-hours .fa { color: var(--ay-gold-light); margin-right: 6px; }

            /* ---------- motion &amp; responsive ---------- */
            @keyframes ay-fade-up { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
            .o_appointment_index .ay-reveal { animation: ay-fade-up 1s var(--ay-ease) both; }
            .o_appointment_index .ay-d1 { animation-delay: .15s; } .o_appointment_index .ay-d2 { animation-delay: .3s; } .o_appointment_index .ay-d3 { animation-delay: .45s; }
            @media (prefers-reduced-motion: reduce) {
                .o_appointment_index *, .o_appointment_index *::before, .o_appointment_index *::after { animation: none !important; transition: none !important; }
            }
            @media (max-width: 991px) {
                .o_appointment_index .ay-appt-hero { padding-top: 120px; }
            }
            @media (max-width: 767px) {
                .o_appointment_index .ay-appt-grid { grid-template-columns: 1fr; }
                .o_appointment_index .ay-steps, .o_appointment_index .ay-help { padding: 36px 22px; }
                .o_appointment_index .o_appointment_search, .o_appointment_index .o_appointment_search .form-control { width: 100%; min-width: 0; }
                .o_appointment_index .ay-hero-actions .ay-btn { width: 100%; justify-content: center; }
                .o_appointment_index .ay-brand-crest { width: 46px; height: 46px; }
                .o_appointment_index .ay-brand-sub { letter-spacing: .16em; }
            }

            /* ---------- website header (navbar) matching across all pages ---------- */
            header#top {
                background: rgba(24,18,14,.94) !important;
                backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
                border-bottom: 1px solid rgba(216,168,78,.22) !important;
                transition: background .35s ease;
            }
            header#top.o_header_is_scrolled, header#top.o_header_affixed, header#top.o_top_fixed_element {
                background: rgba(16,11,8,.97) !important;
            }
            header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
            header#top .navbar .nav-link,
            header#top .navbar a:not(.dropdown-item):not(.btn-primary),
            header#top .navbar button:not(.btn-primary):not(.dropdown-item),
            header#top .navbar .navbar-brand,
            header#top .navbar .fa, header#top .navbar .oi {
                color: #fcf9f4 !important;
            }
            header#top .navbar .navbar-brand {
                font-family: 'Playfair Display', Georgia, serif !important;
                font-weight: 700 !important;
                letter-spacing: .03em !important;
            }
            header#top .navbar .nav-link {
                font-family: 'Plus Jakarta Sans', sans-serif !important;
                font-weight: 600 !important;
                font-size: .86rem !important;
                letter-spacing: .02em !important;
                text-transform: none !important;
                position: relative;
            }
            header#top .navbar .nav-link::after {
                content: ""; position: absolute; left: 50%; right: 50%; bottom: 4px; height: 1px; background: #d8a84e;
                transition: left .35s ease, right .35s ease;
            }
            header#top .navbar .nav-link:hover::after, header#top .navbar .nav-link.active::after { left: 14px; right: 14px; }
            header#top .navbar .nav-link:hover,
            header#top .navbar .nav-link.active,
            header#top .navbar .nav-item.active > .nav-link { color: #f5cf7b !important; }
            header#top .navbar .btn-primary {
                background: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%) !important;
                border: 0 !important;
                color: #18120e !important;
                font-family: 'Plus Jakarta Sans', sans-serif !important;
                font-weight: 700 !important;
                font-size: .82rem !important;
                letter-spacing: .08em !important;
                text-transform: uppercase !important;
                border-radius: 999px !important;
                box-shadow: 0 4px 16px rgba(216,168,78,.35) !important;
            }
            header#top .o_navlink_background, header#top .navbar .btn-light, header#top .navbar .o_wsale_my_cart .btn {
                background: rgba(252,249,244,.1) !important; border-color: rgba(252,249,244,.18) !important;
            }
            header#top .navbar-toggler { border-color: rgba(252,249,244,.4) !important; }
            header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
            header#top .offcanvas { background: #18120e !important; color: #fcf9f4; }
            header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item), header#top .offcanvas .btn-close { color: #fcf9f4 !important; }
            header#top .offcanvas .btn-close { filter: invert(1); }
            header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; text-transform: none; letter-spacing: 0; }
            @media (max-width: 991px) {
                header#top .navbar .nav-link::after { display: none; }
            }
        </style>
    </t>
        <t t-call="website.layout" head="head">
            <div id="wrap" class="o_appointment_page o_appointment_index">

                <!-- ===================== HERO ===================== -->
                <section class="ay-appt-hero">
                    <div class="container">
                        <div class="ay-brand ay-reveal">
                            <svg class="ay-brand-crest" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
                                <path d="M50 4 C48 26 34 44 22 50 C32 46 42 38 48 24 C54 38 64 46 74 50 C62 44 52 26 50 4 Z"/>
                                <path d="M50 30 C45 47 28 61 12 65 C24 62 36 55 45 43 C48 50 52 50 55 43 C64 55 76 62 88 65 C72 61 55 47 50 30 Z"/>
                                <path d="M50 52 C44 66 30 78 18 82 C28 80 38 74 46 64 C49 70 51 70 54 64 C62 74 72 80 82 82 C70 78 56 66 50 52 Z"/>
                                <path d="M26 88 L74 88 L68 94 L32 94 Z"/>
                            </svg>
                            <div>
                                <div class="ay-brand-name">Ayshu's Culinary</div>
                                <div class="ay-brand-sub">Aesthetic Cafe &amp; Arabian Kitchen</div>
                            </div>
                        </div>
                        <span class="ay-eyebrow ay-reveal ay-d1">Reservations &amp; Celebrations</span>
                        <h1 class="ay-reveal ay-d1">Reserve your table, <em>celebrate your moments</em></h1>
                        <p class="ay-reveal ay-d2">Book a family table for Kuzhimanthi night, a quiet corner in our cafe lounge, or let us host your birthday, anniversary or office party. Pick an experience, choose a time and we'll take care of the rest.</p>
                        <div class="ay-hero-actions ay-reveal ay-d3">
