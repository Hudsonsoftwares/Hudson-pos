<t name="Events" t-name="website_event.index">
    <t t-set="head">
        <meta t-if="search_tags" name="robots" content="none"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <!-- Playfair Display (regal serif headings) + Plus Jakarta Sans (clean body, buttons) -->
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
        <style>
/* =====================================================================
   AYSHU'S CULINARY - Aesthetic Events &amp; Gathering Experiences
   Dark Kerala teak, radiant brass, Arabian charcoal &amp; warm gold
   Matches HOME.xml theme &amp; visual hierarchy
   ===================================================================== */
#wrap.o_wevent_index {
    --ay-teak: #18120e;
    --ay-teak-deep: #100b08;
    --ay-teak-card: #231914;
    --ay-line: rgba(216,168,78,.22);
    --ay-gold: #d8a84e;
    --ay-gold-light: #f5cf7b;
    --ay-gold-grad: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%);
    --ay-green: #1f3d2b;
    --ay-green-light: #2b563c;
    --ay-cream: #fcf9f4;
    --ay-sand: #f4eee3;
    --ay-sand-line: #e3d7c5;
    --ay-terracotta: #c44d34;
    --ay-ink: #1c140f;
    --ay-muted: #8a7c72;
    --ay-body: #ded6cf;
    --ay-serif: 'Playfair Display', Georgia, serif;
    --ay-sans: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --ay-radius: 14px;
    --ay-ease: cubic-bezier(.22,1,.36,1);

    font-family: var(--ay-sans);
    font-size: 1rem;
    color: var(--ay-body);
    background: var(--ay-teak);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

#wrap.o_wevent_index h1,
#wrap.o_wevent_index h2,
#wrap.o_wevent_index h3,
#wrap.o_wevent_index h4,
#wrap.o_wevent_index h5,
#wrap.o_wevent_index .card-title,
#wrap.o_wevent_index .ay-serif {
    font-family: var(--ay-serif);
    font-weight: 700;
    letter-spacing: -.01em;
    color: #fff;
}

#wrap.o_wevent_index a { text-decoration: none; }
#wrap.o_wevent_index ::selection { background: var(--ay-gold); color: var(--ay-teak); }

/* ---------- Eyebrow &amp; Typography ---------- */
.ay-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: .74rem; font-weight: 700; letter-spacing: .26em; text-transform: uppercase; color: var(--ay-gold);
}
.ay-eyebrow::before { content: ""; width: 32px; height: 1px; background: currentColor; opacity: .8; }
.text-center .ay-eyebrow::after { content: ""; width: 32px; height: 1px; background: currentColor; opacity: .8; }

/* ---------- Buttons ---------- */
.ay-btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 30px; border-radius: 999px;
    font-size: .78rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; border: 1px solid transparent;
    transition: transform .3s var(--ay-ease), box-shadow .3s var(--ay-ease), background .3s ease, color .3s ease;
}
.ay-btn-gold {
    background: var(--ay-gold-grad); color: var(--ay-teak) !important;
    box-shadow: 0 10px 30px rgba(216,168,78,.38);
}
.ay-btn-gold:hover {
    transform: translateY(-3px); box-shadow: 0 16px 36px rgba(216,168,78,.58);
}

/* ---------- Hero Section ---------- */
.rc-ev-hero {
    position: relative; padding: 160px 0 110px; color: #fff; overflow: hidden;
    background:
        radial-gradient(ellipse at 25% 45%, rgba(216,168,78,.18), transparent 60%),
        linear-gradient(100deg, rgba(16,11,8,.96) 0%, rgba(24,18,14,.84) 45%, rgba(24,18,14,.4) 100%),
        linear-gradient(180deg, transparent 65%, rgba(24,18,14,.98) 100%),
        url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&amp;w=2070&amp;auto=format&amp;fit=crop') center/cover no-repeat;
}
.rc-ev-hero h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.6rem); line-height: 1.08; color: #fff; margin: 20px 0; max-width: 820px;
    text-shadow: 0 4px 24px rgba(0,0,0,.5);
}
.rc-ev-hero h1 em { color: var(--ay-gold-light); font-style: italic; font-weight: 600; }
.rc-ev-hero p { color: #ded6cf; font-size: 1.12rem; line-height: 1.85; max-width: 620px; }

.ay-hero-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
.ay-chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.05);
    font-size: .76rem; font-weight: 600; color: #e9e1d9; backdrop-filter: blur(6px);
}
.ay-chip .fa { color: var(--ay-gold); }

.rc-ev-hero .rc-ev-stats { display: flex; flex-wrap: wrap; gap: 40px; margin-top: 36px; }
.rc-ev-hero .rc-ev-stats strong { display: block; font-family: var(--ay-serif); font-size: 2.2rem; color: var(--ay-gold-light); line-height: 1; }
.rc-ev-hero .rc-ev-stats span { font-size: .8rem; font-weight: 600; color: #a99a8e; text-transform: uppercase; letter-spacing: .08em; margin-top: 4px; display: block; }

/* ---------- Topbar &amp; Filters ---------- */
.o_wevent_index_topbar_filters {
    padding: 24px 0 20px; border-bottom: 1px solid var(--ay-line); margin-bottom: 24px;
}
.o_wevent_index_topbar_filters h1 {
    font-family: var(--ay-serif) !important; font-size: 1.8rem; color: #fff; margin: 0;
}
.o_wevent_index .btn-light,
.o_wevent_index .dropdown-toggle {
    background: var(--ay-teak-card) !important; border: 1px solid var(--ay-line) !important;
    color: #e9e1d9 !important; border-radius: 999px !important; font-size: .82rem !important;
    font-weight: 600 !important; padding: 8px 18px !important; transition: all .3s ease;
}
.o_wevent_index .btn-light:hover,
.o_wevent_index .dropdown-toggle:hover {
    border-color: var(--ay-gold) !important; color: var(--ay-gold-light) !important; background: rgba(216,168,78,.12) !important;
}
.o_wevent_index .dropdown-menu {
    background: #1f1712 !important; border: 1px solid var(--ay-line) !important;
    border-radius: 12px !important; box-shadow: 0 16px 40px rgba(0,0,0,.65); padding: 8px !important;
}
.o_wevent_index .dropdown-item {
    color: #ded6cf !important; border-radius: 8px; padding: 8px 14px; font-size: .85rem; transition: background .2s ease;
}
.o_wevent_index .dropdown-item:hover {
    background: rgba(216,168,78,.16) !important; color: var(--ay-gold-light) !important;
}
.o_wevent_index .dropdown-item.active {
    background: var(--ay-gold-grad) !important; color: var(--ay-teak) !important; font-weight: 700;
}
.o_wevent_index .dropdown-item .badge {
    background: rgba(216,168,78,.2) !important; color: var(--ay-gold-light) !important;
}

/* Search input */
.o_wevent_index .o_wevent_search input {
    background: var(--ay-teak-card) !important; border: 1px solid var(--ay-line) !important;
    color: #fff !important; border-radius: 999px !important; padding: 10px 22px !important;
}
.o_wevent_index .o_wevent_search input::placeholder { color: var(--ay-muted) !important; }
.o_wevent_index .o_wevent_search input:focus {
    border-color: var(--ay-gold) !important; box-shadow: 0 0 0 3px rgba(216,168,78,.2) !important; outline: none;
}
.o_wevent_index .o_wevent_search .btn,
.o_wevent_index .btn-primary {
    background: var(--ay-gold-grad) !important; border: none !important;
    color: var(--ay-teak) !important; border-radius: 999px !important; font-weight: 800 !important;
}

/* ---------- Event Cards (Matching Home Dishes Theme) ---------- */
.o_wevent_events_list { padding: 30px 0 100px; background: var(--ay-teak); }
.o_wevent_events_list article.card {
    background: var(--ay-teak-card) !important;
    border: 1px solid var(--ay-line) !important;
    border-radius: var(--ay-radius) !important;
    overflow: hidden !important;
    transition: transform .35s var(--ay-ease), box-shadow .35s var(--ay-ease), border-color .35s ease !important;
}
.o_wevent_events_list article.card:hover {
    transform: translateY(-8px) !important;
    border-color: var(--ay-gold) !important;
    box-shadow: 0 24px 48px rgba(0,0,0,.55) !important;
}

/* Card Header &amp; Image */
.o_wevent_events_list .card-header {
    background: var(--ay-teak-deep) !important; border: none !important;
    height: 230px !important; min-height: 230px !important; position: relative !important; overflow: hidden !important;
}
.o_wevent_events_list .o_record_cover_container {
    width: 100% !important; height: 100% !important; min-height: 230px !important;
    position: relative !important; display: block !important;
    border-radius: var(--ay-radius) var(--ay-radius) 0 0 !important; overflow: hidden !important;
}
.o_wevent_events_list .o_record_cover_image {
    position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important;
    background-size: cover !important; background-position: center !important;
    transition: transform .8s var(--ay-ease) !important;
}
.o_wevent_events_list article.card:hover .o_record_cover_image {
    transform: scale(1.08) !important;
}
/* Fallback event image if background-image is none */
.o_wevent_events_list .o_record_cover_image[style*="background-image: none"],
.o_wevent_events_list .o_record_cover_image[style*="background-image:none"],
.o_wevent_events_list .o_record_cover_image:not([style*="background-image"]) {
    background-image: url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&amp;w=1074&amp;auto=format&amp;fit=crop') !important;
}

/* Date Badge on Card */
.o_wevent_events_list .o_wevent_event_date {
    background: rgba(16,11,8,.88) !important; border: 1px solid var(--ay-gold) !important;
    backdrop-filter: blur(8px); border-radius: 12px !important;
    padding: 8px 14px !important; text-align: center;
    box-shadow: 0 8px 24px rgba(0,0,0,.5) !important;
    top: 14px !important; left: 14px !important;
}
.o_wevent_events_list .o_wevent_event_month {
    color: var(--ay-gold-light) !important; font-size: .68rem !important;
    font-weight: 800 !important; letter-spacing: .16em !important; text-transform: uppercase !important;
    display: block;
}
.o_wevent_events_list .o_wevent_event_day {
    font-family: var(--ay-serif) !important; color: #fff !important;
    font-size: 1.55rem !important; font-weight: 700 !important; line-height: 1 !important;
    display: block; margin-top: 2px;
}

/* Badges on cards */
.o_wevent_events_list .badge {
    background: rgba(24,18,14,.88) !important; border: 1px solid var(--ay-line) !important;
    color: var(--ay-gold-light) !important; font-size: .64rem !important; font-weight: 700 !important;
    letter-spacing: .14em !important; text-transform: uppercase !important;
    border-radius: 999px !important; padding: 5px 13px !important;
}
.o_wevent_events_list .o_wevent_participating {
    background: var(--ay-green) !important; color: #fff !important; border-color: var(--ay-green-light) !important;
}
.o_wevent_events_list .o_wevent_scheduled {
    background: rgba(216,168,78,.25) !important; color: var(--ay-gold-light) !important; border-color: var(--ay-gold) !important;
}

/* Card Body */
.o_wevent_events_list .card-body {
    padding: 24px !important; background: var(--ay-teak-card) !important; color: #ded6cf !important;
}
.o_wevent_events_list .card-title {
    font-family: var(--ay-serif) !important; font-size: 1.35rem !important; font-weight: 700 !important;
    color: #fff !important; margin: 12px 0 8px !important; line-height: 1.25 !important;
    transition: color .3s ease;
}
.o_wevent_events_list article.card:hover .card-title {
    color: var(--ay-gold-light) !important;
}
.o_wevent_events_list small.opacity-75,
.o_wevent_events_list .card-text {
    color: #b0a49c !important; font-size: .88rem !important; line-height: 1.65 !important;
}

/* Location icon &amp; text */
.o_wevent_events_list .text-muted,
.o_wevent_events_list .fw-bold {
    color: var(--ay-gold) !important; font-size: .82rem !important;
}
.o_wevent_events_list .oi[data-icon="location_on"] {
    color: var(--ay-gold) !important;
}

/* CTA buttons inside cards */
.o_wevent_events_list .o_wevent_cta,
.o_wevent_events_list .btn-primary {
    background: var(--ay-gold-grad) !important; border: none !important;
    color: var(--ay-teak) !important; border-radius: 999px !important;
    font-size: .74rem !important; font-weight: 800 !important; letter-spacing: .14em !important;
    text-transform: uppercase !important; padding: 10px 22px !important;
    box-shadow: 0 8px 20px rgba(216,168,78,.35) !important;
    transition: all .3s ease !important;
}
.o_wevent_events_list .o_wevent_cta:hover,
.o_wevent_events_list .btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 28px rgba(216,168,78,.55) !important;
}

/* ---------- Pagination ---------- */
.o_wevent_index .pagination .page-link {
    background: var(--ay-teak-card) !important; border: 1px solid var(--ay-line) !important;
    color: #ded6cf !important; border-radius: 999px !important; margin: 0 4px; padding: 8px 16px;
    font-size: .85rem; font-weight: 600;
}
.o_wevent_index .pagination .page-item.active .page-link {
    background: var(--ay-gold-grad) !important; border-color: transparent !important;
    color: var(--ay-teak) !important; font-weight: 800;
}
.o_wevent_index .pagination .page-link:hover {
    border-color: var(--ay-gold) !important; color: var(--ay-gold-light) !important;
}

/* ---------- website header (navbar) matching across all pages ---------- */
header#top {
    background: rgba(24,18,14,.94) !important;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(216,168,78,.22) !important;
    transition: background .35s ease;
}
header#top.o_header_is_scrolled, header#top.o_header_affixed, header#top.o_top_fixed_element {
    background: rgba(16,11,8,.97) !important;
}
header#top .navbar, header#top .o_cc, header#top .o_header_mobile { background: transparent !important; }
header#top .navbar .nav-link,
header#top .navbar a:not(.dropdown-item):not(.btn-primary),
header#top .navbar button:not(.btn-primary):not(.dropdown-item),
header#top .navbar .navbar-brand,
header#top .navbar .fa, header#top .navbar .oi {
    color: #fcf9f4 !important;
}
header#top .navbar .navbar-brand {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-weight: 700 !important;
    letter-spacing: .03em !important;
}
header#top .navbar .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-weight: 600 !important;
    font-size: .86rem !important;
    letter-spacing: .02em !important;
    text-transform: none !important;
    position: relative;
}
header#top .navbar .nav-link::after {
    content: ""; position: absolute; left: 50%; right: 50%; bottom: 4px; height: 1px; background: #d8a84e;
    transition: left .35s ease, right .35s ease;
}
header#top .navbar .nav-link:hover::after, header#top .navbar .nav-link.active::after { left: 14px; right: 14px; }
header#top .navbar .nav-link:hover,
header#top .navbar .nav-link.active,
header#top .navbar .nav-item.active > .nav-link { color: #f5cf7b !important; }
header#top .navbar .btn-primary {
    background: linear-gradient(135deg, #f5cf7b 0%, #efbe58 40%, #d8a84e 100%) !important;
    border: 0 !important;
    color: #18120e !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-weight: 700 !important;
    font-size: .82rem !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
    border-radius: 999px !important;
    box-shadow: 0 4px 16px rgba(216,168,78,.35) !important;
}
header#top .o_navlink_background, header#top .navbar .btn-light, header#top .navbar .o_wsale_my_cart .btn {
    background: rgba(252,249,244,.1) !important; border-color: rgba(252,249,244,.18) !important;
}
header#top .navbar-toggler { border-color: rgba(252,249,244,.4) !important; }
header#top .navbar-toggler-icon { filter: invert(1) brightness(2); }
header#top .offcanvas { background: #18120e !important; color: #fcf9f4; }
header#top .offcanvas .nav-link, header#top .offcanvas a:not(.dropdown-item), header#top .offcanvas .btn-close { color: #fcf9f4 !important; }
header#top .offcanvas .btn-close { filter: invert(1); }
header#top .dropdown-menu .dropdown-item, header#top .dropdown-menu a { color: #212529 !important; text-transform: none; letter-spacing: 0; }
@media (max-width: 991px) {
    header#top .navbar .nav-link::after { display: none; }
}
        </style>
    </t>
    <t t-call="website.layout" head="head">
        <div id="wrap" class="o_wevent_index">
            <!-- Options -->
            <t t-set="opt_events_list_columns" t-value="is_view_active('website_event.opt_events_list_columns')"/>
            <!-- Drag/Drop Area -->
            <div id="oe_structure_we_index_0" class="oe_structure">
                <section class="rc-ev-hero o_colored_level" data-name="Events Hero">
                    <div class="container">
                        <span class="ay-eyebrow">Culinary Experiences &amp; Gatherings</span>
                        <h1>Gather, learn &amp; <em>celebrate</em> with us</h1>
                        <p>Cooking masterclasses with our chefs, barista &amp; latte art workshops, live grill evenings and festival feasts. Reserve your seat at our culinary table.</p>
                        <div class="ay-hero-chips">
                            <span class="ay-chip"><i class="fa fa-cutlery"/> Masterclasses</span>
                            <span class="ay-chip"><i class="fa fa-coffee"/> Barista Workshops</span>
                            <span class="ay-chip"><i class="fa fa-fire"/> Live Grill Nights</span>
                            <span class="ay-chip"><i class="fa fa-star"/> Festival Feasts</span>
                        </div>
                        <div class="rc-ev-stats">
                            <div><strong>40+</strong><span>events a year</span></div>
                            <div><strong>8</strong><span>signature masterclasses</span></div>
                            <div><strong>4.9★</strong><span>guest rating</span></div>
                        </div>
                        <div class="mt-4">
                            <a href="#o_wevent_index_main_col" class="ay-btn ay-btn-gold"><i class="fa fa-calendar"/> Explore upcoming events</a>
                        </div>
                    </div>
                </section>
            </div>
            <!-- Topbar -->
            <t t-call="website_event.index_topbar" search="original_search or search or searches['search']"/>
            <!-- Drag/Drop Area -->
            <div id="oe_structure_we_index_1" class="oe_structure oe_empty"/>
            <!-- Content -->
            <div class="o_wevent_events_list">
                <div class="container">
                    <div class="row">
                        <div id="o_wevent_index_main_col" t-attf-class="col-md mb-3 #{opt_events_list_columns and 'opt_events_list_columns' or 'opt_events_list_rows'}">
                            <div class="row g-4 g-lg-3 g-xxl-4">
                                <!-- Events List -->
                                <t t-call="website_event.events_list"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Drag/Drop Area -->
            <div id="oe_structure_we_index_2" class="oe_structure oe_empty"/>
        </div>
    </t>
</t>
