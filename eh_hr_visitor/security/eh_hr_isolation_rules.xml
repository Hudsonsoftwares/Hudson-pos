        <record id="rule_eh_hr_visitor_company" model="ir.access">
            <field name="name">EH Visitor: per company</field>
            <field name="model_id" ref="model_eh_hr_visitor"/>
            <field name="domain">[('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

