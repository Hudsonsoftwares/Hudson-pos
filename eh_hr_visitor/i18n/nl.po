#. module: eh_hr_visitor
#: model:mail.template,body_html:eh_hr_visitor.email_template_visitor_arrived
msgid ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"                    <p>Hi <t t-out=\"object.host_employee_id.name or 'there'\"/>,</p>\n"
"                    <p>\n"
"                        Your visitor <strong t-out=\"object.name\"/>\n"
"                        <t t-if=\"object.visitor_company\">\n"
"                            from <t t-out=\"object.visitor_company\"/>\n"
"                        </t>\n"
"                        has arrived.\n"
"                    </p>\n"
"                    <p>\n"
"                        Purpose: <strong t-out=\"object.purpose_id.name\"/><br/>\n"
"                        Visit number: <strong t-out=\"object.visit_number\"/><br/>\n"
"                        Signed in at: <t t-out=\"object.arrived_on\"/>\n"
"                    </p>\n"
"                    <p>Please head to reception when you are ready.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"                    <p>Hallo <t t-out=\"object.host_employee_id.name or 'there'\"/>,</p>\n"
"                    <p>\n"
"                        Uw bezoeker <strong t-out=\"object.name\"/>\n"
"                        <t t-if=\"object.visitor_company\">\n"
"                            van <t t-out=\"object.visitor_company\"/>\n"
"                        </t>\n"
"                        is gearriveerd.\n"
"                    </p>\n"
"                    <p>\n"
"                        Doel: <strong t-out=\"object.purpose_id.name\"/><br/>\n"
"                        Bezoeknummer: <strong t-out=\"object.visit_number\"/><br/>\n"
"                        Ingecheckt om: <t t-out=\"object.arrived_on\"/>\n"
"                    </p>\n"
"                    <p>Ga naar de receptie wanneer u klaar bent.</p>\n"
"                </div>"

