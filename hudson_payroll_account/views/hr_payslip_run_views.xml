<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.account</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button for Accounting Entries -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_account_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="attach_money"
                        invisible="move_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Journal Entry</span>
                        <span class="o_stat_text">(<field name="hds_move_status" readonly="1"/>)</span>
                    </div>
                </button>
            </xpath>

            <!-- Salary Journal -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="journal_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Payroll journal entries list: Odoo's Journal Entries list without the Partner column
         (used by the pay run / payslip Journal Entry buttons; Accounting's own list is unchanged) -->
    <record id="view_move_tree_payroll" model="ir.ui.view">
        <field name="name">account.move.list.payroll</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search View Inherit to search by journal_id -->
    <record id="hr_payslip_run_view_search_inherit_account" model="ir.ui.view">
        <field name="name">hr.payslip.run.search.inherit.account</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_run_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="journal_id"/>
            </xpath>
        </field>
    </record>

    <!-- List View Inherit to show journal_id -->
    <record id="hr_payslip_run_view_list_inherit_account" model="ir.ui.view">
        <field name="name">hr.payslip.run.list.inherit.account</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_run_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="journal_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
