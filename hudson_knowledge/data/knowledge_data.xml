<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default Welcome Article -->
    <record id="knowledge_article_welcome" model="knowledge.management.article">
        <field name="name">Welcome to Hudson Knowledge</field>
        <field name="icon">🏠</field>
        <field name="sequence">1</field>
        <field name="visibility">workspace</field>
        <field name="body_html"><![CDATA[
<h1>Welcome to Hudson Knowledge 📚</h1>
<p>This is your company's knowledge base. Use it to create, share and manage articles, documentation and guides.</p>
<h2>Getting Started</h2>
<ul>
    <li>Click <strong>+ New Article</strong> in the sidebar to create your first article</li>
    <li>Use the <strong>rich text editor</strong> to add headings, lists, images and more</li>
    <li>Type <strong>/</strong> anywhere in an article to access quick commands</li>
    <li>Build <strong>Item Kanbans</strong>, <strong>Item Lists</strong> and <strong>Item Calendars</strong> directly inside articles</li>
</ul>
<h2>Organize your knowledge</h2>
<p>Articles are organized into three sections:</p>
<ul>
    <li><strong>Workspace</strong> — visible to all internal users</li>
    <li><strong>Shared</strong> — visible to specific users you invite</li>
    <li><strong>Private</strong> — only visible to you</li>
</ul>
        ]]></field>
    </record>

