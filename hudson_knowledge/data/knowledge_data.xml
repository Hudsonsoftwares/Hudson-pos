    <!-- Tiny House Catalog Template (Matches Image 1 reference) -->
    <record id="knowledge_template_catalog" model="knowledge.management.article.template">
        <field name="category_id" ref="knowledge_template_category_sales"/>
        <field name="name">Tiny House Catalog</field>
        <field name="icon">🏡</field>
        <field name="sequence">40</field>
        <field name="body_html"><![CDATA[
<h1>Tiny House Catalog</h1>
<p class="lead">Explore our curated collection of architectural designs, modern layouts, and sustainable micro-homes.</p>
<div class="o_knowledge_item_view_host" data-embedded="knowledgeItemView" data-oe-protected="true" contenteditable="false" data-embedded-props='{"viewType": "kanban", "name": "Available Models"}'></div>
<p><br></p>
<h2>Available Models ✅</h2>
<div class="o_knowledge_item_view_host" data-embedded="knowledgeItemView" data-oe-protected="true" contenteditable="false" data-embedded-props='{"viewType": "list", "name": "Model Specifications &amp; Pricing"}'></div>
<p><br></p>
<h2>How to find the perfect model for your needs 🥰</h2>
<p>Here is a short guide that will help you pick the right tiny house for you:</p>
<ul>
    <li><strong>Footprint & Mobility:</strong> Determine whether you plan to keep your home stationary or towable on a trailer.</li>
    <li><strong>Off-Grid Capabilities:</strong> Evaluate solar packages, rainwater harvesting, and composting toilet systems.</li>
    <li><strong>Interior Customization:</strong> Loft bedrooms vs. ground-floor master suites, compact kitchenettes, and foldable dining tables.</li>
</ul>
<p><img src="https://images.unsplash.com/photo-1518780664697-55e3ad937233?auto=format&fit=crop&w=1200&q=80" alt="Tiny Home" class="img-fluid rounded my-3" style="max-height:360px; object-fit:cover; width:100%;"/></p>
<p><em>Contact our architectural advisory team to schedule a custom walkthrough session.</em></p>
        ]]></field>
    </record>

    <!-- Product Feature Specification (PRD) Template -->
    <record id="knowledge_template_prd" model="knowledge.management.article.template">
        <field name="category_id" ref="knowledge_template_category_product"/>
        <field name="name">Product Feature Spec (PRD)</field>
        <field name="icon">🚀</field>
        <field name="sequence">50</field>
        <field name="body_html"><![CDATA[
<h1>Product Feature Specification 🚀</h1>
<p><strong>Owner:</strong> Product Management | <strong>Status:</strong> In Review | <strong>Target Release:</strong> Q4</p>
<hr/>
<h2>1. Problem Statement & Motivation</h2>
<p>Users require an automated, streamlined solution to eliminate recurring manual data entry and improve team turnaround times.</p>
<h2>2. Scope & Key Deliverables</h2>
<div class="o_knowledge_item_view_host" data-embedded="knowledgeItemView" data-oe-protected="true" contenteditable="false" data-embedded-props='{"viewType": "list", "name": "Functional Deliverables"}'></div>
<p><br></p>
<h2>3. Execution Kanban</h2>
<div class="o_knowledge_item_view_host" data-embedded="knowledgeItemView" data-oe-protected="true" contenteditable="false" data-embedded-props='{"viewType": "kanban", "name": "Implementation Phases"}'></div>
<p><br></p>
<h2>4. Key Performance Metrics</h2>
<ul>
    <li>User task completion efficiency improved by 35%</li>
    <li>Zero critical blocking bugs during rollout week</li>
</ul>
        ]]></field>
    </record>

