<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Article row of the "?" namespace of the command palette -->
    <t t-name="hudson_knowledge.KnowledgeArticleCommand">
        <div class="o_command_default o_knowledge_command d-flex align-items-center gap-2 px-4 py-2 cursor-pointer">
            <span class="o_knowledge_command_icon flex-shrink-0">
                <t t-if="this.props.icon" t-out="this.props.icon"/>
                <svg t-else="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </span>
            <span class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
                <t t-call-slot="name"/>
                <span t-if="this.props.isFavorite" class="o_knowledge_command_favorite flex-shrink-0" title="Favorite">★</span>
                <small t-if="this.props.parentPath" class="o_knowledge_command_path text-muted text-truncate" t-out="this.props.parentPath"/>
            </span>
            <span class="ms-auto flex-shrink-0">
                <t t-call-slot="focusMessage"/>
            </span>
        </div>
    </t>

    <!-- Knowledge button in the control panel of form views with a chatter
         (enabled by the FormController patch through env.knowledgeFormButton) -->
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <button t-if="this.env.knowledgeFormButton?.visible and !this.env.inDialog"
                    type="button"
                    class="btn btn-link o_knowledge_form_button px-1 align-self-center"
                    title="Search Knowledge Articles"
                    aria-label="Search Knowledge Articles"
                    t-on-click="() => this.env.knowledgeFormButton.open()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M9 2h10a2 2 0 0 1 2 2v16l-3-2V4H9z" opacity="0.55"/>
                    <path d="M5 6h10a2 2 0 0 1 2 2v14l-6-4-6 4V8a2 2 0 0 1 2-2z"/>
                </svg>
            </button>
        </xpath>
    </t>

</templates>
