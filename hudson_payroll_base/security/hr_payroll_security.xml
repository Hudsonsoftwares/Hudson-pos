<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payroll Privilege Category in Odoo 19 -->
        <record model="res.groups.privilege" id="res_groups_payroll_base">
            <field name="name">Payroll</field>
            <field name="sequence">16</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <!-- Payroll Officer / User Group -->
        <record id="group_payroll_user" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="res_groups_payroll_base"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Payroll Administrator / Manager Group -->
        <record id="group_payroll_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_payroll_base"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_user')), (4, ref('hr.group_hr_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        </data>
</odoo>
