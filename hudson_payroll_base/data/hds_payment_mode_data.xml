<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Default Payment Modes seeded on first install (country-specific modes come from the localizations) -->
    <record id="payment_mode_bank_transfer" model="hds.payment.mode">
        <field name="name">Bank Transfer</field>
        <field name="code">bank_transfer</field>
        <field name="is_cash">False</field>
        <field name="sequence">1</field>
    </record>

    <record id="payment_mode_cheque" model="hds.payment.mode">
        <field name="name">Cheque</field>
        <field name="code">cheque</field>
        <field name="is_cash">False</field>
        <field name="sequence">3</field>
    </record>

    <record id="payment_mode_cash" model="hds.payment.mode">
        <field name="name">Cash</field>
        <field name="code">cash</field>
        <field name="is_cash">True</field>
        <field name="sequence">4</field>
    </record>
</odoo>
