<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!--  PAY RUNS LIST VIEW (Default)  - Matching Screenshot 1       -->
        <!--  Shows: Name/Period, Total Cost, Net, Status badge, Buttons  -->
        <!-- ============================================================ -->
        <record id="hr_payslip_run_view_list" model="ir.ui.view">
            <field name="name">hr.payslip.run.list</field>
            <field name="model">hr.payslip.run</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="Pay Runs" js_class="hudson_payrun_list" default_order="date_end desc, id desc"
                      decoration-muted="state == 'close'">
                    <!-- Hidden computed fields needed for button visibility and monetary widget -->
                    <field name="currency_id" column_invisible="True"/>
                    <field name="show_payment_advice_btn" column_invisible="True"/>
                    <field name="has_done_slips" column_invisible="True"/>
                    <field name="slips_all_done" column_invisible="True"/>

                    <!-- Pay Run Name + Period + Employee count (primary column) -->
                    <field name="name" string="Pay Run" widget="text" class="fw-semibold"/>

                    <!-- Period -->
                    <field name="date_start" string="From" optional="show"/>
                    <field name="date_end" string="To" optional="show"/>

                    <!-- Employee count -->
                    <field name="payslip_count" string="Employees" optional="show"/>

                    <!-- Financial totals -->
                    <field name="employer_cost_total" string="Total Cost" widget="monetary" optional="show" sum="Total"/>
                    <field name="net_wage_total" string="Net" widget="monetary" optional="show" sum="Net Total"/>

                    <!-- Status badge matching screenshot: Ready / Done -->
                    <field name="state" widget="badge"
                           decoration-warning="state == 'draft'"
                           decoration-success="state in ('confirmed', 'close')"
                           decoration-info="state == 'paid'"/>

                    <field name="company_id" groups="base.group_multi_company" optional="show"/>

                    <!-- Inline Action Buttons (per row) matching Screenshot 1 -->
                    <!-- Test Print: shown when in draft (some slips exist) -->
                    <button name="action_test_print" type="object" string="Test Print"
                            class="btn btn-sm btn-outline-secondary"
                            invisible="state != 'draft' or not has_done_slips"
                            title="Print a test payslip"/>

                    <!-- Validate: shown when draft with done slips -->
                    <button name="action_batch_validate" type="object" string="Validate"
                            class="btn btn-sm btn-primary"
                            invisible="state != 'draft' or not has_done_slips"
                            confirm="Are you sure you want to validate this pay run?"
                            title="Validate all payslips in this pay run"/>

                    <!-- Mark as Paid: shown when confirmed -->
                    <button name="action_pay_payrun" type="object" string="Mark as Paid"
                            class="btn btn-sm btn-primary"
                            invisible="state != 'confirmed'"
                            confirm="Mark this pay run as Paid?"
                            title="Mark pay run as paid"/>

                    <!-- Pay (generate payment advice): shown when confirmed -->
                    <button name="action_open_pay_wizard" type="object" string="Pay"
                            class="btn btn-sm btn-primary"
                            invisible="not show_payment_advice_btn"
                            title="Generate Payment Advice"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--  PAY RUNS KANBAN VIEW (Default) - Matching Screenshot 1      -->
        <!-- ============================================================ -->
        <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.run.kanban</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <kanban default_order="date_end desc, id desc" class="o_payroll_payruns_kanban o_kanban_list"
                        on_create="hudson_payroll_base.action_hudson_payrun_wizard">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="period_summary_str"/>
                    <field name="state"/>
                    <field name="payslip_count"/>
                    <field name="employer_cost_total"/>
                    <field name="net_wage_total"/>
                    <field name="currency_id"/>
                    <field name="has_done_slips"/>
                    <field name="is_test_printed"/>
                    <field name="show_validate_btn"/>
                    <field name="show_test_print_btn"/>
                    <field name="show_payment_advice_btn"/>
                    <field name="has_duplicate_payslips"/>
                    <field name="duplicate_payslip_count"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click o_payroll_payrun_row o_payrun_state_#{record.state.raw_value}">
                                <!-- Title & period -->
                                <div class="o_payrun_main">
                                    <div class="o_payrun_title">
                                        <span class="o_payrun_name"><field name="name"/></span>
                                        <span t-if="record.has_duplicate_payslips.raw_value and record.state.raw_value == 'draft'"
                                              class="o_payrun_dup_chip" title="Duplicate Payslips Detected">
                                            <i class="oi me-1" data-icon="warning"/><t t-out="record.duplicate_payslip_count.value"/> Duplicate
                                        </span>
                                    </div>
                                    <div class="o_payrun_period">
                                        <i class="oi me-1" data-icon="calendar_today"/><field name="period_summary_str"/>
                                    </div>
                                </div>
                                <!-- Total Cost -->
                                <div class="o_payrun_amount">
                                    <div class="o_payrun_label">Total Cost</div>
                                    <div class="o_payrun_value"><field name="employer_cost_total" widget="monetary"/></div>
                                </div>
                                <!-- Net -->
                                <div class="o_payrun_amount">
                                    <div class="o_payrun_label">Net Pay</div>
                                    <div class="o_payrun_value o_payrun_value_net"><field name="net_wage_total" widget="monetary"/></div>
                                </div>
                                <!-- State Badge: Ready / Done / Paid -->
                                <div class="o_payrun_status">
                                    <span t-if="record.state.raw_value == 'draft'" class="o_payrun_pill o_payrun_pill_draft">Ready</span>
                                    <span t-elif="record.state.raw_value == 'confirmed' || record.state.raw_value == 'close'" class="o_payrun_pill o_payrun_pill_done">Done</span>
                                    <span t-elif="record.state.raw_value == 'paid'" class="o_payrun_pill o_payrun_pill_paid">Paid</span>
                                </div>
                                <!-- Action Buttons -->
                                <div class="o_payrun_actions" onclick="event.stopPropagation();">
                                    <!-- Validate (every Draft pay run) -->
                                    <button t-if="record.show_validate_btn.raw_value" name="action_batch_validate" type="object"
                                            class="btn btn-sm o_payrun_btn o_payrun_btn_primary"
                                            confirm="Are you sure you want to validate this pay run?">
                                        <i class="oi me-1" data-icon="check"/>Validate
                                    </button>
                                    <!-- Mark as Paid (Confirmed/Done state) -->
                                    <button t-if="record.state.raw_value == 'confirmed' || record.state.raw_value == 'close'" name="action_pay_payrun" type="object"
                                            class="btn btn-sm o_payrun_btn o_payrun_btn_secondary"
                                            confirm="Mark this pay run as Paid?">
                                        Mark as Paid
                                    </button>
                                    <!-- Pay (Confirmed/Done state, generates advice) -->
                                    <button t-if="record.show_payment_advice_btn.raw_value" name="action_open_pay_wizard" type="object"
                                            class="btn btn-sm o_payrun_btn o_payrun_btn_primary">
                                        Pay
                                    </button>
                                    <!-- Mark as Unpaid (Paid state) -->
                                    <button t-if="record.state.raw_value == 'paid'" name="action_revert_paid" type="object"
                                            class="btn btn-sm o_payrun_btn o_payrun_btn_secondary"
                                            confirm="Are you sure you want to revert this pay run to Confirmed?">
                                        Mark as Unpaid
                                    </button>
                                </div>
                                <!-- Three vertical dots dropdown -->
                                <div class="dropdown o_payrun_menu" onclick="event.stopPropagation();">
                                    <a class="o_payrun_menu_toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
                                        <i class="oi" data-icon="more_vert"/>
                                    </a>
                                        <div class="dropdown-menu dropdown-menu-end shadow-sm" role="menu">
                                            <!-- Duplicate Payslips actions in Kanban dropdown -->
                                            <a t-if="record.has_duplicate_payslips.raw_value" role="menuitem" type="object" name="action_open_duplicate_payslips" class="dropdown-item text-warning">
                                                <i class="oi me-2" data-icon="content_copy"/>View Duplicates (<t t-out="record.duplicate_payslip_count.value"/>)
                                            </a>
                                            <a t-if="record.has_duplicate_payslips.raw_value and record.state.raw_value == 'draft'" role="menuitem" type="object" name="action_remove_duplicate_payslips" class="dropdown-item text-danger" confirm="Are you sure you want to remove all duplicate payslips from this pay run?">
                                                <i class="oi me-2" data-icon="delete"/>Remove Duplicates
                                            </a>
                                            <div t-if="record.has_duplicate_payslips.raw_value" class="dropdown-divider"/>
                                            <a t-if="record.show_validate_btn.raw_value" role="menuitem" type="object" name="action_batch_validate" class="dropdown-item">
                                                <i class="oi me-2 text-success" data-icon="check"/>Validate
                                            </a>
                                            <a t-if="record.state.raw_value != 'draft'" role="menuitem" type="object" name="action_set_to_draft" class="dropdown-item">
                                                Reset to Draft
                                            </a>
                                            <a t-if="record.state.raw_value == 'paid'" role="menuitem" type="object" name="action_revert_paid" class="dropdown-item">
                                                Mark as Unpaid
                                            </a>
                                            <a t-if="record.state.raw_value == 'draft'" role="menuitem" type="delete" class="dropdown-item text-danger">
                                                <i class="oi me-2" data-icon="delete"/>Delete
                                            </a>
                                        </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--  PAY RUN FORM VIEW - Matching Screenshots 4 & 5              -->
        <!--  Header: Validate / Mark as Paid / Pay / Reset to Draft      -->
        <!--  Body: Payslip list with Employee, Worked, Cost, Net, Status -->
        <!-- ============================================================ -->
        <record id="hr_payslip_run_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <form string="Pay Run" class="o_payroll_payrun_form">
                    <header>
                        <!-- Validate button (draft state, payslips ready) -->
                        <button name="action_batch_validate" string="Validate" type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"
                                confirm="Are you sure you want to validate all payslips in this pay run?"/>



                        <!-- Test Print button (draft state with done slips) -->
                        <button name="action_test_print" string="Test Print" type="object"
                                class="btn-secondary"
                                invisible="state != 'draft' or not has_done_slips"
                                title="Print a test payslip"/>

                        <!-- Mark as Paid (confirmed state) -->
                        <button name="action_pay_payrun" string="Mark as Paid" type="object"
                                class="btn-primary"
                                invisible="state != 'confirmed'"
                                confirm="Mark this pay run as paid?"/>

                        <!-- Pay / Generate Payment Advice -->
                        <button name="action_open_pay_wizard" string="Pay" type="object"
                                class="btn-primary"
                                invisible="not show_payment_advice_btn"/>

                        <!-- Send Payslips by Email (each employee gets their own payslip PDF) -->
                        <button name="action_send_payslips_email" string="Send by Email" type="object"
                                class="btn-secondary"
                                invisible="state not in ('confirmed', 'paid')"
                                confirm="Email each employee their payslip (PDF attached)?"
                                title="Email the validated / paid payslips of this pay run to their employees"/>

                        <!-- Print Payslips (batch print 1 page per employee) -->
                        <button name="action_open_payslips" string="Print Payslips" type="object"
                                class="btn-secondary"
                                invisible="not slip_ids"
                                title="Open payslips to select and print in a single multi-page PDF (1 page per employee)"/>

                        <!-- Reset to Draft -->
                        <button name="action_set_to_draft" string="Reset to Draft" type="object"
                                class="btn-secondary"
                                invisible="state == 'draft'"
                                confirm="Reset this pay run and all its payslips back to Draft?"/>
                    </header>

                    <sheet>
                        <!-- Hidden fields for logic and inheritance compatibility -->
                        <field name="state" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="show_payment_advice_btn" invisible="1"/>
                        <field name="has_done_slips" invisible="1"/>
                        <field name="slips_all_done" invisible="1"/>
                        <field name="date_start" invisible="1"/>
                        <field name="date_end" invisible="1"/>
                        <field name="company_partner_id" invisible="1"/>
                        <field name="has_duplicate_payslips" invisible="1"/>
                        <field name="duplicate_payslip_count" invisible="1"/>
                        <field name="duplicate_employee_names" invisible="1"/>
                        <field name="company_bank_id" invisible="1"/>

                        <!-- Smart Button Box (required for hudson_payroll_account xpath) -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_payslips" class="oe_stat_button" icon="group" type="object"
                                    title="Open payslips in full list view to select multiple employees and print">
                                <field name="payslip_count" widget="statinfo" string="Payslips"/>
                            </button>
                        </div>

                        <!-- Alert Ribbon: Duplicate Payslips Detected -->
                        <div class="alert alert-warning mb-3 border-0 rounded-3 d-flex align-items-center py-2 px-3 shadow-sm"
                             role="alert"
                             invisible="not has_duplicate_payslips"
                             style="background-color: rgba(255, 193, 7, 0.18); border-left: 5px solid #ffc107 !important;">
                            <i class="fa fa-exclamation-triangle text-warning me-2 fs-5"/>
                            <div class="d-flex justify-content-between align-items-center w-100 flex-wrap gap-2">
                                <div>
                                    <span class="text-warning fw-bold">Duplicate Payslips Warning:</span>
                                    <span> This pay run includes <strong><field name="duplicate_payslip_count" class="oe_inline"/></strong> employee(s) for whom a payslip was already generated for this month (<field name="duplicate_employee_names" class="oe_inline"/>). Flagged as <strong>Duplicate</strong>.</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button name="action_open_duplicate_payslips" type="object" string="View Duplicates" class="btn btn-sm btn-outline-warning py-1 px-2 fw-semibold"/>
                                    <button name="action_remove_duplicate_payslips" type="object" string="Remove Duplicates" class="btn btn-sm btn-danger py-1 px-2 fw-semibold" invisible="state != 'draft'" confirm="Are you sure you want to remove all duplicate payslips from this pay run?"/>
                                </div>
                            </div>
                        </div>

                        <!-- Top Title & Status Banner -->
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h1 class="mb-1 fw-bold o_payrun_form_title" style="font-size: 26px; letter-spacing: -0.02em;">
                                    <field name="name" placeholder="e.g. Oct 2026 (IN)" class="oe_inline"/>
                                </h1>
                                <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
                                    <div class="o_payrun_chip chip-calendar">
                                        <span class="o_chip_icon">&#160;</span>
                                        <field name="period_summary_str" readonly="1" class="oe_inline"/>
                                    </div>
                                    <div class="o_payrun_chip chip-struct" invisible="not struct_id">
                                        <span class="o_chip_icon">&#160;</span>
                                        <field name="struct_id" readonly="1" class="oe_inline"/>
                                    </div>
                                    <div class="o_payrun_chip chip-company" groups="base.group_multi_company">
                                        <span class="o_chip_icon">&#160;</span>
                                        <field name="company_id" readonly="1" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                            <!-- State Indicator Pill on the top right -->
                            <div class="pt-1">
                                <span invisible="state != 'draft'" class="badge rounded-pill px-3 py-2 fw-semibold o_payrun_state_badge o_payrun_state_badge_draft">
                                    Ready (Draft)
                                </span>
                                <span invisible="state not in ('confirmed', 'close')" class="badge rounded-pill px-3 py-2 fw-semibold o_payrun_state_badge o_payrun_state_badge_done">
                                    Confirmed (Done)
                                </span>
                                <span invisible="state != 'paid'" class="badge rounded-pill px-3 py-2 fw-semibold o_payrun_state_badge o_payrun_state_badge_paid">
                                    Paid
                                </span>
                            </div>
                        </div>

                        <!-- Executive Financial Metric KPI Cards -->
                        <div class="row g-3 mb-4">
                            <!-- Card 1: Total Cost (Employer Outlay) -->
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="o_payrun_kpi_card card-cost">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="o_kpi_label">Total Cost</span>
                                        <div class="o_kpi_circle">&#160;</div>
                                    </div>
                                    <div class="fs-4 fw-bold mt-1 o_kpi_value" style="letter-spacing: -0.02em;">
                                        <field name="employer_cost_total" widget="monetary"/>
                                    </div>
                                    <div class="o_kpi_subtext">Employer Total Outlay</div>
                                </div>
                            </div>

                            <!-- Card 2: Net Pay (Employees Take Home) -->
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="o_payrun_kpi_card card-net">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="o_kpi_label">Net Pay</span>
                                        <div class="o_kpi_circle">&#160;</div>
                                    </div>
                                    <div class="fs-4 fw-bold mt-1 o_kpi_value o_kpi_value_net" style="letter-spacing: -0.02em;">
                                        <field name="net_wage_total" widget="monetary"/>
                                    </div>
                                    <div class="o_kpi_subtext">Employee Take-Home</div>
                                </div>
                            </div>

                            <!-- Card 3: Gross Wage -->
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="o_payrun_kpi_card card-gross">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="o_kpi_label">Gross Wage</span>
                                        <div class="o_kpi_circle">&#160;</div>
                                    </div>
                                    <div class="fs-4 fw-bold mt-1 o_kpi_value o_kpi_value_gross" style="letter-spacing: -0.02em;">
                                        <field name="gross_wage_total" widget="monetary"/>
                                    </div>
                                    <div class="o_kpi_subtext">Total Gross Earnings</div>
                                </div>
                            </div>

                            <!-- Card 4: Employees Count -->
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="o_payrun_kpi_card card-emp">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="o_kpi_label">Employees</span>
                                        <div class="o_kpi_circle">&#160;</div>
                                    </div>
                                    <div class="fs-4 fw-bold mt-1 o_kpi_value" style="letter-spacing: -0.02em;">
                                        <field name="payslip_count"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="o_kpi_subtext">Covered in Pay Run</span>
                                        <button name="action_open_payslips" type="object"
                                                class="btn btn-link p-0 text-decoration-none small text-primary fw-semibold"
                                                style="font-size: 11px;"
                                                title="View all payslips in full list view">
                                            View List &#8594;
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== Payslips Table Container ===== -->
                        <div class="rounded-3 shadow-sm overflow-hidden o_payrun_slips_panel">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 o_payrun_slips_head">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="o_table_header_icon">&#160;</span>
                                    <span class="fw-bold o_payrun_form_title" style="font-size: 14px;">Payslips</span>
                                    <span class="o_payrun_count_badge">
                                        <field name="payslip_count"/>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button name="action_open_payslips" type="object" string="Select &amp; Print"
                                            class="btn btn-sm btn-outline-primary py-1 px-3 fw-semibold shadow-none"
                                            title="Open full payslips list to select multiple employees and print batch PDF">
                                        <i class="fa fa-list me-1"/> Select &amp; Print
                                    </button>
                                </div>
                            </div>
                            <field name="slip_ids" nolabel="1">
                                <list string="Payslips" default_order="employee_id asc" create="false" delete="false"
                                      decoration-warning="display_status == 'Warning'"
                                      decoration-muted="state == 'cancel'">
                                    <header>
                                        <button name="action_print_payslip"
                                                type="object"
                                                string="Print"
                                                class="btn-secondary"
                                                title="Print payslips for selected employee(s) in a single multi-page PDF"/>
                                    </header>
                                    <field name="state" column_invisible="True"/>
                                    <field name="has_duplicate_payslip" column_invisible="True"/>
                                    <field name="duplicate_payslip_id" column_invisible="True"/>
                                    <field name="number" string="Payslip #" optional="show" class="fw-semibold text-primary"/>
                                    <field name="employee_id" widget="many2one_avatar_employee" string="Employee" class="fw-semibold"/>
                                    <field name="total_worked_days" string="Worked Days" optional="show"/>
                                    <field name="total_cost" string="Total Cost" widget="monetary" sum="Total Cost" optional="show" class="fw-semibold"/>
                                    <field name="basic_wage" string="Basic Wage" widget="monetary" sum="Total Basic" optional="show"/>
                                    <field name="net_wage" string="Net Wage" widget="monetary" sum="Total Net" optional="show" class="fw-bold text-success"/>
                                    <field name="display_status" string="Status" widget="badge"
                                           decoration-warning="display_status == 'Warning'"
                                           decoration-info="display_status == 'Draft'"
                                           decoration-success="display_status == 'Done'"
                                           decoration-muted="display_status == 'Paid'"/>
                                    <field name="payslip_warning" string="Warnings"
                                           decoration-warning="payslip_warning"/>
                                    <button name="action_print_payslip"
                                            type="object"
                                            icon="print"
                                            title="Print Payslip"
                                            class="text-primary"/>
                                    <button name="action_open_duplicate_payslip"
                                            type="object"
                                            icon="content_copy"
                                            title="View Conflicting Payslip"
                                            class="text-warning"
                                            invisible="not has_duplicate_payslip"/>
                                    <button name="action_remove_from_run"
                                            type="object"
                                            icon="delete"
                                            title="Remove from Pay Run"
                                            invisible="parent.state != 'draft'"
                                            confirm="Are you sure you want to remove this employee from this pay run?"/>
                                </list>
                            </field>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--  SEARCH VIEW                                                  -->
        <!-- ============================================================ -->
        <record id="hr_payslip_run_view_search" model="ir.ui.view">
            <field name="name">hr.payslip.run.search</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <search string="Search Pay Runs">
                    <field name="name" string="Pay Run"/>
                    <field name="company_bank_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Ready" name="ready" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                    <filter string="Done" name="done" domain="[('state', 'in', ('confirmed', 'paid', 'close'))]"/>
                    <separator/>
                    <filter string="This Month" name="this_month"
                            domain="[('date_start', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                     ('date_end', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                    <group>
                        <filter string="Status" name="state" context="{'group_by': 'state'}"/>
                        <filter string="Company" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

