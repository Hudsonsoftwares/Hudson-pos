<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit_project" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.project</field>
        <field name="model">helpdesk.management.ticket</field>
        <field name="inherit_id" ref="helpdesk_management_pro.helpdesk_management_pro_view_ticket_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_plan_intervention" type="object" string="Plan Intervention" invisible="not id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks" invisible="task_count == 0">
                    <field name="task_count" widget="statinfo" string="Tasks"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Action Menu: Convert to Task -->
    <record id="action_helpdesk_ticket_convert_task" model="ir.actions.act_window">
        <field name="name">Convert to Task</field>
        <field name="res_model">helpdesk.ticket.convert.task</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="helpdesk_management_pro.model_helpdesk_management_ticket"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
