<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Work Entry Type Form View to add Include in Leave Encashment Checkbox -->
    <record id="edit_holiday_status_form_inherit_hds_in_payroll" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.inherit.hds.in.payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
        <field name="priority" eval="9"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='configuration']" position="inside">
                <field name="include_in_leave_encashment" string="Include in Leave Encashment"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Work Entry Type Tree View to add Include in Leave Encashment Column -->
    <record id="view_holiday_status_normal_tree_inherit_hds_in_payroll" model="ir.ui.view">
        <field name="name">hr.work.entry.type.tree.inherit.hds.in.payroll</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_tree"/>
        <field name="priority" eval="9"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="include_in_leave_encashment" string="Include in Leave Encashment" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
