<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Salary Statement Report List View (Matches Screenshot 1) -->
    <record id="hds_salary_statement_report_view_tree" model="ir.ui.view">
        <field name="name">hds.salary.statement.report.view.tree</field>
        <field name="model">hds.salary.statement.report</field>
        <field name="arch" type="xml">
            <list string="Salary Statement Report">
                <field name="name" string="Description"/>
            </list>
        </field>
    </record>

    <!-- 2. Salary Statement Report Form View (Matches Screenshot 2) -->
    <record id="hds_salary_statement_report_view_form" model="ir.ui.view">
        <field name="name">hds.salary.statement.report.view.form</field>
        <field name="model">hds.salary.statement.report</field>
        <field name="arch" type="xml">
            <form string="Salary Statement Report">
                <header>
                    <button name="action_populate"
                            string="Populate"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees"
                                type="object"
                                class="oe_stat_button"
                                icon="group">
                            <field name="employee_count" widget="statinfo" string="Eligible Employees"/>
                        </button>
                    </div>

                    <group>
                        <field name="year" options="{'enable_formatting': False, 'format': False}"/>
                        <field name="month"/>
                        <field name="name" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Eligible Employees / Declarations List View (Matches Screenshot 3) -->
    <record id="hds_salary_statement_line_view_tree" model="ir.ui.view">
        <field name="name">hds.salary.statement.line.view.tree</field>
        <field name="model">hds.salary.statement.line</field>
        <field name="arch" type="xml">
            <list string="Employee Declarations" create="0" delete="0">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="pdf_file" filename="pdf_filename" widget="binary" string="PDF File"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <!-- 4. Individual Salary Statement Line Form View -->
    <record id="hds_salary_statement_line_view_form" model="ir.ui.view">
        <field name="name">hds.salary.statement.line.view.form</field>
        <field name="model">hds.salary.statement.line</field>
        <field name="arch" type="xml">
            <form string="Salary Statement" create="0">
                <header>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" readonly="1"/>
                            <field name="designation" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="date_of_joining" readonly="1"/>
                            <field name="salary_effective_from" readonly="1"/>
                        </group>
                        <group string="Report Information">
                            <field name="structure_name" readonly="1"/>
                            <field name="payroll_month" readonly="1"/>
                            <field name="pdf_file" filename="pdf_filename" widget="binary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_hds_salary_statement_report" model="ir.actions.act_window">
        <field name="name">Salary Statement Report</field>
        <field name="res_model">hds.salary.statement.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
