<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_version_view_form_inherit_hudson_in_payroll_tds" model="ir.ui.view">
        <field name="name">hr.version.form.inherit.hudson.in.payroll.tds</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <field name="hds_in_tds_applicable" string="Enable TDS"/>
            </xpath>
        </field>
    </record>
</odoo>
