<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================== -->
    <!--  Audit Trail – List View                                     -->
    <!--  Matches Odoo online Audit Trail: Date | Author | Name | Description -->
    <!-- =========================================================== -->
    <record id="hds_in_payroll_audit_view_tree" model="ir.ui.view">
        <field name="name">hds.in.payroll.audit.list</field>
        <field name="model">hds.in.payroll.audit</field>
        <field name="arch" type="xml">
            <list string="Audit Trail"
                  action="action_open_employee"
                  type="object"
                  create="false"
                  edit="false"
                  delete="true"
                  decoration-danger="status == 'error'"
                  decoration-warning="status == 'warning'">

                <!-- Date column – timestamp when the change or calculation was made -->
                <field name="create_date"
                       string="Date"
                       widget="datetime"
                       optional="show"/>

                <!-- Author column – who triggered the calculation -->
                <field name="user_id"
                       string="Author"
                       widget="many2one_avatar_user"
                       optional="show"/>

                <!-- Name column – employee name, clicking navigates to employee form -->
                <field name="employee_id"
                       string="Name"
                       optional="show"/>

                <!-- Description column – rendered HTML diffs -->
                <field name="description_html"
                       string="Description"
                       widget="html"
                       optional="show"
                       nolabel="1"/>

                <!-- Hidden helper fields used for decorations/filters -->
                <field name="status" column_invisible="1"/>
                <field name="statutory_module" optional="hide"/>
                <field name="rule_code" optional="hide"/>
                <field name="payslip_id" optional="hide"/>
                <field name="execution_time_ms" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- =========================================================== -->
    <!--  Audit Trail – Search View                                   -->
    <!-- =========================================================== -->
    <record id="hds_in_payroll_audit_view_search" model="ir.ui.view">
        <field name="name">hds.in.payroll.audit.search</field>
        <field name="model">hds.in.payroll.audit</field>
        <field name="arch" type="xml">
            <search string="Search Audit Trail">
                <field name="employee_id" string="Employee"/>
                <field name="user_id" string="Author"/>
                <field name="payslip_id"/>
                <field name="rule_code"/>
                <field name="statutory_module"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <!-- Status filters -->
                <filter string="Success"
                        name="filter_success"
                        domain="[('status', '=', 'success')]"/>
                <filter string="Warnings"
                        name="filter_warning"
                        domain="[('status', '=', 'warning')]"/>
                <filter string="Errors"
                        name="filter_error"
                        domain="[('status', '=', 'error')]"/>

                <separator/>

                <!-- Module filters -->
                <filter string="EPF"
                        name="filter_epf"
                        domain="[('statutory_module', '=', 'epf')]"/>
                <filter string="ESIC"
                        name="filter_esic"
                        domain="[('statutory_module', '=', 'esic')]"/>
                <filter string="Professional Tax"
                        name="filter_pt"
                        domain="[('statutory_module', '=', 'pt')]"/>
                <filter string="Income Tax (TDS)"
                        name="filter_tds"
                        domain="[('statutory_module', '=', 'tds')]"/>
                <filter string="LWF"
                        name="filter_lwf"
                        domain="[('statutory_module', '=', 'lwf')]"/>
                <filter string="Gratuity"
                        name="filter_gratuity"
                        domain="[('statutory_module', '=', 'gratuity')]"/>
                <filter string="Salary Revision"
                        name="filter_revision"
                        domain="[('statutory_module', '=', 'revision')]"/>

                <!-- Group By -->
                <group>
                    <filter string="Employee"
                            name="group_by_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Author"
                            name="group_by_author"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Date"
                            name="group_by_date"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter string="Effective Date"
                            name="group_by_calc_date"
                            context="{'group_by': 'calculation_date'}"/>
                    <filter string="Statutory Module"
                            name="group_by_module"
                            context="{'group_by': 'statutory_module'}"/>
                    <filter string="Rule Code"
                            name="group_by_rule"
                            context="{'group_by': 'rule_code'}"/>
                    <filter string="Status"
                            name="group_by_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Company"
                            name="group_by_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =========================================================== -->
    <!--  Audit Trail – Window Action                                 -->
    <!-- =========================================================== -->
    <record id="hds_in_payroll_audit_action" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">hds.in.payroll.audit</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="hds_in_payroll_audit_view_search"/>
        <field name="context">{'search_default_group_by_employee': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit trail records found.
            </p>
            <p>
                Audit trail entries are generated automatically when payslips
                are computed for statutory compliance calculations (EPF, ESIC, PT, TDS, LWF &amp; more).
            </p>
        </field>
    </record>

    <!-- =========================================================== -->
    <!--  Audit Trail – Menu Item under Operations                    -->
    <!-- =========================================================== -->
    <menuitem id="menu_hds_in_payroll_audit"
              name="Audit Trail"
              action="hds_in_payroll_audit_action"
              parent="hudson_payroll_base.menu_hr_payroll_operations"
              sequence="40"/>
</odoo>
