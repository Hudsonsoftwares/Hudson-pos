<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Final Settlement Salary Structure inheriting Base Structure -->
        <record id="hds_in_structure_final_settlement" model="hr.payroll.structure">
            <field name="name">Final Settlement Payroll</field>
            <field name="code">FINAL_SETTLEMENT_STRUCT</field>
            <field name="parent_id" ref="hudson_payroll_base.structure_base"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Gratuity Statutory Allowance Rule -->
        <record id="hds_in_rule_gratuity" model="hr.salary.rule">
            <field name="name">Gratuity</field>
            <field name="code">GRATUITY</field>
            <field name="sequence" eval="85"/>
            <field name="category_id" ref="hudson_payroll_base.rule_category_alw"/>
            <field name="struct_id" ref="hds_in_structure_final_settlement"/>
            <field name="company_id" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = payslip_record.hds_in_compute_gratuity() if payslip_record else payslip.hds_in_compute_gratuity()]]></field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Exit Leave Encashment Allowance Rule for Final Settlement -->
        <record id="hds_in_rule_exit_leave_encash" model="hr.salary.rule">
            <field name="name">Leave Encashment (Settlement)</field>
            <field name="code">EXIT_LEAVE_ENCASH</field>
            <field name="sequence" eval="86"/>
            <field name="category_id" ref="hudson_payroll_base.rule_category_alw"/>
            <field name="struct_id" ref="hds_in_structure_final_settlement"/>
            <field name="company_id" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = payslip_record.hds_in_compute_exit_leave_encashment() if payslip_record else payslip.hds_in_compute_exit_leave_encashment()]]></field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <!-- TDS on Gratuity (Section 192) - Retired in favor of Unified Annual TDS (HDS_IN_TDS) -->
        <record id="hds_in_rule_tds_gratuity" model="hr.salary.rule">
            <field name="name">TDS on Gratuity (Section 192)</field>
            <field name="code">TDS_GRATUITY</field>
            <field name="sequence" eval="191"/>
            <field name="category_id" ref="hudson_payroll_base.rule_category_ded"/>
            <field name="struct_id" ref="hds_in_structure_final_settlement"/>
            <field name="company_id" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = 0.0]]></field>
            <field name="appears_on_payslip" eval="False"/>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
