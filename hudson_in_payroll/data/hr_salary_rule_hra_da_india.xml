            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[result = bool(getattr(contract, 'benefit_phone', 0.0) and contract.benefit_phone > 0.0)]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = float(getattr(contract, 'benefit_phone', 0.0) or 0.0)]]></field>
