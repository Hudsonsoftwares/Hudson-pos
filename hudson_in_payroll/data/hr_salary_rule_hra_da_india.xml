        <!-- India-specific components.
             Reads from contract/version salary breakdown (contract.hra / contract.da / contract.fixed_allowance)
             with automatic fallback to company policy percentages of BASIC if not set. -->
        <record id="hr_rule_hra_india" model="hr.salary.rule">
            <field name="name">House Rent Allowance</field>
            <field name="code">HRA</field>
            <field name="sequence">15</field>
            <field name="category_id" ref="hudson_payroll_base.rule_category_alw"/>
            <field name="struct_id" ref="hudson_payroll_base.structure_base"/>
            <field name="company_id" eval="False"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
nominal = contract.hra or 0.0
if nominal > 0.0:
    sched_data = payslip._get_attendance_vs_schedule(contract, payslip.date_from, payslip.date_to)
    total_sched = sched_data.get('total_period_scheduled_hours') or (sched_data.get('scheduled_hours', 0.0) + sched_data.get('out_of_contract_hours', 0.0))
    if contract.pay_by_attendance:
        work_line = worked_days.WORK100
        earned_hours = work_line.number_of_hours if work_line else 0.0
        result = round(nominal * (earned_hours / total_sched), 2) if total_sched > 0.0 else 0.0
    else:
        factor = payslip._get_fixed_salary_attendance_factor(contract)
        result = round(nominal * factor, 2)
else:
    result = 0.0
]]></field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

