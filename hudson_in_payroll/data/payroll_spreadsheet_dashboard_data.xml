<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Former dashboard group. The Payroll dashboard now lives in the standard Human Resources group
         (module hudson_payroll_spreadsheet_dashboard). Odoo does not allow deleting a dashboard group
         that has an XML ID, so the record stays; without dashboards it is not shown in the Dashboards app. -->
    <record id="spreadsheet_dashboard_group_hr_payroll" model="spreadsheet.dashboard.group">
        <field name="name">Human Resources</field>
        <field name="sequence">30</field>
    </record>
</odoo>
