<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Declaration Report Action -->
    <record id="action_report_statutory_tax_declaration" model="ir.actions.report">
        <field name="name">Statutory Tax Calculation Report</field>
        <field name="model">tds.employee.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_in_payroll.report_statutory_tax_calculation</field>
<field name="print_report_name">'Statutory_Tax_Report_%s' % (object.employee_id.name or 'Employee')</field>
        <field name="binding_model_id" ref="model_tds_employee_declaration"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Payslip Report Action -->
    <record id="action_report_statutory_tax_payslip" model="ir.actions.report">
        <field name="name">Tax Calculation Report</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_in_payroll.report_statutory_tax_payslip</field>
<field name="print_report_name">'Tax_Report_%s' % (object.employee_id.name or 'Employee')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Payslip Report Template Alias -->
    <template id="report_statutory_tax_payslip">
        <t t-call="hudson_in_payroll.report_statutory_tax_calculation"/>
    </template>

    <!-- Generic Alias Action -->
    <record id="action_report_statutory_tax_calculation" model="ir.actions.report">
        <field name="name">Statutory Tax Calculation Report</field>
        <field name="model">tds.employee.declaration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_in_payroll.report_statutory_tax_calculation</field>
<field name="print_report_name">'Statutory_Tax_Report_%s' % (object.employee_id.name or 'Employee')</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MAIN QWEB REPORT TEMPLATE                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <template id="report_statutory_tax_calculation">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="r">
                <t t-set="o" t-value="r['declaration']"/>
                <t t-call="web.external_layout">
                    <div class="page hds-tr">
                        <!-- Tables only (wkhtmltopdf has no reliable flex/grid); solid colours (no gradients) -->
                        <style>
                            .hds-tr { font-family: 'Lato', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10.5px; color: #1f2937; line-height: 1.45; }
                            .hds-tr table { width: 100%; border-collapse: collapse; border: 0 !important; }
                            .hds-tr table td, .hds-tr table th { border-top: 0 !important; border-left: 0 !important; border-right: 0 !important; }
                            .hds-tr .tr-title td, .hds-tr .sign td, .hds-tr .card .ch td { border-bottom: 0 !important; }
                            .hds-tr .kpi td { border: 1px solid #d8dde6 !important; }
                            .hds-tr .kpi td.hl { border-color: #1f3a5f !important; }
                            .hds-tr .card .am td { border-right: 1px solid #e5e7eb !important; }
                            .hds-tr .card .am td.last { border-right: 0 !important; }
                            .hds-tr .card .sub-t td, .hds-tr .card .sub-t th { border: 1px solid #e5e7eb !important; }
                            .hds-tr .card .det td { border-bottom: 0 !important; }
                            .hds-tr .tr-title { background: #1f3a5f; color: #ffffff; padding: 12px 16px; border-radius: 4px; margin-bottom: 14px; }
                            .hds-tr .tr-title td { vertical-align: middle; }
                            .hds-tr .tr-title .t { font-size: 16px; font-weight: bold; color: #ffffff; }
                            .hds-tr .tr-title .s { font-size: 9.5px; color: #c7d2e3; margin-top: 2px; }
                            .hds-tr .tr-title .m { text-align: right; font-size: 9.5px; color: #c7d2e3; line-height: 1.6; }
                            .hds-tr .tr-title .m b { color: #ffffff; }
                            .hds-tr .sec { margin-bottom: 14px; page-break-inside: avoid; }
                            .hds-tr .sec-h { font-size: 10.5px; font-weight: bold; color: #1f3a5f; text-transform: uppercase; letter-spacing: 0.5px; padding-bottom: 4px; border-bottom: 2px solid #1f3a5f; }
                            .hds-tr .kv td { padding: 5px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
                            .hds-tr .kv td.k { width: 17%; color: #6b7280; }
                            .hds-tr .kv td.v { width: 33%; font-weight: bold; color: #1f2937; }
                            .hds-tr .kpi td { width: 25%; padding: 8px 10px; border: 1px solid #d8dde6; background: #f8fafc; vertical-align: top; }
                            .hds-tr .kpi .l { font-size: 8.5px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.4px; }
                            .hds-tr .kpi .v { font-size: 14px; font-weight: bold; color: #1f3a5f; margin-top: 2px; }
                            .hds-tr .kpi td.hl { background: #1f3a5f; border-color: #1f3a5f; }
                            .hds-tr .kpi td.hl .l { color: #c7d2e3; }
                            .hds-tr .kpi td.hl .v { color: #ffffff; }
                            .hds-tr .ln td { padding: 5px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
                            .hds-tr .ln td.a { width: 26%; text-align: right; white-space: nowrap; }
                            .hds-tr .ln tr.sub td.d { padding-left: 22px; color: #374151; }
                            .hds-tr .ln tr.minus td.a { color: #374151; }
                            .hds-tr .ln tr.tot td { font-weight: bold; background: #f1f4f8; border-top: 1px solid #c5cdd8; border-bottom: 1px solid #c5cdd8; }
                            .hds-tr .ln tr.grand td { font-weight: bold; background: #1f3a5f; color: #ffffff; font-size: 11.5px; border-bottom: 0; }
                            .hds-tr .ln tr.grp td { font-size: 9px; font-weight: bold; color: #1f3a5f; text-transform: uppercase; letter-spacing: 0.4px; background: #f8fafc; }
                            .hds-tr .note { display: block; font-size: 8.5px; color: #6b7280; font-weight: normal; }
                            .hds-tr .badge { display: inline-block; padding: 1px 7px; border-radius: 3px; font-size: 8.5px; font-weight: bold; color: #ffffff; background: #1f3a5f; letter-spacing: 0.3px; }
                            .hds-tr .badge.green { background: #15803d; }
                            .hds-tr .badge.orange { background: #c2410c; }
                            .hds-tr .badge.red { background: #b42318; }
                            .hds-tr .badge.grey { background: #6b7280; }
                            .hds-tr .card { border: 1px solid #d8dde6; border-radius: 3px; margin-top: 8px; page-break-inside: avoid; }
                            .hds-tr .card .ch td { background: #f1f4f8; padding: 6px 8px; border-bottom: 1px solid #d8dde6; vertical-align: middle; }
                            .hds-tr .card .ch .n { font-weight: bold; color: #1f2937; }
                            .hds-tr .card .am td { width: 33.33%; padding: 5px 8px; text-align: center; border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; }
                            .hds-tr .card .am td.last { border-right: 0; }
                            .hds-tr .card .am .l { font-size: 8.5px; color: #6b7280; }
                            .hds-tr .card .am .v { font-size: 11px; font-weight: bold; }
                            .hds-tr .card .blk { padding: 5px 8px; border-bottom: 1px solid #e5e7eb; }
                            .hds-tr .card .blk-h { font-size: 8.5px; font-weight: bold; color: #1f3a5f; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 2px; }
                            .hds-tr .card .det td { padding: 2px 4px; font-size: 9.5px; vertical-align: top; }
                            .hds-tr .card .det td.k { width: 45%; color: #6b7280; }
                            .hds-tr .card .det td.v { font-weight: bold; }
                            .hds-tr .card .sub-t td, .hds-tr .card .sub-t th { padding: 3px 5px; font-size: 9px; border: 1px solid #e5e7eb; }
                            .hds-tr .card .sub-t th { background: #f8fafc; color: #374151; text-align: left; }
                            .hds-tr .card .sub-t .r { text-align: right; white-space: nowrap; }
                            .hds-tr .card .concl { padding: 5px 8px; font-size: 9.5px; color: #374151; }
                            .hds-tr .card .concl b { color: #1f3a5f; }
                            .hds-tr .empty { padding: 10px; text-align: center; color: #6b7280; border: 1px dashed #c5cdd8; border-radius: 3px; margin-top: 8px; }
                            .hds-tr .pos { color: #15803d; }
                            .hds-tr .neg { color: #b42318; }
                            .hds-tr .sign { margin-top: 26px; page-break-inside: avoid; }
                            .hds-tr .sign td { width: 50%; text-align: center; vertical-align: bottom; padding: 30px 20px 0 20px; }
                            .hds-tr .sign .line { border-top: 1px solid #6b7280; margin: 0 30px 4px 30px; }
                            .hds-tr .sign .who { font-size: 9.5px; font-weight: bold; color: #374151; }
                            .hds-tr .sign .sub { font-size: 9px; color: #6b7280; }
                            .hds-tr .foot { text-align: center; font-size: 8.5px; color: #9ca3af; margin-top: 10px; }
                        </style>

                        <t t-set="emp" t-value="r['employee']"/>
                        <t t-set="has_payslip" t-value="r['payslip_name'] and r['payslip_name'] != 'N/A' and not r['payslip_name'].startswith('No Payslip')"/>
                        <t t-set="has_period" t-value="r['payroll_month'] and r['payroll_month'] != 'N/A'"/>
                        <t t-set="fy_label" t-value="(r['financial_year'].name or '').replace('Tax Year:', '').strip() if r['financial_year'] else ''"/>

                        <!-- TITLE -->
                        <div class="tr-title">
                            <table>
                                <tr>
                                    <td style="width: 65%;">
                                        <div class="t">Income Tax Calculation Report</div>
                                        <div class="s">Tax deducted at source (TDS) on salary<t t-if="fy_label"> &#183; Tax Year <t t-out="fy_label"/></t></div>
                                    </td>
                                    <td class="m" style="width: 35%;">
                                        Generated on <b><t t-out="r['generated_on']"/></b><br/>
                                        by <b><t t-out="r['generated_by']"/></b>
                                        <t t-if="r['declaration']"><br/>Declaration <b><t t-out="r['declaration_name']"/></b></t>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- EMPLOYEE & PAYROLL DETAILS -->
                        <div class="sec">
                            <div class="sec-h">Employee &amp; Payroll Details</div>
                            <table class="kv">
                                <tr>
                                    <td class="k">Employee</td>
                                    <td class="v"><t t-out="emp.name"/></td>
                                    <td class="k">Employee ID</td>
                                    <td class="v"><t t-out="emp.barcode or emp.id"/></td>
                                </tr>
                                <tr t-if="emp.department_id or emp.job_id">
                                    <td class="k">Department</td>
                                    <td class="v"><t t-out="emp.department_id.name or '—'"/></td>
                                    <td class="k">Designation</td>
                                    <td class="v"><t t-out="emp.job_id.name or '—'"/></td>
                                </tr>
                                <tr>
                                    <td class="k">Tax Year</td>
                                    <td class="v"><t t-out="fy_label or '—'"/></td>
                                    <td class="k">Assessment Year</td>
                                    <td class="v"><t t-out="r['assessment_year']"/></td>
                                </tr>
                                <tr>
                                    <td class="k">Tax Regime</td>
                                    <td class="v" colspan="3">
                                        <span t-attf-class="badge #{'green' if r['regime_code'] == 'NEW' else ''}"><t t-out="r['regime_code']"/></span>
                                        <span style="margin-left: 6px;"><t t-out="r['regime_label']"/></span>
                                    </td>
                                </tr>
                                <tr t-if="has_period">
                                    <td class="k">Payroll Month</td>
                                    <td class="v"><t t-out="r['payroll_month']"/></td>
                                    <td class="k">Period</td>
                                    <td class="v"><t t-out="r['payslip_date_from']"/> &#8594; <t t-out="r['payslip_date_to']"/></td>
                                </tr>
                                <tr>
                                    <td class="k"><t t-if="has_payslip">Payslip</t><t t-else="">Evaluation Date</t></td>
                                    <td class="v"><t t-out="r['payslip_name'] if has_payslip else r['eval_date']"/></td>
                                    <td class="k">TDS Mode</td>
                                    <td class="v">
                                        <span t-attf-class="badge #{'green' if r['tds_mode'] == 'NORMAL PROJECTED' else ('red' if r['tds_mode'] == 'JANUARY RECALCULATION' else 'orange')}"><t t-out="r['tds_mode']"/></span>
                                    </td>
                                </tr>
                                <tr t-if="r['declaration']">
                                    <td class="k">Declaration Status</td>
                                    <td class="v"><t t-out="r['declaration_state']"/></td>
                                    <td class="k">Submitted On</td>
                                    <td class="v"><t t-out="r['submission_date']"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- KEY FIGURES -->
                        <div class="sec">
                            <table class="kpi">
                                <tr>
                                    <td><div class="l">Gross Total Income</div><div class="v"><t t-out="'{:,.2f}'.format((r['gross_total_income']) or 0.0)"/></div></td>
                                    <td><div class="l">Net Taxable Income</div><div class="v"><t t-out="'{:,.2f}'.format((r['net_taxable_income']) or 0.0)"/></div></td>
                                    <td><div class="l">Annual Tax Liability</div><div class="v"><t t-out="'{:,.2f}'.format((r['total_annual_tax']) or 0.0)"/></div></td>
                                    <td class="hl"><div class="l">TDS This Month (INR)</div><div class="v"><t t-out="'{:,.2f}'.format((r['current_month_tds']) or 0.0)"/></div></td>
                                </tr>
                            </table>
                        </div>

                        <!-- INCOME TO TAXABLE INCOME -->
                        <div class="sec">
                            <div class="sec-h">Taxable Income</div>
                            <table class="ln">
                                <tr>
                                    <td class="d">Projected annual salary (current employer)</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['gross_current_salary']) or 0.0)"/></td>
                                </tr>
                                <tr t-if="r.get('sec_17_2_vii_perquisite', 0) &gt; 0">
                                    <td class="d">
                                        Taxable perquisite: employer contributions above the ceiling [Section 17(2)(vii)]
                                        <span class="note">Employer EPF + NPS <t t-out="'{:,.2f}'.format((r.get('combined_employer_contribution', 0.0)) or 0.0)"/> &#8722; ceiling <t t-out="'{:,.2f}'.format((r.get('combined_ceiling')) or 0.0)"/></span>
                                    </td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['sec_17_2_vii_perquisite']) or 0.0)"/></td>
                                </tr>
                                <tr t-if="r['prev_emp_income'] &gt; 0">
                                    <td class="d">Previous employer taxable salary</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['prev_emp_income']) or 0.0)"/></td>
                                </tr>
                                <t t-if="r.get('other_income_breakdown')">
                                    <tr class="grp"><td colspan="2">Income from other sources</td></tr>
                                    <tr class="sub" t-foreach="r['other_income_breakdown']" t-as="oib">
                                        <td class="d"><t t-out="oib[0]"/></td>
                                        <td class="a"><t t-out="'{:,.2f}'.format((oib[1]) or 0.0)"/></td>
                                    </tr>
                                </t>
                                <tr t-if="r['other_income'] &gt; 0 and not r.get('other_income_breakdown')">
                                    <td class="d">Other income (interest, rent, etc.)</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['other_income']) or 0.0)"/></td>
                                </tr>
                                <tr class="tot">
                                    <td class="d">Gross Total Income</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['gross_total_income']) or 0.0)"/></td>
                                </tr>
                                <t t-if="r['deduction_breakdown']">
                                    <tr class="grp"><td colspan="2">Less: deductions &amp; exemptions</td></tr>
                                    <tr class="sub minus" t-foreach="r['deduction_breakdown']" t-as="drow">
                                        <td class="d"><t t-out="drow[0]"/></td>
                                        <td class="a">(&#8722;) <t t-out="'{:,.2f}'.format((drow[1]) or 0.0)"/></td>
                                    </tr>
                                </t>
                                <tr t-if="r.get('rounding_factor')">
                                    <td class="d">Rounding to nearest INR 10 [Section 516, Income-tax Act, 2025]</td>
                                    <td class="a"><t t-out="'{:+,.2f}'.format(r['rounding_factor'])"/></td>
                                </tr>
                                <tr class="tot">
                                    <td class="d">Net Taxable Income</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['net_taxable_income']) or 0.0)"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- TAX COMPUTATION -->
                        <div class="sec">
                            <div class="sec-h">Tax Computation</div>
                            <table class="ln">
                                <tr>
                                    <td class="d">Income tax on net taxable income (slab rates)</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['base_tax']) or 0.0)"/></td>
                                </tr>
                                <t t-if="r['rebate_applicable']">
                                    <tr class="minus">
                                        <td class="d">Less: Section 87A rebate <span class="note">Taxable income up to INR <t t-out="'{:,.0f}'.format(r['rebate_limit'])"/></span></td>
                                        <td class="a">(&#8722;) <t t-out="'{:,.2f}'.format((r['rebate_applied']) or 0.0)"/></td>
                                    </tr>
                                    <tr class="tot">
                                        <td class="d">Tax after rebate</td>
                                        <td class="a"><t t-out="'{:,.2f}'.format((r['tax_after_rebate']) or 0.0)"/></td>
                                    </tr>
                                </t>
                                <tr t-if="r.get('surcharge_amount', 0) &gt; 0 or r.get('marginal_relief', 0) &gt; 0">
                                    <td class="d">Add: surcharge @ <t t-out="'{:.0f}'.format(r['surcharge_rate'])"/>%</td>
                                    <td class="a">(+) <t t-out="'{:,.2f}'.format((r.get('surcharge_before_relief', r['surcharge_amount'])) or 0.0)"/></td>
                                </tr>
                                <tr class="minus" t-if="r.get('marginal_relief', 0) &gt; 0">
                                    <td class="d">Less: marginal relief on surcharge</td>
                                    <td class="a">(&#8722;) <t t-out="'{:,.2f}'.format((r['marginal_relief']) or 0.0)"/></td>
                                </tr>
                                <tr>
                                    <td class="d">Add: health &amp; education cess<t t-if="r['cess_rate']"> @ <t t-out="'{:g}'.format(r['cess_rate'])"/>%</t></td>
                                    <td class="a">(+) <t t-out="'{:,.2f}'.format((r['cess_amount']) or 0.0)"/></td>
                                </tr>
                                <tr class="grand">
                                    <td class="d">Total Annual Tax Liability</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['total_annual_tax']) or 0.0)"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- TDS FOR THE MONTH -->
                        <div class="sec">
                            <div class="sec-h"><t t-if="has_period">TDS for <t t-out="r['payroll_month']"/></t><t t-else="">Monthly TDS</t></div>
                            <table class="ln">
                                <tr>
                                    <td class="d">Total annual tax liability</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['total_annual_tax']) or 0.0)"/></td>
                                </tr>
                                <tr class="minus" t-if="r['prev_employer_tds'] &gt; 0">
                                    <td class="d">Less: TDS deducted by previous employer</td>
                                    <td class="a">(&#8722;) <t t-out="'{:,.2f}'.format((r['prev_employer_tds']) or 0.0)"/></td>
                                </tr>
                                <tr class="minus" t-if="r['ytd_tds'] &gt; 0">
                                    <td class="d">Less: TDS already deducted this tax year</td>
                                    <td class="a">(&#8722;) <t t-out="'{:,.2f}'.format((r['ytd_tds']) or 0.0)"/></td>
                                </tr>
                                <tr class="tot">
                                    <td class="d">Remaining tax liability</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['remaining_liability']) or 0.0)"/></td>
                                </tr>
                                <tr>
                                    <td class="d">Remaining payroll months (including this month)</td>
                                    <td class="a"><t t-out="r['remaining_periods_incl_current']"/></td>
                                </tr>
                                <t t-if="r['tds_mode'] != 'NORMAL PROJECTED'">
                                    <tr class="grp"><td colspan="2">TDS recalculation schedule</td></tr>
                                    <tr class="sub"><td class="d">Recalculation from</td><td class="a"><t t-out="r['tds_recalc_from_month']"/></td></tr>
                                    <tr class="sub"><td class="d">Distribution months</td><td class="a"><t t-out="r['tds_distribution_months']"/></td></tr>
                                    <tr class="sub"><td class="d">Recalculation executed</td><td class="a"><t t-out="r['tds_recalc_executed']"/></td></tr>
                                    <tr class="sub"><td class="d">Annual tax at recalculation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_recalc_annual_tax']) or 0.0)"/></td></tr>
                                    <tr class="sub"><td class="d">TDS deducted till recalculation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_recalc_ytd_tds']) or 0.0)"/></td></tr>
                                    <tr class="sub"><td class="d">Remaining liability at recalculation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_recalc_remaining']) or 0.0)"/></td></tr>
                                    <tr class="sub" t-if="r['tds_jan_allocation'] &gt; 0"><td class="d">January allocation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_jan_allocation']) or 0.0)"/></td></tr>
                                    <tr class="sub" t-if="r['tds_feb_allocation'] &gt; 0"><td class="d">February allocation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_feb_allocation']) or 0.0)"/></td></tr>
                                    <tr class="sub" t-if="r['tds_mar_allocation'] &gt; 0"><td class="d">March allocation</td><td class="a"><t t-out="'{:,.2f}'.format((r['tds_mar_allocation']) or 0.0)"/></td></tr>
                                </t>
                                <tr class="grand">
                                    <td class="d">TDS Deducted This Month</td>
                                    <td class="a">INR <t t-out="'{:,.2f}'.format((r['current_month_tds']) or 0.0)"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- CHAPTER VI-A (only when something is claimed) -->
                        <div class="sec" t-if="r['chapter6a_total_display'] &gt; 0">
                            <div class="sec-h">Chapter VI-A Deductions</div>
                            <table class="ln">
                                <t t-foreach="r['chapter6a_rows']" t-as="c6row">
                                    <tr t-if="c6row[1] &gt; 0">
                                        <td class="d"><t t-out="c6row[0]"/></td>
                                        <td class="a"><t t-out="'{:,.2f}'.format((c6row[1]) or 0.0)"/></td>
                                    </tr>
                                </t>
                                <tr class="tot">
                                    <td class="d">Total Chapter VI-A deductions</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['chapter6a_total_display']) or 0.0)"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- DEDUCTION DETAILS (declared or allowed sections only) -->
                        <div class="sec" style="page-break-inside: auto;" t-if="r['declaration']">
                            <div class="sec-h" t-if="not r['relevant_traces']">Deduction Details</div>
                            <t t-foreach="r['relevant_traces']" t-as="trace">
                                <t t-set="fp" t-value="trace.get('is_family_pension')"/>
                                <div style="page-break-inside: avoid;">
                                <div class="sec-h" t-if="trace_first">Deduction Details</div>
                                <div class="card">
                                    <table class="ch">
                                        <tr>
                                            <td style="width: 78%;">
                                                <span class="n"><t t-out="trace['name']"/></span>
                                                <span class="note"><t t-out="trace['statutory_ref']"/></span>
                                            </td>
                                            <td style="width: 22%; text-align: right;">
                                                <t t-if="fp"><span class="badge">APPLIED</span></t>
                                                <t t-elif="trace['is_eligible'] and trace['declared'] &gt; 0 and trace['approved'] &gt;= trace['declared']"><span class="badge green">ELIGIBLE</span></t>
                                                <t t-elif="trace['is_eligible'] and trace['declared'] &gt; 0"><span class="badge orange">PARTIALLY ELIGIBLE</span></t>
                                                <t t-elif="trace['approved'] &gt; 0"><span class="badge">APPLIED</span></t>
                                                <t t-else=""><span class="badge red">NOT ELIGIBLE</span></t>
                                            </td>
                                        </tr>
                                    </table>
                                    <table class="am">
                                        <tr>
                                            <td><div class="l"><t t-out="'Pension received' if fp else 'Declared'"/></div><div class="v"><t t-out="'{:,.2f}'.format((trace['declared']) or 0.0)"/></div></td>
                                            <td><div class="l"><t t-out="'Deduction' if fp else 'Eligible'"/></div><div class="v pos"><t t-out="'{:,.2f}'.format((trace['approved']) or 0.0)"/></div></td>
                                            <td class="last"><div class="l"><t t-out="'Taxable' if fp else 'Disallowed'"/></div><div t-attf-class="v #{'' if fp else 'neg'}"><t t-out="'{:,.2f}'.format((trace.get('excess', 0.0)) or 0.0)"/></div></td>
                                        </tr>
                                    </table>
                                    <div class="blk" t-if="trace.get('inputs')">
                                        <div class="blk-h">Inputs</div>
                                        <table class="det">
                                            <tr t-foreach="trace['inputs']" t-as="inp">
                                                <td class="k"><t t-out="inp[0]"/></td>
                                                <td class="v"><t t-out="inp[1]"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="blk" t-if="trace.get('is_composite_80c') and trace.get('components_data')">
                                        <div class="blk-h">Section 80C components</div>
                                        <table class="sub-t">
                                            <tr>
                                                <th>Component</th>
                                                <th class="r">Declared</th>
                                                <th class="r">Eligible</th>
                                                <th>Rule</th>
                                                <th class="r">Considered</th>
                                            </tr>
                                            <tr t-foreach="trace['components_data']" t-as="cmp">
                                                <td><t t-out="cmp['name']"/></td>
                                                <td class="r"><t t-out="'{:,.2f}'.format((cmp['declared_amount']) or 0.0)"/></td>
                                                <td class="r"><t t-out="'{:,.2f}'.format((cmp['eligible_amount']) or 0.0)"/></td>
                                                <td><t t-out="cmp['applicable_rule']"/></td>
                                                <td class="r"><t t-out="'{:,.2f}'.format((cmp['amount_considered']) or 0.0)"/></td>
                                            </tr>
                                            <tr>
                                                <td colspan="2"><b>Total before cap</b> <t t-out="'{:,.2f}'.format((trace['composite_payload']['total_eligible_before_cap']) or 0.0)"/></td>
                                                <td colspan="2"><b>Ceiling</b> <t t-out="'{:,.2f}'.format((trace['composite_payload']['statutory_limit']) or 0.0)"/></td>
                                                <td class="r"><b><t t-out="'{:,.2f}'.format((trace['composite_payload']['final_eligible_deduction']) or 0.0)"/></b></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="blk" t-if="trace.get('formulas')">
                                        <div class="blk-h">Calculation</div>
                                        <table class="det">
                                            <tr t-foreach="trace['formulas']" t-as="form">
                                                <td class="k"><t t-out="form[0]"/></td>
                                                <td class="v"><t t-out="form[1]"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="concl" t-if="trace.get('reason')"><b>Conclusion:</b> <t t-out="trace['reason']"/></div>
                                </div>
                                </div>
                            </t>
                            <div class="empty" t-if="not r['relevant_traces']">
                                <t t-if="r['regime_code'] == 'NEW'">No deductions applicable under the New Tax Regime were declared.</t>
                                <t t-else="">No deductions were declared.</t>
                            </div>
                        </div>

                        <!-- DECLARATION RECONCILIATION (only when part of a declared amount was disallowed) -->
                        <div class="sec" t-if="r['total_excess'] &gt; 0">
                            <div class="sec-h">Declaration Reconciliation</div>
                            <table class="ln">
                                <tr>
                                    <td class="d">Total deductions declared</td>
                                    <td class="a"><t t-out="'{:,.2f}'.format((r['total_declared']) or 0.0)"/></td>
                                </tr>
                                <tr>
                                    <td class="d">Eligible / approved</td>
                                    <td class="a pos"><t t-out="'{:,.2f}'.format((r['total_eligible']) or 0.0)"/></td>
                                </tr>
                                <tr class="tot">
                                    <td class="d">Disallowed</td>
                                    <td class="a neg"><t t-out="'{:,.2f}'.format((r['total_excess']) or 0.0)"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- SIGNATURES -->
                        <div class="sign">
                            <table>
                                <tr>
                                    <td>
                                        <div class="line"/>
                                        <div class="who">Employee Signature</div>
                                        <div class="sub"><t t-out="emp.name"/></div>
                                    </td>
                                    <td>
                                        <div class="line"/>
                                        <div class="who">Authorised HR / Payroll Signatory</div>
                                        <div class="sub"><t t-out="emp.company_id.name or ''"/></div>
                                    </td>
                                </tr>
                            </table>
                            <div class="foot">System-generated report &#183; <t t-out="r['generated_on']"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
