<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_yearly_salary_employee_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.yearly.salary.employee.wizard.view.form</field>
        <field name="model">hds.yearly.salary.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Yearly Salary by Employee">
                <header>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="print"/>
                    <button name="action_export_xlsx"
                            string="Generate / Export XLSX"
                            type="object"
                            class="btn-success"
                            icon="download"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Selection Criteria">
                            <field name="year" required="1" options="{'enable_formatting': False, 'format': False}"/>
                            <field name="payslip_state" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" required="1" readonly="state != 'draft'"/>
                        </group>
                        <group string="Optional Filters">
                            <field name="department_id" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="job_id" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id), '|', ('department_id', '=', False), ('department_id', '=', department_id)]"/>
                        </group>
                    </group>

                    <group string="Summary Statistics" invisible="state == 'draft'">
                        <group>
                            <field name="record_count" readonly="1"/>
                            <field name="total_annual_gross" readonly="1"/>
                            <field name="total_annual_deductions" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_annual_net" readonly="1"/>
                            <field name="total_annual_cost" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Employees"/>
                    <p class="text-muted">
                        Select specific employees to include in the yearly salary report. Leave empty to automatically include all matching employees with payslips in the selected year.
                    </p>
                    <field name="available_employee_ids" invisible="1"/>
                    <field name="employee_ids" widget="many2many" domain="[('id', 'in', available_employee_ids)]">
                        <list string="Employees">
                            <field name="name" string="Employee Name"/>
                            <field name="department_id" string="Department" optional="show"/>
                            <field name="job_id" string="Job Position" optional="show"/>
                        </list>
                    </field>
                    <field name="xlsx_filename" invisible="1"/>
                    <field name="xlsx_file" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hds_yearly_salary_employee_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.yearly.salary.employee.wizard.view.list</field>
        <field name="model">hds.yearly.salary.employee.wizard</field>
        <field name="arch" type="xml">
            <list string="Yearly Salary Report History" default_order="id desc">
                <field name="name"/>
                <field name="year" optional="show" options="{'enable_formatting': False, 'format': False}"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="record_count" optional="show"/>
                <field name="total_annual_gross" optional="show"/>
                <field name="total_annual_deductions" optional="show"/>
                <field name="total_annual_net" optional="show"/>
                <field name="total_annual_cost" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'generated'"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hds_yearly_salary_employee_wizard" model="ir.actions.act_window">
        <field name="name">Yearly Salary by Employee</field>
        <field name="res_model">hds.yearly.salary.employee.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
