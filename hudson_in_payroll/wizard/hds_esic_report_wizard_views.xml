<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_esic_report_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.esic.report.wizard.view.form</field>
        <field name="model">hds.esic.report.wizard</field>
        <field name="arch" type="xml">
            <form string="ESI Report Wizard">
                <header>
                    <button name="action_generate_xlsx"
                            string="Export XLSX File"
                            type="object"
                            class="btn-primary"
                            icon="download"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Report Configuration">
                            <field name="year" required="1" options="{'enable_formatting': False, 'format': False}"/>
                            <field name="month" required="1"/>
                            <field name="report_type" required="1" widget="radio"/>
                            <field name="company_id" groups="base.group_multi_company" required="1" readonly="state != 'draft'"/>
                        </group>
                        <group string="Summary Statistics" invisible="state == 'draft'">
                            <field name="record_count" readonly="1"/>
                            <field name="total_esi_wages" readonly="1"/>
                            <field name="total_ee_esic" readonly="1"/>
                            <field name="total_er_esic" readonly="1"/>
                        </group>
                    </group>
                    <field name="xlsx_filename" invisible="1"/>
                    <field name="xlsx_file" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hds_esic_report_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.esic.report.wizard.view.list</field>
        <field name="model">hds.esic.report.wizard</field>
        <field name="arch" type="xml">
            <list string="ESI Report">
                <field name="month"/>
                <field name="year" options="{'enable_formatting': False, 'format': False}"/>
                <field name="report_type"/>
            </list>
        </field>
    </record>

    <record id="action_hds_esic_report_wizard" model="ir.actions.act_window">
        <field name="name">ESI Report</field>
        <field name="res_model">hds.esic.report.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
