<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_lwf_report_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.lwf.report.wizard.view.form</field>
        <field name="model">hds.lwf.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Labour Welfare Fund Report">
                <header>
                    <button name="action_export_xlsx"
                            string="Generate / Export XLSX"
                            type="object"
                            class="btn-primary"
                            icon="download"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Reporting Period &amp; Criteria">
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                            <field name="payslip_state"/>
                            <field name="department_id" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" required="1"/>
                        </group>
                        <group string="Summary Statistics">
                            <field name="record_count" readonly="1"/>
                            <field name="total_ee_contrib" readonly="1"/>
                            <field name="total_er_contrib" readonly="1"/>
                            <field name="total_contrib" readonly="1"/>
                        </group>
                    </group>
                    <field name="xlsx_filename" invisible="1"/>
                    <field name="xlsx_file" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hds_lwf_report_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.lwf.report.wizard.view.list</field>
        <field name="model">hds.lwf.report.wizard</field>
        <field name="arch" type="xml">
            <list string="Labour Welfare Fund (LWF) Report">
                <field name="date_from" width="220px"/>
                <field name="date_to" width="220px"/>
                <field name="name" string="Report Name"/>
            </list>
        </field>
    </record>

    <record id="action_hds_lwf_report_wizard" model="ir.actions.act_window">
        <field name="name">Labour Welfare Fund (LWF) Report</field>
        <field name="res_model">hds.lwf.report.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
